    sdi_states = get_qr_sdi_states()  # manual-entry flag from QR_codes.sdi
    ai_status_map = get_qr_ai_status_map()
    captured_by_map = get_qr_captured_by()
    if process_map is None:
        process_map = {}

    for filename in os.listdir(JSON_DIR):
        if not filename.endswith(".json") or filename.endswith("_raw_ocr.json"):
            continue

        if not _is_bf_filename(filename):
            continue
        
        m = JSON_NAME_RE.match(filename)
        if not m:
            continue

        qr, asset_type_mid, building = m.groups()
        doc_id = filename[:-5]

        try:
            # Load JSON first so we can honor per-file manual flags
            with open(os.path.join(JSON_DIR, filename), 'r', encoding='utf-8') as f:
                raw = json.load(f)

            data = raw.get("structured_data") or {}

            # Extract and format Capture Date
            capture_timestamp = qr_dates.get(str(raw.get("qr_code") or data.get("qr_code")).strip(), '')
            if capture_timestamp:
                # Format to YYYY-MM-DD HH:MM
                data["Capture Date"] = capture_timestamp[:16]
            else:
                data["Capture Date"] = ""

            if not isinstance(data, dict):
                print(f"⚠️ Skipped {filename}: 'structured_data' is not a dict")
                continue

            exclude_sdi_flag = 1 if str(data.get("ExcludeSDI") or "0") in ("1", "True", "true") else 0

            current_status = process_map.get(qr)

            # MODIFICATION: Force Manual Entry tab (Process 2) if SDI is enabled.
            # This ensures items set to 'Manual' appear in the Manual Entry tab.
            sdi_state_val = sdi_states.get(qr)
            if sdi_state_val == 1:
                current_status = "2"
            elif exclude_sdi_flag == 1:
                current_status = "2"

            if current_status in (None, ''):
                _auto_register_qr_code(qr, "0")
                current_status = "0"
                process_map[qr] = current_status

            if str(current_status) != str(process_target):
                continue

            data.setdefault("Manufacturer", '')
            data.setdefault("Model", '')
            data.setdefault("Serial Number", '')
            data.setdefault("UBC Tag", '')
            if not data.get("UBC Tag"):
                data["UBC Tag"] = _compute_ubc_tag(building)
            data.setdefault("Asset Group", '')
            data.setdefault("Attribute", "BackflowDevice")
            data.setdefault("Application", '')
            data.setdefault("Flagged", "false")
            data.setdefault("Approved", '')
            data.setdefault("Diameter", '')
            data.setdefault("Year", '')
            data.setdefault("Technical Safety BC", '')

            data = apply_dictionary_rules(data, asset_type="BF")

            data["Description"] = _resolve_description(
                data.get("Asset Group"),
                data.get("UBC Tag"),
                data.get("Application", ''),
                data.get("Description")
            )

            present = 0
            exists_map = {}
            for tag in SEQ_CHECK:
                exists_map[tag] = bool(find_image(qr, building, "BF", tag))
                if exists_map[tag]:
                    present += 1
            missing_tags = [tag for tag in SEQ_CHECK if not exists_map[tag]]
            friendly_map = {'-0': 'Asset Plate/Label', '-1': 'Asset Plate/Label (Optional)', '-2': 'Main Asset'}
            missing_friendly = ", ".join(friendly_map.get(tag, tag) for tag in missing_tags)

            missed_photo = present < 2
            photos_summary = f"{present}/3"
            has_extra_photo = bool(find_image(qr, building, "BF", '-3'))

            location = locations_map.get(qr, '')

            # ExcludeSDI reflects Manual Entry status: JSON flag, DB sdi flag, OR Col_process == 2
            # This ensures the icon displays correctly for all items in the Manual Entry tab
            # Must return integer 1 or 0 (not boolean) since template checks == 1
            sdi_val = 1 if (exclude_sdi_flag or sdi_states.get(qr, 0) or str(current_status) == "2") else 0
            avg_ai_conf, avg_ai_conf_display = _normalize_avg_ai_conf(_extract_avg_ai_conf(raw))
            comp_score, comp_score_display = _normalize_avg_ai_conf(raw.get("completeness_score"))

            items.append({
                **data,
                "doc_id": doc_id,
                "qr_code": qr,
                "captured_by": captured_by_map.get(qr, ''),
                "building": building,
                "Location": location,
                "asset_type": "BF",
                "Flagged": data.get("Flagged", "false"),
                "Approved": data.get("Approved", ''),
                "ExcludeSDI": sdi_val,
                "ai_status": ai_status_map.get(qr, "0"),
                "Modified": raw.get("modified", False),
                "Missed Photo": "YES" if missed_photo else "NO",
