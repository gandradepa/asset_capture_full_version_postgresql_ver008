def upsert_approved_in_db(qr_code: str, is_approved: bool):
    if not _connectable():
        return
    try:
        with qrdb.get_connection(sqlite_path=DB_PATH) as conn:
            cur = conn.cursor()
            cur.execute('CREATE TABLE IF NOT EXISTS "QR_codes" ("QR_code_ID" TEXT PRIMARY KEY, "Approved" TEXT)')
            new_val = '1' if is_approved else '0'   # PG CHECK requires Approved IN ('0','1')
            old_row = cur.execute(
                'SELECT "Approved" FROM "QR_codes" WHERE "QR_code_ID" = ?',
                (qr_code,),
            ).fetchone()
            old_val = old_row[0] if old_row else None
            cur.execute(
                'INSERT INTO "QR_codes" ("QR_code_ID","Approved") VALUES (?,?) '
                'ON CONFLICT("QR_code_ID") DO UPDATE SET "Approved"=excluded."Approved"',
                (qr_code, new_val)
            )
            if _audit_log_change and str(old_val or "") != new_val:
                try:
                    _audit_log_change(
                        conn,
                        qr_code=qr_code,
                        app_name="reviewer_bf",
                        table_name="QR_codes",
                        record_pk=qr_code,
                        op_type="UPDATE",
                        field_changes={"Approved": (old_val, new_val)},
                        source="human",
                        description="POST /toggle_approved (BF)",
                    )
                except Exception as audit_exc:
                    print(f"[audit] BF toggle_approved audit failed: {audit_exc}")
            conn.commit()
    except Exception as e:
        print(f"⚠️ Failed to update QR_codes.Approved for {qr_code}: {e}")

# --- NEW: DB Toggle SDI (DECOUPLED) ---
def _db_toggle_qr_sdi(qr_code_id: str):
    """
    Toggles the 'sdi' (Manual Entry) flag in QR_codes AND aligns
    QR_code_assets.Col_process (2 = Manual Entry, 0 = not) so the three
    Manual-Entry flags stay consistent (Col_process / sdi / JSON ExcludeSDI) and
    the asset actually moves in/out of the Manual Entry tab. Matches the EL
    reviewer. (Previously BF left Col_process untouched, so un-marking Manual on
    a Col_process==2 asset had no visible effect — the display is governed by
    Col_process==2.)
    """
    if not _connectable():
        raise Exception("Database not accessible")

    with qrdb.get_connection(sqlite_path=DB_PATH) as conn:
        cur = conn.cursor()

        # 1. Check current value
        cur.execute(f'SELECT "sdi" FROM "{QR_CODES_TABLE}" WHERE "{QR_CODE_ID_COL}" = ?', (qr_code_id,))
        row = cur.fetchone()

        current_val = 0
        if row:
            current_val = 1 if (row[0] == 1 or row[0] == "1") else 0

        # 2. Toggle
        new_val = 0 if current_val == 1 else 1

        # 3. Upsert the sdi flag
        cur.execute(f"""
            INSERT INTO "{QR_CODES_TABLE}" ("{QR_CODE_ID_COL}", "sdi")
            VALUES (?, ?)
            ON CONFLICT("{QR_CODE_ID_COL}") DO UPDATE SET
                "sdi" = excluded."sdi";
        """, (qr_code_id, new_val))

        # 3b. Align Col_process so the asset actually moves in/out of the Manual
        #     Entry tab (matches the EL reviewer; keeps the Manual-Entry invariant).
        new_process = "2" if new_val == 1 else "0"
        cur.execute(
            f'UPDATE "{QR_CODE_ASSETS_TABLE}" SET "{QR_CODE_ASSETS_PROCESS_COL}" = ? WHERE "code_assets" LIKE ?',
            (new_process, qr_code_id + "%"),
        )
        if cur.rowcount == 0:
            cur.execute(
                f'INSERT INTO "{QR_CODE_ASSETS_TABLE}" ("code_assets", "{QR_CODE_ASSETS_PROCESS_COL}") VALUES (?, ?) '
                f'ON CONFLICT("code_assets") DO UPDATE SET "{QR_CODE_ASSETS_PROCESS_COL}"=excluded."{QR_CODE_ASSETS_PROCESS_COL}"',
                (qr_code_id, new_process),
            )

        if _audit_log_change:
            try:
                _audit_log_change(
                    conn,
                    qr_code=qr_code_id,
                    app_name="reviewer_bf",
                    table_name=QR_CODES_TABLE,
                    record_pk=qr_code_id,
                    op_type="UPDATE",
                    field_changes={"sdi": (current_val, new_val)},
                    source="human",
                    description="POST /toggle_sdi (BF)",
                )
            except Exception as audit_exc:
                print(f"[audit] BF toggle_sdi audit failed: {audit_exc}")

        conn.commit()

    return new_val


def _table_columns(conn, table_name: str):
    cur = conn.cursor()
    return set(qrdb.table_columns(conn, table_name))

def _ensure_table_columns(conn, table_name: str, column_defs: dict[str, str]):
    existing_cols = _table_columns(conn, table_name)
    if not existing_cols:
        return

    cur = conn.cursor()
    for col_name, col_type in column_defs.items():
        if col_name not in existing_cols:
            cur.execute(f'ALTER TABLE "{table_name}" ADD COLUMN "{col_name}" {col_type}')

def _table_has_column(table_name: str, column_name: str) -> bool:
    if not _connectable():
        return False
    try:
        with qrdb.get_connection(sqlite_path=DB_PATH) as conn:
            return column_name in _table_columns(conn, table_name)
    except Exception:
        return False


def _safe_str(v):
    return "" if v is None else str(v)


def _build_sdi_row(doc_id: str, structured: dict, avg_ai_conf=None) -> dict:
    parsed = parse_doc_id(doc_id)
    if not parsed:
        return {}
    qr, _asset_type_mid, building = parsed

    manuf = _safe_str(structured.get("Manufacturer", ''))
    model = _safe_str(structured.get("Model", ''))
    serial = _safe_str(structured.get("Serial Number", ''))
    ubc = _safe_str(structured.get("UBC Tag", ''))
    ag = _safe_str(structured.get("Asset Group", ''))
    attr = _safe_str(structured.get("Attribute", ''))
    diam = _safe_str(structured.get("Diameter", ''))
    year = _safe_str(structured.get("Year", ''))
    tsbc = _safe_str(structured.get("Technical Safety BC", ''))
    desc = _resolve_description(
        ag,
        ubc,
        _safe_str(structured.get("Application", '')),
        structured.get("Description", '')
    )
    approved_flag = '1' if _safe_str(structured.get("Approved", '')) == "True" else '0'
    flagged_val = '1' if _safe_str(structured.get("Flagged", '')) == "true" else '0'
    avg_ai_conf_val, _ = _normalize_avg_ai_conf(avg_ai_conf)

    return {
