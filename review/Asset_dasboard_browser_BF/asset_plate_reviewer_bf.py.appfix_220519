def get_asset_dictionary():
    """Load mechanical dictionary once; used for BF lookups gated by asset_type."""
    global _CACHED_DICTIONARY
    if _CACHED_DICTIONARY:
        return _CACHED_DICTIONARY
    for path in DICTIONARY_CANDIDATES:
        try:
            if not path or not os.path.exists(path):
                continue
            spec = importlib.util.spec_from_file_location("mechanical_dictionary", path)
            module = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(module)
            _CACHED_DICTIONARY = getattr(module, "ASSET_DICTIONARY", {}) or {}
            if _CACHED_DICTIONARY:
                break
        except Exception as e:
            print(f"[WARN] BF dictionary load failed from {path}: {e}")
    return _CACHED_DICTIONARY

def _normalize_asset_type_values(value):
    """Normalize '- BF' to 'BF' etc."""
    if value is None:
        return set()
    values = value if isinstance(value, (list, tuple, set)) else [value]
    out = set()
    for v in values:
        cleaned = re.sub(r'[^A-Za-z0-9]+', '', str(v or "")).upper()
        if cleaned:
            out.add(cleaned)
    return out

def _get_entry_asset_types(entry: dict):
    if not isinstance(entry, dict):
        return set()
    normalized = set()
    for key, val in entry.items():
        key_clean = re.sub(r'[^a-z0-9]+', '', str(key).lower())
        if key_clean in ("assettype", "assettypes", "type"):
            normalized |= _normalize_asset_type_values(val)
    return normalized

def apply_dictionary_rules(data: dict, asset_type: str = "BF"):
    """Apply dictionary lookup with composite key support (Tag|Type) for BF assets."""
    ubc = str(data.get("UBC Tag") or "").strip().upper()
    if not ubc:
        return data
    
    cd = get_asset_dictionary()
    if not cd:
        print(f"[BF-DICT-WARN] Dictionary is empty or not loaded")
        return data
    
    # Normalize discipline from JSON or context (default to BF)
    json_types = _normalize_asset_type_values(asset_type or data.get("asset_type"))
    current_type = next(iter(json_types)) if json_types else "BF"
    
    # STEP 1: Try exact composite key match (highest priority)
    composite_key = f"{ubc}|{current_type}"
    if composite_key in cd:
        entry = cd[composite_key]
        if entry.get("asset_group"):
            data["Asset Group"] = entry.get("asset_group")
        if entry.get("attribute_set"):
            data["Attribute"] = entry.get("attribute_set")
        if not data.get("asset_type"):
            data["asset_type"] = current_type
        if entry.get("description") and not str(data.get("Description", '')).strip():
            data["Description"] = entry.get("description")
        return data
    
    # STEP 2: Try composite prefix matching (e.g., "PRV-001" matches "PRV|BF")
    for key in sorted(cd.keys(), key=len, reverse=True):
        if '|' not in key:
            continue  # Skip simple keys in this pass
        
        try:
            tag_prefix, key_type = key.split('|', 1)
            # Check if UBC tag starts with prefix AND types match
            if ubc.startswith(tag_prefix.upper()) and key_type.upper() == current_type:
                entry = cd[key]
                if entry.get("asset_group"):
                    data["Asset Group"] = entry.get("asset_group")
                if entry.get("attribute_set"):
                    data["Attribute"] = entry.get("attribute_set")
                if not data.get("asset_type"):
                    data["asset_type"] = current_type
                if entry.get("description") and not str(data.get("Description", '')).strip():
                    data["Description"] = entry.get("description")
                return data
        except ValueError:
            continue  # Skip malformed keys
    
    # STEP 3: Fall back to simple key matching (legacy support)
    for prefix in sorted(cd.keys(), key=len, reverse=True):
        if '|' in prefix:
            continue  # Skip composite keys in legacy matching
        
        if not ubc.startswith(prefix.upper()):
            continue
        
        entry = cd[prefix]
        dict_types = _get_entry_asset_types(entry)
        
        # Type compatibility check (for simple keys with asset_type field)
        if json_types and dict_types and dict_types.isdisjoint(json_types):
            continue
        
        if entry.get("asset_group"):
            data["Asset Group"] = entry.get("asset_group")
        if entry.get("attribute_set"):
            data["Attribute"] = entry.get("attribute_set")
        if not data.get("asset_type") and dict_types:
            data["asset_type"] = next(iter(dict_types))
        if entry.get("description") and not str(data.get("Description", '')).strip():
            data["Description"] = entry.get("description")
        return data
    
    return data


