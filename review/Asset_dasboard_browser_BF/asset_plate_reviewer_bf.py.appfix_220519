def _compute_ubc_tag(building: str) -> str:
    """
    Generate UBC Tag from building code.
    """
    if not building:
        return ""
    # Replace dashes with zeros
    formatted = building.replace("-", "0")
    # Pad with trailing zeros to reach 5 characters
    while len(formatted) < 5:
        formatted += "0"
    # Append BFP suffix
    return formatted + "BFP"


def _compute_description(asset_group: str, ubc_tag: str, application: str = "") -> str:
    prefix = "BFP-"
    suffix = "BFP"
    app_part = (application or "").strip()
    if app_part:
        app_part += " "
    first_word_group = ""
    if asset_group:
        first_word_group = asset_group.strip().split()[0] + " "
    # REMOVED: tag_part = f" {ubc_tag.strip()}" if ubc_tag and str(ubc_tag).strip() else ""
    return f"{prefix}{app_part}{first_word_group}{suffix}".strip()


def _resolve_description(asset_group: str, ubc_tag: str, application: str, existing_desc) -> str:
    existing_text = str(existing_desc or "")
    if existing_text.strip():
        return existing_text
    cd = get_asset_dictionary()
    tag = (ubc_tag or "").strip().upper()
    if tag:
        for k in sorted(cd.keys(), key=len, reverse=True):
            if tag.startswith(k.upper()) and cd[k].get("description"):
                base = cd[k].get("description")
                return f"{base} - {ubc_tag}" if ubc_tag else base
    return _compute_description(asset_group, ubc_tag, application)


def parse_doc_id(doc_id: str):
