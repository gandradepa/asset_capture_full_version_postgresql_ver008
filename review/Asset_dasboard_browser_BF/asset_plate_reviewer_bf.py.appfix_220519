@admin_bp.route("/api/admin/users/<username>/permissions", methods=["PUT"])
@login_required
@admin_required
def api_set_user_permissions(username):
    user = User.query.filter(
        db.func.lower(User.username) == username.strip().lower()
    ).first_or_404()

    payload = request.get_json(silent=True) or {}
    grants_input = payload.get("grants", [])

    VALID_LEVELS = {"admin", "editor", "viewer"}
    cleaned = []
    for g in grants_input:
        sk  = str(g.get("section_key") or "").strip()
        ik  = str(g.get("item_key")    or "").strip()
        lvl = str(g.get("access_level") or "").strip().lower()
        if not sk or lvl not in VALID_LEVELS:
            return jsonify({"success": False, "message": f"Invalid grant: {g}"}), 400
        if not is_valid_item(sk, ik):
            return jsonify({"success": False,
                            "message": f"Unknown section/item: {sk}/{ik}"}), 400
        cleaned.append({"section_key": sk, "item_key": ik, "access_level": lvl})

    UserAccess.query.filter_by(user_id=user.id).delete()
    for g in cleaned:
        db.session.add(UserAccess(
            user_id=user.id,
            section_key=g["section_key"],
            item_key=g["item_key"],
            access_level=g["access_level"],
        ))
    db.session.commit()
    return jsonify({"success": True,
                    "message": f"Permissions saved for {user.username}.",
                    "grants": cleaned})


