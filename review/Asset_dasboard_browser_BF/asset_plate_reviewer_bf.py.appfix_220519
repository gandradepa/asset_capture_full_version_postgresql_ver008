def _auto_register_qr_code(qr: str, process_value: str = "0"):
    """
    Automatically register QR code in QR_code_assets filter table if not present.
    """
    if not _connectable():
        return
    
    try:
        with qrdb.get_connection(sqlite_path=DB_PATH) as conn:
            cur = conn.cursor()
            
            # Check for BOTH exact match AND prefix match (full format entries)
            cur.execute(
                'SELECT code_assets FROM "QR_code_assets" WHERE code_assets = ? OR code_assets LIKE ?',
                (qr, qr + " %")
            )
            exists = cur.fetchone()

            if not exists:
                # Insert new record
                cur.execute(
                    'INSERT INTO "QR_code_assets" (code_assets, "Col_process") VALUES (?, ?)',
                    (qr, process_value)
                )
                conn.commit()
                print(f"   ✓ Auto-registered QR code '{qr}' in filter table (Col_process={process_value})")
    except Exception as e:
        print(f"   ⚠️ Failed to auto-register QR code '{qr}': {e}")


