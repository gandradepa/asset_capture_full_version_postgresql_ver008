"""Single Line Diagram (SLD) blueprint.

Ports the standalone http.server at
dev_capture_process_from_drawn/single_line_diagram/serve.py into a Flask
blueprint that lives inside the production EL dashboard app and shares
QR_codes.db (env var DB_PATH) with the rest of the app.

Routes (all require login):
    GET    /sld/api/buildings
    GET    /sld/api/assets[?building=<code>&history=<bool>]
    POST   /sld/api/assets
    PUT    /sld/api/assets/<row_id>
    DELETE /sld/api/assets/<row_id>
    POST   /sld/api/upload           multipart PDF upload
    POST   /sld/api/process          runs extract_electrical_schema.py

Config (read from current_app.config):
    DB_PATH              path to QR_codes.db (shared with main app)
    SLD_PDF_STORAGE      directory for uploaded PDFs
    SLD_EXTRACT_SCRIPT   path to extract_electrical_schema.py
    SLD_EXTRACT_TIMEOUT  seconds (default 600)
"""

import json
import os
import re
import sqlite3
import subprocess
import sys
from datetime import datetime

from flask import Blueprint, current_app, jsonify, request
from flask_login import login_required
from werkzeug.utils import secure_filename


TABLE = "electrical_building_schema"
FILENAME_PATTERN = re.compile(r"^\d{3}")
ACTIVE_DRAW_CONDITION = 'new_draw = "TRUE"'

# Mirror of DISTRIBUTION_ASSET_GROUPS in Asset_dashboard_EL.py. Kept as a
# tuple here to avoid a cross-module import (the dashboards are independent
# blueprints). Keep this in sync if the canonical set changes.
DISTRIBUTION_ASSET_GROUPS = (
    "Panels",
    "Other Service and Distribution",
    "Interior Distribution Transformers",
    "Motor Control Centers",
    "Enclosed Circuit Breakers",
    "Automatic Transfer Switches",
)


try:
    from electrical_equipment_rules import derive_electrical_equipment_type
except ModuleNotFoundError:
    _ELECTRICAL_EQUIPMENT_TYPE_MAP = {
        "MDP": "Main Distribution Panel",
        "CDP": "Central Distribution Panel",
        "SPL": "Splitter",
        "MCC": "Motor Control Center",
        "PNL": "Panel",
        "SWBD": "Switchboard",
        "ATS": "Automatic Transfer Switch",
        "TX": "Transformer",
    }

    def derive_electrical_equipment_type(tag_value):
        tag_upper = str(tag_value or "").strip().upper()
        for code, name in sorted(_ELECTRICAL_EQUIPMENT_TYPE_MAP.items(), key=lambda item: len(item[0]), reverse=True):
            if tag_upper.startswith(code):
                return name
        return ""


sld_bp = Blueprint("sld", __name__, url_prefix="/sld")


# ── Helpers ──────────────────────────────────────────────────────────────

def _db_path():
    return current_app.config["DB_PATH"]


def _connect():
    conn = sqlite3.connect(_db_path())
    conn.row_factory = sqlite3.Row
    return conn


def _pdf_storage():
    path = current_app.config["SLD_PDF_STORAGE"]
    os.makedirs(path, exist_ok=True)
    return path


def _active_match_exists_sql(table_alias=TABLE):
    return f'''
        EXISTS (
            SELECT 1
            FROM sdi_dataset_EL s
            WHERE TRIM(COALESCE(s."UBC Asset Tag", '')) <> ''
              AND UPPER(TRIM(COALESCE(s.Building, ''))) = UPPER(TRIM(COALESCE("{table_alias}".Building, '')))
              AND UPPER(TRIM(COALESCE(s."UBC Asset Tag", ''))) = UPPER(TRIM(COALESCE("{table_alias}"."Equipment ID", '')))
        )
    '''


def _table_columns(conn, table_name):
    try:
        rows = conn.execute(f'PRAGMA table_xinfo("{table_name}")').fetchall()
    except sqlite3.Error:
        rows = conn.execute(f'PRAGMA table_info("{table_name}")').fetchall()
    return {row[1] for row in rows}


def _id_check_value(building, asset_tag, supply_from):
    return " | ".join([
        str(building or "").strip(),
        str(asset_tag or "").strip(),
        str(supply_from or "").strip(),
    ])


def _sdi_id_check_expression(sdi_columns):
    if "ID_check" in sdi_columns:
        return "TRIM(COALESCE(s.ID_check, ''))"
    return '''
        TRIM(COALESCE(s.Building, '')) || ' | ' ||
        TRIM(COALESCE(s."UBC Asset Tag", '')) || ' | ' ||
        TRIM(COALESCE(s."Supply From", ''))
    '''


def _enrich_asset_display_fields(conn, assets):
    """Attach display-only SDI fields without changing SLD eligibility."""
    if not assets:
        return assets

    sdi_columns = _table_columns(conn, "sdi_dataset_EL")
    if not sdi_columns:
        for asset in assets:
            asset["id_check_match"] = 0
            asset["QR Code"] = ""
        return assets

    sdi_id_check_expr = _sdi_id_check_expression(sdi_columns)
    qr_select = 's."QR Code"' if "QR Code" in sdi_columns else "''"
    qr_order = 's."QR Code"' if "QR Code" in sdi_columns else "s.rowid"

    # Room is sourced from QR_codes.Location (master location on the QR record),
    # joined via the QR Code discovered through the sdi_dataset_EL match. The
    # QR_codes row is the authoritative location store — triggers on QR_codes
    # propagate Location changes to Space / Floor / Space Details / Floor Code.
    qr_codes_exists = bool(conn.execute(
        "SELECT 1 FROM sqlite_master WHERE type='table' AND name='QR_codes'"
    ).fetchone())
    sdi_room_expr = 's."Location"' if "Location" in sdi_columns else "''"
    if qr_codes_exists and "QR Code" in sdi_columns:
        room_join = (
            'LEFT JOIN QR_codes qc '
            'ON TRIM(COALESCE(qc."QR_code_ID", \'\')) = TRIM(COALESCE(s."QR Code", \'\'))'
        )
        room_select = f'COALESCE(NULLIF(TRIM(qc."Location"), \'\'), NULLIF(TRIM({sdi_room_expr}), \'\'), \'\')'
    else:
        room_join = ''
        room_select = f'COALESCE(NULLIF(TRIM({sdi_room_expr}), \'\'), \'\')'

    id_check_query = f'''
        SELECT 1
        FROM sdi_dataset_EL s
        WHERE {sdi_id_check_expr} = ?
        LIMIT 1
    '''
    match_query = f'''
        SELECT {qr_select} AS qr_code, {room_select} AS room
        FROM sdi_dataset_EL s
        {room_join}
        WHERE TRIM(COALESCE(s."UBC Asset Tag", '')) <> ''
          AND UPPER(TRIM(COALESCE(s.Building, ''))) = UPPER(TRIM(COALESCE(?, '')))
          AND UPPER(TRIM(COALESCE(s."UBC Asset Tag", ''))) = UPPER(TRIM(COALESCE(?, '')))
        ORDER BY CASE WHEN {sdi_id_check_expr} = ? THEN 0 ELSE 1 END, {qr_order}
        LIMIT 1
    '''

    for asset in assets:
        id_check = str(asset.get("ID_check") or "").strip()
        if not id_check:
            id_check = _id_check_value(asset.get("Building"), asset.get("Equipment ID"), asset.get("Supply From"))
            asset["ID_check"] = id_check

        asset["id_check_match"] = 1 if conn.execute(id_check_query, (id_check,)).fetchone() else 0
        match = conn.execute(
            match_query,
            (asset.get("Building"), asset.get("Equipment ID"), id_check),
        ).fetchone()
        asset["QR Code"] = (match["qr_code"] if match else "") or ""
        asset["Room"] = (match["room"] if match else "") or ""

    return assets


def _derive_group_of_asset(equipment_id):
    group = (derive_electrical_equipment_type(equipment_id) or "").strip()
    if not group:
        return "Unknown"
    if group.lower() in {"switchboard", "distribuition", "distribution"}:
        return "Distribution"
    return group


def ensure_sld_schema():
    """Idempotent safety net — the migration runner creates the table, but
    older databases that pre-date migrations may still be missing the
    version-tracking columns."""
    conn = _connect()
    try:
        cols = [r[1] for r in conn.execute(f'PRAGMA table_info("{TABLE}")').fetchall()]
        if not cols:
            # Table missing entirely. Migration runner should have handled this;
            # bail so the error is visible rather than silently creating
            # something mis-shaped.
            return
        if "new_draw" not in cols:
            conn.execute(f'ALTER TABLE "{TABLE}" ADD COLUMN new_draw TEXT DEFAULT "TRUE"')
        if "ID_check" not in cols:
            conn.execute(f'ALTER TABLE "{TABLE}" ADD COLUMN ID_check TEXT DEFAULT ""')
            conn.execute(f'''
                UPDATE "{TABLE}"
                SET ID_check = "Building" || ' | ' || "Equipment ID" || ' | ' || coalesce("Supply From", '')
            ''')
        if "matching_check" not in cols:
            conn.execute(f'ALTER TABLE "{TABLE}" ADD COLUMN matching_check INTEGER DEFAULT 0')
        if "source_pdf" not in cols:
            conn.execute(f'ALTER TABLE "{TABLE}" ADD COLUMN source_pdf TEXT DEFAULT ""')
        if "created_at" not in cols:
            conn.execute(f'ALTER TABLE "{TABLE}" ADD COLUMN created_at TEXT DEFAULT ""')
        conn.commit()
    finally:
        conn.close()


# ── Data-access functions (direct ports from dev serve.py) ───────────────

def get_all_assets(building=None, include_history=False):
    conn = _connect()
    try:
        query = f'SELECT * FROM "{TABLE}"'
        conditions = []
        params = []
        if not include_history:
            conditions.append(ACTIVE_DRAW_CONDITION)
            conditions.append(_active_match_exists_sql())
        if building:
            conditions.append("Building = ?")
            params.append(building)
        if conditions:
            query += " WHERE " + " AND ".join(conditions)
        query += ' ORDER BY CAST(Hierarchy AS INTEGER), "Equipment ID"'
        rows = conn.execute(query, params).fetchall()
        assets = [dict(r) for r in rows]
        return _enrich_asset_display_fields(conn, assets)
    finally:
        conn.close()


def get_buildings():
    conn = _connect()
    try:
        rows = conn.execute(
            f'SELECT Building, new_draw, COUNT(*) as asset_count, source_pdf '
            f'FROM "{TABLE}" GROUP BY Building, new_draw ORDER BY Building, new_draw DESC'
        ).fetchall()
    finally:
        conn.close()
    buildings = {}
    for r in rows:
        b = r["Building"]
        if b not in buildings:
            buildings[b] = {"building": b, "current_count": 0, "history_count": 0, "source_pdf": ""}
        if r["new_draw"] == "TRUE":
            buildings[b]["current_count"] = r["asset_count"]
            buildings[b]["source_pdf"] = r["source_pdf"] or ""
        else:
            buildings[b]["history_count"] += r["asset_count"]
    for entry in buildings.values():
        entry["display"] = get_building_display(entry["building"])
    return list(buildings.values())


def get_building_locations(building_code):
    """Distinct Location values from Buildings_with_SpaceUID for a building Code.

    Returns [] when building_code is falsy, the view is missing, or the lookup
    fails. The Swift Over Room dropdown feeds off this list.
    """
    if not building_code:
        return []
    conn = _connect()
    try:
        rows = conn.execute(
            'SELECT DISTINCT Location FROM "Buildings_with_SpaceUID" '
            'WHERE "Code" = ? AND Location IS NOT NULL AND TRIM(Location) != "" '
            'ORDER BY Location COLLATE NOCASE',
            (building_code,),
        ).fetchall()
    except sqlite3.Error:
        return []
    finally:
        conn.close()
    return [r[0] for r in rows if r[0]]


def check_building_exists(building_code):
    conn = _connect()
    try:
        count = conn.execute(
            f'SELECT COUNT(*) FROM "{TABLE}" WHERE Building = ? AND {ACTIVE_DRAW_CONDITION}',
            (building_code,),
        ).fetchone()[0]
        return count > 0
    finally:
        conn.close()


def get_building_display(code):
    if not code:
        return ""
    code_str = str(code)
    conn = _connect()
    try:
        row = conn.execute(
            'SELECT Name, "Owner Rep" FROM Buildings WHERE Code = ? LIMIT 1',
            (code_str,),
        ).fetchone()
    finally:
        conn.close()
    if not row:
        return code_str
    name = (row[0] or "").strip()
    rep = (row[1] or "").strip()
    if name and rep:
        return f"{name} | {rep}"
    return name or code_str


def recompute_matching_check(row_id=None, building=None):
    """Refresh matching_check from same-building UBC Asset Tag matches.

    Scope: a single row, all rows for one Building, or the entire table.
    """
    conn = _connect()
    try:
        if row_id is not None:
            where, params = "WHERE row_id = ?", (row_id,)
        elif building is not None:
            where, params = "WHERE Building = ?", (building,)
        else:
            where, params = "", ()
        conn.execute(f"""
            UPDATE "{TABLE}"
            SET matching_check = CASE WHEN EXISTS (
                SELECT 1 FROM sdi_dataset_EL s
                WHERE TRIM(COALESCE(s."UBC Asset Tag", '')) <> ''
                  AND UPPER(TRIM(COALESCE(s.Building, ''))) = UPPER(TRIM(COALESCE("{TABLE}".Building, '')))
                  AND UPPER(TRIM(COALESCE(s."UBC Asset Tag", ''))) = UPPER(TRIM(COALESCE("{TABLE}"."Equipment ID", '')))
            ) THEN 1 ELSE 0 END
            {where}
        """, params)
        conn.commit()
    finally:
        conn.close()


def get_missed_assets(building=None):
    conn = _connect()
    try:
        query = f'''
            SELECT row_id, Building, "Equipment ID", "Supply From"
            FROM "{TABLE}"
            WHERE {ACTIVE_DRAW_CONDITION}
              AND NOT {_active_match_exists_sql()}
        '''
        params = []
        if building:
            query += " AND Building = ?"
            params.append(building)
        query += ' ORDER BY CAST(Hierarchy AS INTEGER), "Equipment ID"'
        rows = conn.execute(query, params).fetchall()
        missed = []
        for row in rows:
            item = dict(row)
            item["Group of Asset"] = _derive_group_of_asset(item.get("Equipment ID"))
            missed.append(item)
        return missed
    finally:
        conn.close()


def get_sdi_not_in_sld_assets(building=None):
    """SDI rows (distribution category) for this building with no active SLD match.

    Inverse of get_missed_assets: reads sdi_dataset_EL as the base table and
    excludes rows whose UBC Asset Tag appears as an active Equipment ID in the
    SLD for the same building.
    """
    if not building:
        return []
    conn = _connect()
    try:
        sdi_columns = _table_columns(conn, "sdi_dataset_EL")
        if not sdi_columns:
            return []

        select_parts = [
            's."UBC Asset Tag" AS "UBC Asset Tag"',
            's.Building AS Building',
            's."Supply From" AS "Supply From"',
            's."Asset Group" AS "Asset Group"',
        ]
        optional = [
            "QR Code", "Description",
            "Voltage Rating", "Voltage Rating (UoM)",
            "Amperage Rating", "Amperage Rating (UoM)",
            "Power Rating", "Power Rating (UoM)",
            "Approved",
        ]
        for col in optional:
            if col in sdi_columns:
                select_parts.append(f's."{col}" AS "{col}"')

        placeholders = ",".join("?" for _ in DISTRIBUTION_ASSET_GROUPS)
        approved_filter = ""
        if "Approved" in sdi_columns:
            approved_filter = 'AND TRIM(COALESCE(s."Approved", \'\')) <> \'1\''
        query = f'''
            SELECT {", ".join(select_parts)}
            FROM sdi_dataset_EL s
            WHERE TRIM(COALESCE(s."UBC Asset Tag", '')) <> ''
              AND UPPER(TRIM(COALESCE(s.Building, ''))) = UPPER(TRIM(COALESCE(?, '')))
              AND s."Asset Group" IN ({placeholders})
              {approved_filter}
              AND NOT EXISTS (
                  SELECT 1 FROM "{TABLE}" e
                  WHERE e.new_draw = "TRUE"
                    AND UPPER(TRIM(COALESCE(e.Building, ''))) = UPPER(TRIM(COALESCE(s.Building, '')))
                    AND UPPER(TRIM(COALESCE(e."Equipment ID", ''))) = UPPER(TRIM(COALESCE(s."UBC Asset Tag", '')))
              )
            ORDER BY s."Asset Group", s."UBC Asset Tag"
        '''
        params = [building, *DISTRIBUTION_ASSET_GROUPS]
        rows = conn.execute(query, params).fetchall()
        return [dict(r) for r in rows]
    finally:
        conn.close()


def archive_missed_assets(row_ids, building=None):
    clean_ids = []
    seen = set()
    for row_id in row_ids or []:
        try:
            value = int(row_id)
        except (TypeError, ValueError):
            continue
        if value not in seen:
            clean_ids.append(value)
            seen.add(value)

    if not clean_ids:
        return False, "No valid row IDs supplied", []

    placeholders = ",".join("?" for _ in clean_ids)
    params = list(clean_ids)
    query = f'''
        SELECT row_id, Building, "Equipment ID", "Supply From"
        FROM "{TABLE}"
        WHERE row_id IN ({placeholders})
          AND {ACTIVE_DRAW_CONDITION}
          AND NOT {_active_match_exists_sql()}
    '''
    if building:
        query += " AND Building = ?"
        params.append(building)

    conn = _connect()
    archived_ids = []
    try:
        rows = conn.execute(query, params).fetchall()
        if not rows:
            return False, "No missed active assets found for exclusion", []

        for row in rows:
            tag = row["Equipment ID"] or ""
            parent = row["Supply From"] or ""
            row_building = row["Building"] or ""
            conn.execute(
                f'''
                UPDATE "{TABLE}"
                SET "Supply From" = ?
                WHERE Building = ?
                  AND {ACTIVE_DRAW_CONDITION}
                  AND "Supply From" = ?
                ''',
                (parent, row_building, tag),
            )
            conn.execute(
                f'UPDATE "{TABLE}" SET new_draw = "FALSE" WHERE row_id = ?',
                (row["row_id"],),
            )
            archived_ids.append(row["row_id"])
        conn.commit()
        return True, "OK", archived_ids
    finally:
        conn.close()


def active_asset_exists(equipment_id, building=None):
    tag = str(equipment_id or "").strip()
    if not tag:
        return False
    conn = _connect()
    try:
        query = f'''
            SELECT 1
            FROM "{TABLE}"
            WHERE {ACTIVE_DRAW_CONDITION}
              AND UPPER(TRIM(COALESCE("Equipment ID", ''))) = UPPER(TRIM(COALESCE(?, '')))
        '''
        params = [tag]
        if building:
            query += " AND UPPER(TRIM(COALESCE(Building, ''))) = UPPER(TRIM(COALESCE(?, '')))"
            params.append(str(building or "").strip())
        query += " LIMIT 1"
        return conn.execute(query, params).fetchone() is not None
    finally:
        conn.close()


def _sdi_asset_group_for_equipment(equipment_id):
    group = _derive_group_of_asset(equipment_id)
    if group == "Transformer":
        return "Interior Distribution Transformers"
    if group == "Automatic Transfer Switch":
        return "Automatic Transfer Switches"
    if group == "Motor Control Center":
        return "Motor Control Centers"
    if group in {"Panel", "Main Distribution Panel", "Central Distribution Panel", "Distribution"}:
        return "Panels"
    return "Other Service and Distribution"


def _sanitize_qr_code(raw):
    return re.sub(r"[^A-Za-z0-9]", "", (raw or "").strip()).upper()


def validate_qr_in_sdi(qr, building):
    sanitized = _sanitize_qr_code(qr)
    if not sanitized:
        return False, "QR Code is required"
    clean_building = (building or "").strip()
    if not clean_building:
        return False, "Building is required"

    conn = _connect()
    try:
        row = conn.execute(
            'SELECT 1 FROM sdi_dataset_EL WHERE "QR Code" = ? AND Building = ? LIMIT 1',
            (sanitized, clean_building),
        ).fetchone()
        if row:
            return True, "sdi_dataset_EL"

        row = conn.execute(
            'SELECT 1 FROM sdi_dataset WHERE "QR Code" = ? AND Building = ? LIMIT 1',
            (sanitized, clean_building),
        ).fetchone()
        if row:
            return True, "sdi_dataset"
    finally:
        conn.close()

    return False, "QR Code not found for this building in sdi_dataset or sdi_dataset_EL"


def add_missed_asset_to_sld(row_id, building=None, qr_code=None):
    try:
        clean_row_id = int(row_id)
    except (TypeError, ValueError):
        return False, "No valid row ID supplied"

    ok, detail = validate_qr_in_sdi(qr_code, building)
    if not ok:
        return False, detail
    sanitized_qr = _sanitize_qr_code(qr_code)

    conn = _connect()
    try:
        query = f'''
            SELECT row_id, Building, "Equipment ID", "Supply From",
                   "Amperage Rating", "Amperage Rating (UoM)",
                   "Power Rating", "Power Rating (UoM)",
                   "Voltage Rating", "Voltage Rating (UoM)"
            FROM "{TABLE}"
            WHERE row_id = ?
              AND {ACTIVE_DRAW_CONDITION}
              AND NOT {_active_match_exists_sql()}
        '''
        params = [clean_row_id]
        if building:
            query += " AND Building = ?"
            params.append(building)

        row = conn.execute(query, params).fetchone()
        if not row:
            return False, "Missed asset was not found or is already eligible for SLD"

        sdi_columns = _table_columns(conn, "sdi_dataset_EL")
        if not sdi_columns:
            return False, "sdi_dataset_EL table was not found"

        values = {
            "Building": row["Building"] or "",
            "UBC Asset Tag": row["Equipment ID"] or "",
            "QR Code": sanitized_qr,
            "Supply From": row["Supply From"] or "",
            "Asset Group": _sdi_asset_group_for_equipment(row["Equipment ID"]),
            "Approved": "",
            "Description": f'{_derive_group_of_asset(row["Equipment ID"])} - {row["Equipment ID"]}',
            "Equipment ID": row["Equipment ID"] or "",
            "Equipment Type": _derive_group_of_asset(row["Equipment ID"]),
            "Amperage Rating": row["Amperage Rating"] or "",
            "Amperage Rating (UoM)": row["Amperage Rating (UoM)"] or "",
            "Power Rating": row["Power Rating"] or "",
            "Power Rating (UoM)": row["Power Rating (UoM)"] or "",
            "Voltage Rating": row["Voltage Rating"] or "",
            "Voltage Rating (UoM)": row["Voltage Rating (UoM)"] or "",
        }
        insert_columns = [column for column in values if column in sdi_columns]
        if "Building" not in insert_columns or "UBC Asset Tag" not in insert_columns:
            return False, "sdi_dataset_EL is missing required Building or UBC Asset Tag columns"

        placeholders = ", ".join("?" for _ in insert_columns)
        column_sql = ", ".join(f'"{column}"' for column in insert_columns)
        conn.execute(
            f'INSERT INTO sdi_dataset_EL ({column_sql}) VALUES ({placeholders})',
            [values[column] for column in insert_columns],
        )
        conn.commit()
        return True, "OK"
    finally:
        conn.close()


def create_asset(data):
    conn = _connect()
    try:
        now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        conn.execute(
            f'INSERT INTO "{TABLE}" '
            f'("Hierarchy", "Supply From", "Equipment ID", "Building", '
            f'"Amperage Rating", "Amperage Rating (UoM)", '
            f'"Power Rating", "Power Rating (UoM)", '
            f'"Voltage Rating", "Voltage Rating (UoM)", ambigous, new_draw, created_at) '
            f'VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)',
            (
                data.get("Hierarchy", "1"),
                data.get("Supply From", ""),
                data.get("Equipment ID", ""),
                data.get("Building", ""),
                data.get("Amperage Rating", ""),
                data.get("Amperage Rating (UoM)", ""),
                data.get("Power Rating", ""),
                data.get("Power Rating (UoM)", ""),
                data.get("Voltage Rating", ""),
                data.get("Voltage Rating (UoM)", ""),
                data.get("ambigous", ""),
                "TRUE",
                now,
            ),
        )
        conn.commit()
    finally:
        conn.close()


def update_asset(row_id, updates):
    conn = _connect()
    try:
        old = conn.execute(
            f'SELECT "Equipment ID" FROM "{TABLE}" WHERE row_id = ?', (row_id,)
        ).fetchone()
        if not old:
            return False, "Asset not found"

        old_tag = old[0]
        new_tag = updates.get("Equipment ID", old_tag)
        if new_tag != old_tag:
            conn.execute(
                f'UPDATE "{TABLE}" SET "Supply From" = ? WHERE "Supply From" = ?',
                (new_tag, old_tag),
            )

        set_clauses = []
        params = []
        if "Equipment ID" in updates:
            set_clauses.append('"Equipment ID" = ?')
            params.append(updates["Equipment ID"])
        if "Supply From" in updates:
            set_clauses.append('"Supply From" = ?')
            params.append(updates["Supply From"])
        if "ambigous" in updates:
            set_clauses.append("ambigous = ?")
            params.append(updates["ambigous"])
        if set_clauses:
            params.append(row_id)
            conn.execute(
                f'UPDATE "{TABLE}" SET {", ".join(set_clauses)} WHERE row_id = ?',
                params,
            )
        conn.commit()
        return True, "OK"
    finally:
        conn.close()


def get_supply_from_children(conn, building, equipment_id, exclude_row_id=None):
    """Rows whose Supply From == equipment_id (same building, active diagram).

    Returns list of dicts keyed by row_id/Equipment ID plus a qr_code (may be
    empty if the child has no matching sdi_dataset_EL row). Used for rename
    cascade previews.
    """
    tag = str(equipment_id or "").strip()
    if not tag:
        return []
    rows = conn.execute(
        f'''
        SELECT row_id, "Equipment ID", Building
        FROM "{TABLE}"
        WHERE {ACTIVE_DRAW_CONDITION}
          AND UPPER(TRIM(COALESCE(Building, ''))) = UPPER(TRIM(COALESCE(?, '')))
          AND UPPER(TRIM(COALESCE("Supply From", ''))) = UPPER(?)
          {"AND row_id != ?" if exclude_row_id is not None else ""}
        ORDER BY CAST(Hierarchy AS INTEGER), "Equipment ID"
        ''',
        (building, tag, exclude_row_id) if exclude_row_id is not None else (building, tag),
    ).fetchall()
    children = []
    sdi_columns = _table_columns(conn, "sdi_dataset_EL")
    qr_available = "QR Code" in sdi_columns
    for row in rows:
        qr = ""
        if qr_available:
            qr_row = conn.execute(
                '''
                SELECT "QR Code" AS qr
                FROM sdi_dataset_EL
                WHERE TRIM(COALESCE("UBC Asset Tag", '')) <> ''
                  AND UPPER(TRIM(COALESCE(Building, ''))) = UPPER(TRIM(COALESCE(?, '')))
                  AND UPPER(TRIM(COALESCE("UBC Asset Tag", ''))) = UPPER(TRIM(COALESCE(?, '')))
                LIMIT 1
                ''',
                (row["Building"], row["Equipment ID"]),
            ).fetchone()
            qr = (qr_row["qr"] if qr_row else "") or ""
        children.append({
            "row_id": row["row_id"],
            "Equipment ID": row["Equipment ID"],
            "Building": row["Building"],
            "qr_code": qr,
        })
    return children


def _atomic_write_json(path, payload):
    """Write JSON to `path` via a temp file + os.replace so partial writes
    cannot corrupt the file if the process is killed mid-write."""
    tmp_path = f"{path}.tmp"
    with open(tmp_path, "w", encoding="utf-8") as f:
        json.dump(payload, f, ensure_ascii=False, indent=4)
    os.replace(tmp_path, path)


def _qr_codes_available(conn):
    return bool(conn.execute(
        "SELECT 1 FROM sqlite_master WHERE type='table' AND name='QR_codes'"
    ).fetchone())


def _get_qr_codes_location(conn, qr_code_id):
    """Return current QR_codes.Location for a QR, or None if table/row missing."""
    if not qr_code_id or not _qr_codes_available(conn):
        return None
    row = conn.execute(
        'SELECT "Location" FROM QR_codes WHERE "QR_code_ID" = ? LIMIT 1',
        (str(qr_code_id).strip(),),
    ).fetchone()
    if row is None:
        return None
    # sqlite3.Row supports both index and key access
    try:
        return row["Location"]
    except Exception:
        return row[0]


def _set_qr_codes_location(conn, qr_code_id, location):
    """Update QR_codes.Location. Triggers on QR_codes propagate to Space,
    Floor, Space Details, Floor Code. No-op if the QR row doesn't exist."""
    if not qr_code_id or not _qr_codes_available(conn):
        return False
    cur = conn.execute(
        'UPDATE QR_codes SET "Location" = ? WHERE "QR_code_ID" = ?',
        ("" if location is None else str(location).strip(), str(qr_code_id).strip()),
    )
    return cur.rowcount > 0


def _find_sdi_row(conn, building, ubc_tag):
    """Return matching sdi_dataset_EL row (as dict) or None."""
    row = conn.execute(
        '''
        SELECT * FROM sdi_dataset_EL
        WHERE TRIM(COALESCE("UBC Asset Tag", '')) <> ''
          AND UPPER(TRIM(COALESCE(Building, ''))) = UPPER(TRIM(COALESCE(?, '')))
          AND UPPER(TRIM(COALESCE("UBC Asset Tag", ''))) = UPPER(TRIM(COALESCE(?, '')))
        LIMIT 1
        ''',
        (building, ubc_tag),
    ).fetchone()
    return dict(row) if row else None


def swift_save_asset(row_id, updates, cascade=False):
    """Save an inline edit from the Swift Over form.

    Keeps three stores in sync when the row has a matched SDI asset:
      - electrical_building_schema  (always updated)
      - sdi_dataset_EL              (updated via _sync_db_from_structured)
      - Output_jason_api/*.json     (updated atomically)

    Returns (status_code, response_dict).

    Rename cascade: if the user changes Equipment ID and other rows reference
    the old tag as their Supply From, the first call returns 409 with
    needs_confirmation + children. Re-posting with cascade=True updates all
    three stores for the parent and for each affected child.
    """
    # Lazy imports to avoid circular dependency: Asset_dashboard_EL imports
    # this blueprint at module load time.
    try:
        from Asset_dashboard_EL import (
            JSON_DIR,
            PROCESSED_JSON_LOG_EL,
            json_sync_lock,
            _apply_el_supply_from_formatting,
            _sync_db_from_structured,
        )
    except Exception as e:  # noqa: BLE001
        return 500, {"error": f"Server misconfigured: cannot load sync helpers ({e})"}

    # 1. Load current SLD row
    conn = _connect()
    try:
        row = conn.execute(
            f'SELECT * FROM "{TABLE}" WHERE row_id = ?', (row_id,)
        ).fetchone()
        if not row:
            return 404, {"error": "Asset not found"}
        current = dict(row)
        building = str(current.get("Building") or "").strip()
        old_tag = str(current.get("Equipment ID") or "").strip()
        new_tag = str(updates.get("Equipment ID", old_tag) or "").strip()
        if not new_tag:
            return 400, {"error": "Equipment ID cannot be empty"}

        new_supply = _apply_el_supply_from_formatting(
            updates.get("Supply From", current.get("Supply From", ""))
        )
        rename = (new_tag.upper() != old_tag.upper())

        # Reject rename that collides with an existing active row
        if rename:
            collision = conn.execute(
                f'''
                SELECT row_id FROM "{TABLE}"
                WHERE {ACTIVE_DRAW_CONDITION}
                  AND Building = ? AND UPPER("Equipment ID") = UPPER(?)
                  AND row_id != ?
                LIMIT 1
                ''',
                (building, new_tag, row_id),
            ).fetchone()
            if collision:
                return 409, {"error": f'"{new_tag}" already exists in this building.'}

        # Detect children pointing at the old tag
        children = []
        if rename:
            children = get_supply_from_children(
                conn, building, old_tag, exclude_row_id=row_id
            )
        if rename and children and not cascade:
            return 409, {
                "needs_confirmation": True,
                "children": children,
                "message": (
                    f'"{old_tag}" is currently Fed From for {len(children)} '
                    f'child asset(s). Rename and update their Fed From too?'
                ),
            }

        # Find matching SDI row for main (pre-rename key is old_tag)
        sdi_row = _find_sdi_row(conn, building, old_tag)
    finally:
        conn.close()

    matched_qr = (str(sdi_row.get("QR Code")).strip() if sdi_row else "") or ""

    # Extract edited values for SLD update
    def _pick(key, default=""):
        val = updates.get(key, default)
        return "" if val is None else str(val).strip()

    new_voltage = _pick("Voltage Rating", current.get("Voltage Rating", ""))
    new_voltage_uom = _pick("Voltage Rating (UoM)", current.get("Voltage Rating (UoM)", ""))
    new_amperage = _pick("Amperage Rating", current.get("Amperage Rating", ""))
    new_amperage_uom = _pick("Amperage Rating (UoM)", current.get("Amperage Rating (UoM)", ""))
    new_power = _pick("Power Rating", current.get("Power Rating", ""))
    new_power_uom = _pick("Power Rating (UoM)", current.get("Power Rating (UoM)", ""))
    new_room = updates.get("Room")  # may be None (unmatched) or string

    # 2. Update electrical_building_schema (single local transaction)
    # ID_check is a derived key = "Building | Equipment ID | Supply From".
    # It MUST be recomputed whenever Equipment ID or Supply From changes, so
    # downstream lookups (id_check_match, SDI cross-matching) stay correct.
    new_id_check = _id_check_value(building, new_tag, new_supply)
    backup_sld = {
        "Equipment ID": current.get("Equipment ID", ""),
        "Supply From": current.get("Supply From", ""),
        "Voltage Rating": current.get("Voltage Rating", ""),
        "Voltage Rating (UoM)": current.get("Voltage Rating (UoM)", ""),
        "Amperage Rating": current.get("Amperage Rating", ""),
        "Amperage Rating (UoM)": current.get("Amperage Rating (UoM)", ""),
        "Power Rating": current.get("Power Rating", ""),
        "Power Rating (UoM)": current.get("Power Rating (UoM)", ""),
        "ID_check": current.get("ID_check", ""),
    }
    conn = _connect()
    try:
        conn.execute("BEGIN")
        conn.execute(
            f'UPDATE "{TABLE}" SET '
            f'"Equipment ID" = ?, "Supply From" = ?, '
            f'"Voltage Rating" = ?, "Voltage Rating (UoM)" = ?, '
            f'"Amperage Rating" = ?, "Amperage Rating (UoM)" = ?, '
            f'"Power Rating" = ?, "Power Rating (UoM)" = ?, '
            f'ID_check = ? '
            f'WHERE row_id = ?',
            (
                new_tag, new_supply,
                new_voltage, new_voltage_uom,
                new_amperage, new_amperage_uom,
                new_power, new_power_uom,
                new_id_check,
                row_id,
            ),
        )
        if rename and cascade and children:
            # Children's Supply From flips old_tag -> new_tag; their ID_check
            # also becomes stale because it still contains old_tag as the parent.
            # Recompute ID_check per-row via SQL concat (each child has its own
            # Building + Equipment ID, but the new parent tag is shared).
            conn.execute(
                f'UPDATE "{TABLE}" SET '
                f'"Supply From" = ?, '
                f'ID_check = TRIM(COALESCE(Building,\'\')) || \' | \' || '
                f'TRIM(COALESCE("Equipment ID",\'\')) || \' | \' || ? '
                f'WHERE Building = ? AND UPPER(COALESCE("Supply From", \'\')) = UPPER(?) '
                f'AND row_id != ?',
                (new_tag, new_tag, building, old_tag, row_id),
            )
        conn.commit()
    except Exception as e:  # noqa: BLE001
        conn.rollback()
        conn.close()
        return 500, {"error": f"Failed to update diagram row: {e}"}
    finally:
        conn.close()

    def _rollback_sld():
        try:
            c = _connect()
            try:
                c.execute(
                    f'UPDATE "{TABLE}" SET '
                    f'"Equipment ID" = ?, "Supply From" = ?, '
                    f'"Voltage Rating" = ?, "Voltage Rating (UoM)" = ?, '
                    f'"Amperage Rating" = ?, "Amperage Rating (UoM)" = ?, '
                    f'"Power Rating" = ?, "Power Rating (UoM)" = ?, '
                    f'ID_check = ? '
                    f'WHERE row_id = ?',
                    (
                        backup_sld["Equipment ID"], backup_sld["Supply From"],
                        backup_sld["Voltage Rating"], backup_sld["Voltage Rating (UoM)"],
                        backup_sld["Amperage Rating"], backup_sld["Amperage Rating (UoM)"],
                        backup_sld["Power Rating"], backup_sld["Power Rating (UoM)"],
                        backup_sld["ID_check"],
                        row_id,
                    ),
                )
                if rename and cascade and children:
                    # Revert children's Supply From back to old_tag and rebuild
                    # their ID_check to match (Building | Equipment ID | old_tag).
                    c.execute(
                        f'UPDATE "{TABLE}" SET '
                        f'"Supply From" = ?, '
                        f'ID_check = TRIM(COALESCE(Building,\'\')) || \' | \' || '
                        f'TRIM(COALESCE("Equipment ID",\'\')) || \' | \' || ? '
                        f'WHERE Building = ? AND UPPER(COALESCE("Supply From", \'\')) = UPPER(?) '
                        f'AND row_id != ?',
                        (old_tag, old_tag, building, new_tag, row_id),
                    )
                c.commit()
            finally:
                c.close()
        except Exception as exc:  # noqa: BLE001
            current_app.logger.error("[sld swift-save] SLD rollback failed: %s", exc)

    # 2b. If Room changed and we have a matched QR, write QR_codes.Location.
    # QR_codes is the master location store — its Location triggers cascade to
    # Space / Floor / Space Details / Floor Code automatically.
    qr_location_backup = None  # (qr, old_location) for rollback
    qr_location_written = False
    if matched_qr and new_room is not None:
        desired_room = str(new_room).strip()
        c = _connect()
        try:
            current_loc = _get_qr_codes_location(c, matched_qr)
            if current_loc is None or (current_loc or "") != desired_room:
                qr_location_backup = (matched_qr, current_loc if current_loc is not None else "")
                try:
                    updated = _set_qr_codes_location(c, matched_qr, desired_room)
                    c.commit()
                    qr_location_written = bool(updated)
                    if not qr_location_written:
                        # QR row missing — don't treat as hard failure; fall through
                        # so sdi_dataset_EL and JSON still get the Room update.
                        qr_location_backup = None
                except Exception as e:  # noqa: BLE001
                    c.rollback()
                    c.close()
                    _rollback_sld()
                    return 500, {"error": f"Failed to update QR_codes.Location: {e}"}
        finally:
            c.close()

    def _rollback_qr_location():
        if not qr_location_written or qr_location_backup is None:
            return
        try:
            c = _connect()
            try:
                _set_qr_codes_location(c, qr_location_backup[0], qr_location_backup[1])
                c.commit()
            finally:
                c.close()
        except Exception as exc:  # noqa: BLE001
            current_app.logger.error(
                "[sld swift-save] QR_codes.Location rollback failed: %s", exc,
            )

    # 3. If main row has a matched SDI asset, sync JSON + sdi_dataset_EL
    json_backups = []  # list of (path, content-or-None) for rollback
    children_updated = []
    children_failed = []

    # SDI columns that the inline editor must NOT modify. Equipment ID and
    # Supply From (its UBC Asset Tag mirror too) are the identity/parent keys
    # that participate in the composite ID_check match. Per product decision
    # the inline editor edits only electrical_building_schema + the JSON file
    # for those keys; sdi_dataset_EL is left untouched so the Check Mark can
    # flip red when the two sides diverge.
    SDI_PROTECTED_KEYS = ("UBC Asset Tag", "Equipment ID", "Supply From")

    def _sync_matched_row(qr, structured_patch, asset_type="EL",
                          sync_sdi=True, sdi_preserve=None):
        """Write merged JSON; optionally sync sdi_dataset_EL.

        sync_sdi=False → write JSON only (caller wants SDI untouched).
        sdi_preserve → dict of field→value overrides applied to the payload
            sent to _sync_db_from_structured. Use this to pin the SDI
            identity/parent keys to their current values so they survive the
            sync even though the JSON reflects the new edits.
        Appends a (path, original) entry to json_backups for rollback."""
        doc_id = f"{qr}_EL_{building}"
        json_path = os.path.join(JSON_DIR, f"{doc_id}.json")
        if not os.path.isfile(json_path):
            raise FileNotFoundError(f"JSON not found for QR {qr}: {json_path}")
        with open(json_path, "r", encoding="utf-8") as f:
            original = json.load(f)
        json_backups.append((json_path, original))
        merged = json.loads(json.dumps(original))
        structured = merged.setdefault("structured_data", {})
        for k, v in structured_patch.items():
            if v is not None:
                structured[k] = v
        merged["modified"] = True
        _atomic_write_json(json_path, merged)
        if not sync_sdi:
            return
        sdi_payload = dict(structured)
        if sdi_preserve:
            for k, v in sdi_preserve.items():
                sdi_payload[k] = "" if v is None else v
        avg = None
        try:
            avg_val = merged.get("Avg_ai_conf") or merged.get("avg_ai_conf")
            if avg_val not in (None, ""):
                avg = float(avg_val)
        except Exception:
            avg = None
        _sync_db_from_structured(qr, building, sdi_payload, asset_type=asset_type, avg_ai_conf=avg)

    def _preserve_from_sdi(sdi_dict):
        # Only pin keys the sdi row actually has values for. Preserving an
        # empty string here entrenches a prior wipe: the merged JSON's real
        # UBC Asset Tag / Equipment ID / Supply From would then be overridden
        # with "" during _sync_db_from_structured, leaving identity fields
        # blank forever. If sdi has nothing for a protected key, let the
        # merged JSON's value flow through untouched.
        if not sdi_dict:
            return None
        out = {}
        for k in SDI_PROTECTED_KEYS:
            v = (sdi_dict.get(k) or "")
            if isinstance(v, str):
                v = v.strip()
            if v:
                out[k] = v
        return out or None

    def _mark_jsons_processed(paths):
        """Record each JSON path's post-write mtime in processed_json_el.log
        so sync_json_directory_to_db_el (the before_request watcher) treats
        the file as already-processed and does NOT re-sync it into SDI.
        Without this, the watcher would pick up our fresh mtime and push the
        new Supply From / Equipment ID from the JSON back into sdi_dataset_EL,
        silently undoing the key-field preservation this endpoint is built to
        guarantee."""
        if not paths:
            return
        try:
            if os.path.exists(PROCESSED_JSON_LOG_EL):
                with open(PROCESSED_JSON_LOG_EL, "r", encoding="utf-8") as f:
                    log = json.load(f)
            else:
                log = {}
            if not isinstance(log, dict):
                log = {}
            for p in paths:
                if os.path.isfile(p):
                    log[os.path.basename(p)] = os.path.getmtime(p)
            tmp = f"{PROCESSED_JSON_LOG_EL}.tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(log, f, indent=2)
            os.replace(tmp, PROCESSED_JSON_LOG_EL)
        except Exception as exc:  # noqa: BLE001
            current_app.logger.warning(
                "[sld swift-save] processed log update failed: %s", exc,
            )

    # Hold json_sync_lock for the whole JSON-write + log-update window so the
    # before_request watcher (sync_json_directory_to_db_el) cannot race in
    # between our write and our "already processed" marker. The watcher uses
    # acquire(blocking=False), so concurrent calls will simply no-op.
    json_sync_lock.acquire()
    try:
        try:
            if matched_qr:
                main_patch = {
                    "UBC Asset Tag": new_tag,
                    "Equipment ID": new_tag,
                    "Supply From": new_supply,
                    "Voltage Rating": new_voltage,
                    "Voltage Rating (UoM)": new_voltage_uom,
                    "Amperage Rating": new_amperage,
                    "Amperage Rating (UoM)": new_amperage_uom,
                    "Power Rating": new_power,
                    "Power Rating (UoM)": new_power_uom,
                }
                if new_room is not None:
                    main_patch["Location"] = str(new_room).strip()
                _sync_matched_row(
                    matched_qr, main_patch, asset_type="EL",
                    sdi_preserve=_preserve_from_sdi(sdi_row),
                )

            if rename and cascade and children:
                for child in children:
                    child_qr = child.get("qr_code") or ""
                    if not child_qr:
                        # Unmatched children only need the SLD update (already done)
                        children_updated.append({
                            "row_id": child["row_id"],
                            "Equipment ID": child["Equipment ID"],
                            "json_synced": False,
                        })
                        continue
                    try:
                        # Supply From is a protected SDI key — the child's JSON gets
                        # the new parent tag, but sdi_dataset_EL is NOT touched.
                        _sync_matched_row(
                            child_qr,
                            {"Supply From": new_tag},
                            asset_type="EL",
                            sync_sdi=False,
                        )
                        children_updated.append({
                            "row_id": child["row_id"],
                            "Equipment ID": child["Equipment ID"],
                            "json_synced": True,
                        })
                    except Exception as exc:  # noqa: BLE001
                        children_failed.append({
                            "row_id": child["row_id"],
                            "Equipment ID": child["Equipment ID"],
                            "error": str(exc),
                        })
        except Exception as e:  # noqa: BLE001
            # Best-effort rollback: restore all JSON backups in reverse order.
            # _sync_db_from_structured already committed for any row that got past
            # step 3; we cannot undo those, but we can re-sync with backup
            # structured_data so the DB matches the restored JSON.
            for path, backup in reversed(json_backups):
                try:
                    if backup is None:
                        if os.path.isfile(path):
                            os.remove(path)
                        continue
                    _atomic_write_json(path, backup)
                    # Re-sync SDI with backup structured_data
                    try:
                        m = re.match(r"^([^_]+)_EL_([^_]+)\.json$", os.path.basename(path))
                        if m:
                            r_qr, r_building = m.group(1), m.group(2)
                            r_struct = backup.get("structured_data", {}) or {}
                            _sync_db_from_structured(
                                r_qr, r_building, r_struct,
                                asset_type=backup.get("asset_type") or "EL",
                                avg_ai_conf=backup.get("Avg_ai_conf"),
                            )
                    except Exception as exc:  # noqa: BLE001
                        current_app.logger.error(
                            "[sld swift-save] SDI rollback failed for %s: %s", path, exc,
                        )
                except Exception as exc:  # noqa: BLE001
                    current_app.logger.error(
                        "[sld swift-save] JSON rollback failed for %s: %s", path, exc,
                    )
            # Even on rollback, record the (now-restored) JSON mtimes as
            # processed so the watcher doesn't re-run _sync_db_from_structured
            # on the restored content — we already did that ourselves above.
            _mark_jsons_processed([p for (p, _) in json_backups])
            _rollback_qr_location()
            _rollback_sld()
            return 500, {"error": f"Failed to sync captured asset: {e}"}

        # Success: pin the just-written JSON mtimes in processed_json_el.log
        # so the before_request watcher does NOT re-sync SDI from them.
        _mark_jsons_processed([p for (p, _) in json_backups])
    finally:
        json_sync_lock.release()

    # 4. Recompute matching_check
    try:
        recompute_matching_check(building=building)
    except Exception as exc:  # noqa: BLE001
        current_app.logger.warning("[sld swift-save] matching_check refresh failed: %s", exc)

    # 5. Re-read enriched row
    updated_assets = get_all_assets(building=building)
    updated_row = next((a for a in updated_assets if a.get("row_id") == row_id), None)

    payload = {
        "status": "ok",
        "row": updated_row,
        "children_updated": children_updated,
    }
    if children_failed:
        payload["children_failed"] = children_failed
    return 200, payload


def delete_asset(row_id):
    conn = _connect()
    try:
        row = conn.execute(
            f'SELECT "Equipment ID", "Supply From" FROM "{TABLE}" WHERE row_id = ?',
            (row_id,),
        ).fetchone()
        if not row:
            return False, "Asset not found"
        tag, parent = row["Equipment ID"], row["Supply From"]
        conn.execute(
            f'UPDATE "{TABLE}" SET "Supply From" = ? WHERE "Supply From" = ?',
            (parent, tag),
        )
        conn.execute(f'DELETE FROM "{TABLE}" WHERE row_id = ?', (row_id,))
        conn.commit()
        return True, "OK"
    finally:
        conn.close()


def backup_all_rows():
    conn = _connect()
    try:
        rows = conn.execute(f'SELECT * FROM "{TABLE}"').fetchall()
        return [dict(r) for r in rows]
    finally:
        conn.close()


def restore_archived_rows(archived_rows):
    if not archived_rows:
        return
    conn = _connect()
    try:
        for row in archived_rows:
            conn.execute(
                f'INSERT INTO "{TABLE}" '
                f'("Hierarchy", "Supply From", "Equipment ID", "Building", '
                f'"Amperage Rating", "Amperage Rating (UoM)", '
                f'"Power Rating", "Power Rating (UoM)", '
                f'"Voltage Rating", "Voltage Rating (UoM)", ambigous, new_draw, source_pdf, created_at) '
                f'VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)',
                (
                    row["Hierarchy"],
                    row["Supply From"],
                    row["Equipment ID"],
                    row["Building"],
                    row.get("Amperage Rating", ""),
                    row.get("Amperage Rating (UoM)", ""),
                    row.get("Power Rating", ""),
                    row.get("Power Rating (UoM)", ""),
                    row.get("Voltage Rating", ""),
                    row.get("Voltage Rating (UoM)", ""),
                    row.get("ambigous", ""),
                    "FALSE",
                    row.get("source_pdf", ""),
                    row.get("created_at", ""),
                ),
            )
        conn.commit()
    finally:
        conn.close()


def mark_new_rows_and_source(building_code, pdf_filename):
    conn = _connect()
    try:
        now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        conn.execute(
            f'UPDATE "{TABLE}" SET new_draw = "TRUE", source_pdf = ?, created_at = ? '
            f'WHERE Building = ? AND (new_draw IS NULL OR new_draw = "")',
            (pdf_filename, now, building_code),
        )
        conn.commit()
    finally:
        conn.close()


def derive_building_code(filename):
    stem = os.path.splitext(filename)[0].strip()
    prefix, sep, _ = stem.partition(" - ")
    return prefix if sep else stem


def validate_pdf_filename(filename):
    if not filename.lower().endswith(".pdf"):
        return False, "File must be a PDF (.pdf)"
    if not FILENAME_PATTERN.match(filename):
        return False, "Filename must begin with 3 numeric digits (e.g. 314-1 - Building Name.pdf)"
    return True, ""


