{# Single Line Diagram tab pane — included from dashboard.html for Distribution view #}
<div class="sld-pane">
  <div id="sld-header">
    <div id="sld-header-left">
      <div>
        <h3 id="sld-page-title">Single Line Diagram</h3>
        <div class="sld-subtitle">Maintenance Planning Department &middot; Click any node to edit</div>
        <div class="sld-stats">
          <span class="sld-stat"><strong id="sld-asset-count">0</strong> Assets</span>
          <span class="sld-stat sld-stat-ok" title="Matches found in sdi_dataset_EL"><strong id="sld-stat-matched">0</strong> matched</span>
          <span class="sld-stat sld-stat-bad" title="No matching row in sdi_dataset_EL"><strong id="sld-stat-unmatched">0</strong> unmatched</span>
          <span class="sld-stat sld-stat-warn" title="Assets with multiple parent candidates"><strong id="sld-stat-ambiguous">0</strong> ambiguous</span>
        </div>
      </div>
    </div>
    <div id="sld-controls">
      <select id="sld-building-selector" title="Select building">
        <option value="">Loading...</option>
      </select>
      <button type="button" id="sld-orientation-btn" title="Toggle layout orientation">Layout: Vertical</button>
      <button type="button" class="btn-import" id="sld-open-import-btn">Create a New Diagram</button>
      <button type="button" class="btn-new" id="sld-open-create-btn">+ New Asset</button>
      <button type="button" class="btn-swift-over" id="sld-swift-over-btn" title="Inline edit every asset in this diagram">Swift Over</button>
      <button type="button" class="btn-swift-over-back" id="sld-swift-over-back-btn" style="display:none" title="Return to the diagram view">&larr; Back to Diagram</button>
    </div>
  </div>

  <div id="sld-view-tabs" class="sld-view-switcher" role="tablist" aria-label="Single Line Diagram views">
    <button type="button" class="sld-view-tab active" id="sld-view-diagram-btn" data-sld-view="diagram" role="tab" aria-selected="true" aria-controls="sld-diagram-view">
      <i class="bi bi-diagram-3" aria-hidden="true"></i>
      <span class="sld-view-label">Diagram</span>
    </button>
    <button type="button" class="sld-view-tab" id="sld-view-missed-btn" data-sld-view="missed" role="tab" aria-selected="false" aria-controls="sld-missed-view">
      <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
      <span class="sld-view-label">Missed Assets</span>
      <span class="sld-count-pill" id="sld-missed-tab-count">0</span>
    </button>
    <button type="button" class="sld-view-tab" id="sld-view-sdi-missing-btn" data-sld-view="sdi-missing" role="tab" aria-selected="false" aria-controls="sld-sdi-missing-view">
      <i class="bi bi-clipboard-x" aria-hidden="true"></i>
      <span class="sld-view-label">Missing from SLD</span>
      <span class="sld-count-pill" id="sld-sdi-missing-tab-count">0</span>
    </button>
  </div>

  <div class="sld-view active" id="sld-diagram-view" role="tabpanel" aria-labelledby="sld-view-diagram-btn">
    <div id="sld-legend-bar">
      <span class="legend-label">Legend</span>
      <div class="sld-legend-item"><svg width="30" height="14" viewBox="0 0 30 14"><rect x="0.5" y="0.5" width="29" height="13" rx="2" fill="#0d1b3e" stroke="#c8d6e5" stroke-width="0.6"/><rect x="1.5" y="1.5" width="27" height="11" rx="1" fill="none" stroke="#8899aa" stroke-width="0.3"/><line x1="9" y1="1.5" x2="9" y2="12.5" stroke="#8899aa" stroke-width="0.3"/><line x1="5" y1="3" x2="5" y2="11" stroke="#fff" stroke-width="0.7"/><rect x="3.5" y="3.5" width="3" height="3" rx="1.5" fill="none" stroke="#fff" stroke-width="0.5"/><rect x="3.5" y="7.5" width="3" height="3" rx="1.5" fill="none" stroke="#fff" stroke-width="0.5"/><path d="M7,9 L6,11 L7,11 L6.2,12.5 L8.5,10.5 L7.2,10.5 Z" fill="#fff"/></svg> CDP / NDC / EDC / MDC</div>
    <div class="sld-legend-item"><svg width="24" height="18" viewBox="0 0 24 18"><rect x="0.5" y="0.5" width="23" height="17" rx="2" fill="#1a8a9b" stroke="#c8d6e5" stroke-width="0.6"/><circle cx="7" cy="3" r="1.3" fill="none" stroke="#fff" stroke-width="0.7"/><circle cx="17" cy="3" r="1.3" fill="none" stroke="#fff" stroke-width="0.7"/><line x1="7" y1="4.3" x2="7" y2="8" stroke="#fff" stroke-width="0.7"/><line x1="17" y1="4.3" x2="17" y2="8" stroke="#fff" stroke-width="0.7"/><circle cx="7" cy="8.5" r="1" fill="none" stroke="#fff" stroke-width="0.6"/><circle cx="17" cy="8.5" r="1" fill="none" stroke="#fff" stroke-width="0.6"/><line x1="7" y1="8.5" x2="12" y2="12" stroke="#fff" stroke-width="0.8"/><line x1="12" y1="12.5" x2="12" y2="15" stroke="#fff" stroke-width="0.7"/><circle cx="12" cy="15.5" r="1.3" fill="none" stroke="#fff" stroke-width="0.7"/></svg> ATS</div>
    <div class="sld-legend-item"><svg width="20" height="18" viewBox="0 0 20 18"><rect x="2" y="6" width="16" height="10" rx="2" fill="#2e6ea6" stroke="#c8d6e5" stroke-width="0.6"/><line x1="5" y1="1" x2="5" y2="6" stroke="#2e6ea6" stroke-width="1.2"/><line x1="10" y1="1" x2="10" y2="6" stroke="#2e6ea6" stroke-width="1.2"/><line x1="15" y1="1" x2="15" y2="6" stroke="#2e6ea6" stroke-width="1.2"/><ellipse cx="5" cy="3" rx="2" ry="1.2" fill="none" stroke="#2e6ea6" stroke-width="0.8"/><ellipse cx="10" cy="3" rx="2" ry="1.2" fill="none" stroke="#2e6ea6" stroke-width="0.8"/><ellipse cx="15" cy="3" rx="2" ry="1.2" fill="none" stroke="#2e6ea6" stroke-width="0.8"/><path d="M11,8 L8.5,11.5 L10.5,11.5 L9,14.5 L12,10.5 L10,10.5 Z" fill="none" stroke="#fff" stroke-width="0.8"/></svg> TX</div>
    <div class="sld-legend-item"><svg width="20" height="20" viewBox="0 0 20 20"><rect x="0.5" y="0.5" width="19" height="16" rx="2" fill="#4a90c4" stroke="#c8d6e5" stroke-width="0.6"/><rect x="2" y="2" width="16" height="12" rx="1" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="0.4"/><rect x="0.8" y="4" width="1.5" height="3" rx="0.5" fill="rgba(255,255,255,0.6)"/><rect x="0.8" y="9" width="1.5" height="3" rx="0.5" fill="rgba(255,255,255,0.6)"/><circle cx="5.5" cy="4" r="1" fill="none" stroke="#fff" stroke-width="0.5"/><circle cx="8" cy="4" r="1" fill="none" stroke="#fff" stroke-width="0.5"/><circle cx="10.5" cy="4" r="1" fill="none" stroke="#fff" stroke-width="0.5"/><circle cx="13" cy="4" r="1" fill="none" stroke="#fff" stroke-width="0.5"/><path d="M9,6 L6.5,11 L9.5,11 Z" fill="none" stroke="#fff" stroke-width="0.6"/><path d="M8.5,7.5 L7.8,9.5 L8.8,9.5 L8.2,10.5" fill="none" stroke="#fff" stroke-width="0.5"/><line x1="5" y1="12" x2="13" y2="12" stroke="#fff" stroke-width="0.5"/><line x1="5" y1="13.5" x2="13" y2="13.5" stroke="#fff" stroke-width="0.5"/><line x1="8" y1="16.5" x2="8" y2="19" stroke="#4a90c4" stroke-width="0.8"/><line x1="10" y1="16.5" x2="10" y2="19" stroke="#4a90c4" stroke-width="0.8"/><line x1="12" y1="16.5" x2="12" y2="19" stroke="#4a90c4" stroke-width="0.8"/></svg> PNL</div>
    <div class="sld-legend-item"><svg width="22" height="20" viewBox="0 0 22 20"><rect x="7" y="0" width="8" height="5" rx="2" fill="none" stroke="#7b68ae" stroke-width="1"/><line x1="8.5" y1="2" x2="13.5" y2="2" stroke="#7b68ae" stroke-width="0.6"/><line x1="8.5" y1="3.5" x2="13.5" y2="3.5" stroke="#7b68ae" stroke-width="0.6"/><line x1="11" y1="5" x2="11" y2="8" stroke="#7b68ae" stroke-width="1.2"/><path d="M11,8 L4,8 L4,12" fill="none" stroke="#7b68ae" stroke-width="1.2" stroke-linejoin="round"/><path d="M11,8 L18,8 L18,12" fill="none" stroke="#7b68ae" stroke-width="1.2" stroke-linejoin="round"/><rect x="1" y="12" width="6" height="4.5" rx="1.5" fill="none" stroke="#7b68ae" stroke-width="1"/><line x1="2.5" y1="13.5" x2="5.5" y2="13.5" stroke="#7b68ae" stroke-width="0.5"/><line x1="2.5" y1="15" x2="5.5" y2="15" stroke="#7b68ae" stroke-width="0.5"/><rect x="15" y="12" width="6" height="4.5" rx="1.5" fill="none" stroke="#7b68ae" stroke-width="1"/><line x1="16.5" y1="13.5" x2="19.5" y2="13.5" stroke="#7b68ae" stroke-width="0.5"/><line x1="16.5" y1="15" x2="19.5" y2="15" stroke="#7b68ae" stroke-width="0.5"/></svg> SPL</div>
    <div class="sld-legend-item"><svg width="30" height="14" viewBox="0 0 30 14"><rect x="0.5" y="0.5" width="29" height="13" rx="2" fill="#556270" stroke="#3a4550" stroke-width="0.6"/><rect x="1" y="1" width="9" height="12" rx="1" fill="#3a4550"/><line x1="3" y1="3" x2="8" y2="3" stroke="#6b7c8a" stroke-width="0.5"/><line x1="3" y1="4.5" x2="8" y2="4.5" stroke="#6b7c8a" stroke-width="0.5"/><rect x="22" y="1.5" width="6" height="2.5" rx="0.5" fill="#64737e" stroke="#3a4550" stroke-width="0.3"/><rect x="22" y="4.5" width="6" height="2.5" rx="0.5" fill="#64737e" stroke="#3a4550" stroke-width="0.3"/><rect x="22" y="7.5" width="6" height="2.5" rx="0.5" fill="#64737e" stroke="#3a4550" stroke-width="0.3"/><rect x="22" y="10.5" width="6" height="2.5" rx="0.5" fill="#64737e" stroke="#3a4550" stroke-width="0.3"/><line x1="24" y1="2.5" x2="24" y2="3.5" stroke="#c8d6e5" stroke-width="1" stroke-linecap="round"/><line x1="24" y1="5.5" x2="24" y2="6.5" stroke="#c8d6e5" stroke-width="1" stroke-linecap="round"/><line x1="24" y1="8.5" x2="24" y2="9.5" stroke="#c8d6e5" stroke-width="1" stroke-linecap="round"/><line x1="24" y1="11.5" x2="24" y2="12.5" stroke="#c8d6e5" stroke-width="1" stroke-linecap="round"/></svg> SWBD</div>
    <div class="sld-legend-item"><svg width="18" height="12"><line x1="0" y1="6" x2="18" y2="6" stroke="#e8913a" stroke-width="2" stroke-dasharray="4 2"/></svg> Ambiguous</div>
    <div class="sld-legend-item"><svg width="14" height="14" viewBox="0 0 14 14"><circle cx="7" cy="7" r="6" fill="#10b981" stroke="#ffffff" stroke-width="1.5"/><text x="7" y="7.5" text-anchor="middle" dominant-baseline="central" fill="#ffffff" font-size="9" font-weight="bold">&#10003;</text></svg> ID_check match</div>
    <div class="sld-legend-item"><svg width="14" height="14" viewBox="0 0 14 14"><circle cx="7" cy="7" r="6" fill="#ef4444" stroke="#ffffff" stroke-width="1.5"/><text x="7" y="7.5" text-anchor="middle" dominant-baseline="central" fill="#ffffff" font-size="9" font-weight="bold">&#10007;</text></svg> No ID_check match</div>
    </div>

    <div id="sld-diagram">
      <div id="sld-empty-state">
        <div class="es-icon">&#9889;</div>
        <div class="es-text">No eligible diagram assets. Review missed assets or import a PDF.</div>
        <button type="button" class="ep-btn ep-btn-import" id="sld-empty-import-btn">Create a New Diagram</button>
      </div>
      <div id="sld-zoom-controls">
        <button type="button" id="sld-zoom-out-btn" title="Zoom out (shortcut: -)">&minus;</button>
        <span id="sld-zoom-level" title="Current zoom">100%</span>
        <button type="button" id="sld-zoom-in-btn" title="Zoom in (shortcut: +)">&plus;</button>
        <div class="sld-zoom-sep"></div>
        <button type="button" id="sld-zoom-fit-btn" title="Fit to screen (shortcut: 0)">&#x26F6;</button>
        <button type="button" id="sld-zoom-reset-btn" title="Reset zoom">&#x21BB;</button>
      </div>
    </div>
  </div>

  <div class="sld-view" id="sld-missed-view" role="tabpanel" aria-labelledby="sld-view-missed-btn" aria-hidden="true">
    <div class="sld-missed-toolbar">
      <div>
        <h4>Missed Assets</h4>
      </div>
      <button type="button" class="ep-btn ep-btn-delete" id="sld-exclude-missed-btn" disabled>Exclude selected</button>
    </div>
    <div class="sld-missed-table-wrap">
      <table class="sld-missed-table">
        <thead>
          <tr>
            <th class="sld-select-col"><input type="checkbox" id="sld-missed-select-all" aria-label="Select all missed assets"></th>
            <th>Equipment ID</th>
            <th>Supply From</th>
            <th>Group of Asset</th>
            <th class="sld-action-col">Action</th>
          </tr>
        </thead>
        <tbody id="sld-missed-tbody">
          <tr>
            <td colspan="5" class="sld-missed-empty">No missed assets.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="sld-view" id="sld-sdi-missing-view" role="tabpanel" aria-labelledby="sld-view-sdi-missing-btn" aria-hidden="true">
    <div class="sld-missed-toolbar">
      <div>
        <h4>Missing from SLD</h4>
        <div class="sld-subtitle">Distribution assets captured in the field that are not in the active diagram.</div>
      </div>
    </div>
    <div class="sld-missed-table-wrap">
      <table class="sld-missed-table">
        <thead>
          <tr>
            <th>UBC Asset Tag</th>
            <th>Supply From</th>
            <th>Asset Group</th>
            <th>QR Code</th>
            <th class="sld-action-col">Action</th>
          </tr>
        </thead>
        <tbody id="sld-sdi-missing-tbody">
          <tr>
            <td colspan="5" class="sld-missed-empty">No missing assets.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="sld-swift-over-pane" id="sld-swift-over-pane" style="display:none" aria-hidden="true">
    <div class="sld-swift-over-header">
      <div>
        <h4 class="sld-swift-over-title">Swift Over &mdash; inline editor</h4>
        <div class="sld-subtitle">Edit each asset directly in the table. Saves update the diagram, the captured asset, and its JSON at once.</div>
      </div>
      <div class="sld-swift-over-legend">
        <span class="sld-swift-legend-item"><span class="sld-swift-dot matched"></span>Matched (syncs to captured asset + JSON)</span>
        <span class="sld-swift-legend-item"><span class="sld-swift-dot unmatched"></span>Unmatched (diagram only)</span>
      </div>
    </div>
    <div class="sld-swift-table-wrap">
      <table class="sld-swift-table" id="sld-swift-table">
        <colgroup id="sld-swift-colgroup">
          <col data-col="hierarchy">
          <col data-col="qr">
          <col data-col="equipment">
          <col data-col="feed">
          <col data-col="room">
          <col data-col="voltage">
          <col data-col="amperage">
          <col data-col="power">
          <col data-col="check">
          <col data-col="save">
        </colgroup>
        <thead>
          <tr>
            <th scope="col" class="col-hierarchy">Hierarchy</th>
            <th scope="col" class="col-qr">QR Code</th>
            <th scope="col" class="col-equipment">Equipment ID</th>
            <th scope="col" class="col-feed">Fed From</th>
            <th scope="col" class="col-room">Room</th>
            <th scope="col" class="col-voltage">Voltage</th>
            <th scope="col" class="col-amperage">Amperage</th>
            <th scope="col" class="col-power">Power</th>
            <th scope="col" class="col-check" title="SLD row matches a captured asset tag in sdi_dataset_EL">Check</th>
            <th scope="col" class="col-save">Save</th>
          </tr>
        </thead>
        <tbody id="sld-swift-tbody">
          <tr><td colspan="10" class="sld-swift-empty">Select a building to load assets.</td></tr>
        </tbody>
      </table>
    </div>
    <datalist id="sld-swift-room-locations"></datalist>
  </div>

  <div class="sld-tooltip" id="sld-tooltip"></div>

  <!-- Edit Panel -->
  <div class="sld-modal-overlay" id="sld-edit-overlay">
    <div class="sld-modal-panel">
      <div class="ep-header">
        <div style="display:flex;align-items:center;gap:14px">
          <svg id="sld-ep-icon" width="180" height="56" viewBox="0 0 180 56"></svg>
        </div>
        <button type="button" class="ep-close" id="sld-ep-close-btn">&times;</button>
      </div>
      <div class="ep-body">
        <div class="ep-field">
          <label>Row ID</label>
          <div class="ep-readonly" id="sld-ep-rowid"></div>
        </div>
        <div class="ep-field">
          <label>Equipment ID</label>
          <input type="text" id="sld-ep-tag" autocomplete="off" spellcheck="false">
        </div>
        <div class="ep-field">
          <label>Supply From</label>
          <select id="sld-ep-parent"></select>
        </div>
        <div class="ep-field" id="sld-ep-ambiguous-section" style="display:none">
          <label>Ambiguous Parent &mdash; Resolve</label>
          <div class="ep-ambiguous-banner">
            This asset has multiple parent candidates. Select the correct parent below to resolve the ambiguity.
          </div>
          <div id="sld-ep-ambiguous-options"></div>
        </div>
        <div class="ep-field">
          <label>Hierarchy Level</label>
          <div class="ep-readonly" id="sld-ep-hierarchy"></div>
        </div>
        <div class="ep-field">
          <label>Voltage Rating</label>
          <div class="ep-readonly" id="sld-ep-voltage"></div>
        </div>
        <div class="ep-field">
          <label>Amperage / Power Rating</label>
          <div class="ep-readonly" id="sld-ep-rating"></div>
        </div>
      </div>
      <div class="ep-actions">
        <button type="button" class="ep-btn ep-btn-delete" id="sld-ep-delete">Delete</button>
        <button type="button" class="ep-btn ep-btn-cancel" id="sld-ep-cancel">Cancel</button>
        <button type="button" class="ep-btn ep-btn-save" id="sld-ep-save">Save Changes</button>
      </div>
    </div>
  </div>

  <!-- Missed-asset QR Prompt -->
  <div class="sld-modal-overlay" id="sld-missed-qr-overlay">
    <div class="sld-modal-panel">
      <div class="ep-header">
        <h2>Link QR Code</h2>
        <button type="button" class="ep-close" id="sld-mqr-close-btn">&times;</button>
      </div>
      <div class="ep-body">
        <div class="ep-field">
          <label>Equipment ID</label>
          <div class="ep-readonly" id="sld-mqr-equipment"></div>
        </div>
        <div class="ep-field">
          <label>QR Code</label>
          <input type="text" id="sld-mqr-qr" autocomplete="off" spellcheck="false"
                 placeholder="Scan or type the QR Code">
          <div class="sld-mqr-status" id="sld-mqr-status" aria-live="polite"></div>
        </div>
      </div>
      <div class="ep-actions">
        <button type="button" class="ep-btn ep-btn-cancel" id="sld-mqr-cancel">Cancel</button>
        <button type="button" class="ep-btn ep-btn-save" id="sld-mqr-confirm" disabled>Confirm &amp; Add</button>
      </div>
    </div>
  </div>

  <!-- Create Panel -->
  <div class="sld-modal-overlay" id="sld-create-overlay">
    <div class="sld-modal-panel">
      <div class="ep-header">
        <h2>Create New Asset</h2>
        <button type="button" class="ep-close" id="sld-cp-close-btn">&times;</button>
      </div>
      <div class="ep-body">
        <div class="ep-field">
          <label>Equipment ID</label>
          <input type="text" id="sld-cp-tag" autocomplete="off" spellcheck="false" placeholder="e.g. CDP-6N1L1">
        </div>
        <div class="ep-field">
          <label>Supply From</label>
          <select id="sld-cp-parent"></select>
        </div>
        <div class="ep-field">
          <label>Building</label>
          <input type="text" id="sld-cp-building" value="314-1">
        </div>
        <div class="ep-field">
          <label>Voltage Rating</label>
          <div style="display:flex;gap:8px">
            <input type="text" id="sld-cp-voltage" placeholder="e.g. 208Y/120" style="flex:1">
            <select id="sld-cp-voltage-uom" style="width:70px"><option value="">--</option><option value="V" selected>V</option></select>
          </div>
        </div>
        <div class="ep-field">
          <label>Amperage Rating</label>
          <div style="display:flex;gap:8px">
            <input type="text" id="sld-cp-amperage" placeholder="e.g. 225" style="flex:1">
            <select id="sld-cp-amperage-uom" style="width:70px"><option value="">--</option><option value="A" selected>A</option></select>
          </div>
        </div>
        <div class="ep-field">
          <label>Power Rating</label>
          <div style="display:flex;gap:8px">
            <input type="text" id="sld-cp-power" placeholder="e.g. 300" style="flex:1">
            <select id="sld-cp-power-uom" style="width:80px">
              <option value="">--</option><option value="kVA">kVA</option><option value="VA">VA</option>
              <option value="kW">kW</option><option value="W">W</option><option value="MVA">MVA</option><option value="MW">MW</option>
            </select>
          </div>
        </div>
      </div>
      <div class="ep-actions">
        <button type="button" class="ep-btn ep-btn-cancel" id="sld-cp-cancel">Cancel</button>
        <button type="button" class="ep-btn ep-btn-create" id="sld-cp-save">Create Asset</button>
      </div>
    </div>
  </div>

  <!-- Import Panel -->
  <div class="sld-modal-overlay" id="sld-import-overlay">
    <div class="sld-modal-panel">
      <div class="ep-header">
        <h2>Create a New Diagram &mdash; Single Line Diagram</h2>
        <button type="button" class="ep-close" id="sld-import-close-btn">&times;</button>
      </div>
      <div class="ep-body">
        <div class="ep-field">
          <label>Select PDF file</label>
          <div class="drop-zone" id="sld-drop-zone">
            <div class="dz-icon">&#128196;</div>
            <div class="dz-text">Click to browse or drag &amp; drop a PDF here</div>
            <div class="dz-hint">Filename must start with 3 digits (e.g. 314-1 - Building Name.pdf)</div>
          </div>
          <input type="file" id="sld-file-input" accept=".pdf" style="display:none">
          <div id="sld-file-selected" class="dz-file-selected" style="display:none">
            <span class="dz-fname" id="sld-file-selected-name"></span>
            <button type="button" class="dz-remove" id="sld-file-clear-btn">&times;</button>
          </div>
        </div>

        <div class="ep-field" id="sld-import-building-info" style="display:none">
          <label>Detected Building</label>
          <div class="ep-readonly" id="sld-import-building-code"></div>
        </div>

        <div id="sld-import-conflict-box" style="display:none"></div>
        <div id="sld-import-progress" style="display:none"></div>
      </div>
      <div class="ep-actions">
        <button type="button" class="ep-btn ep-btn-cancel" id="sld-import-cancel">Cancel</button>
        <button type="button" class="ep-btn ep-btn-import" id="sld-import-btn" disabled>Upload &amp; Process</button>
      </div>
    </div>
  </div>

  <div class="sld-toast" id="sld-toast"></div>
</div>
