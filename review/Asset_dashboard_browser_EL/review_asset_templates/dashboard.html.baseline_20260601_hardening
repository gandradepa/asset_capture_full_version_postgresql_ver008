    <script>
        window.resetFilters = function (tabName) {
            // Build a clean query string so the server returns an unfiltered dataset
            var params = new URLSearchParams(window.location.search || '');
            var tab = tabName || params.get('tab') || 'new';
            var globalBuildingSel = document.getElementById('global-building-selector');
            var currentBuilding = ((globalBuildingSel && globalBuildingSel.value)
                || params.get('filter_building')
                || params.get('building')
                || '').trim();
            params.set('tab', tab);
            params.set('process', tab === 'update' ? '1' : (tab === 'manual' ? '2' : '0'));
            ['flagged', 'modified', 'missed', 'archive', 'building', 'approved', 'filter_qr', 'filter_tag', 'filter_group', 'filter_building', 'filter_approved', 'filter_date', 'filter_captured_by', 'conf_min', 'conf_max', 'traffic_light']
                .forEach(function (key) { params.delete(key); });
            if (currentBuilding) {
                params.set('building', currentBuilding);
                params.set('filter_building', currentBuilding);
            }

            // Clear persisted table state to drop any client-side searches (e.g., QR search)
            if (window.$ && $.fn.dataTable) {
                try { $.fn.dataTable.tables({ api: true }).state.clear(); } catch (e) { }
            }
            try { localStorage.removeItem('dashboardQuery'); } catch (e) { }

            var suffix = tab === 'update' ? '-update' : (tab === 'manual' ? '-manual' : '-new');
            var tableId = 'assetTable' + (tab === 'new' ? 'New' : (tab === 'update' ? 'Update' : 'Manual')) + '_v2';
            var table = (window.tables || {})[tableId];

            // Clear filter inputs for immediate UI feedback while the page reloads
            $('#filter-qr' + suffix).val('');
            $('#filter-date' + suffix).val('');
            $('#filter-tag' + suffix).val('');
            $('#filter-group' + suffix).val('');
            $('#filter-building' + suffix).val(currentBuilding);
            $('#filter-captured-by' + suffix).val('');
            $('#filter-traffic' + suffix).val('');
            if (window.syncTrafficFilterDropdowns) window.syncTrafficFilterDropdowns(document);
            if (tab === 'manual') {
                $('#filter-approved' + suffix).val(''); // Default to "All" for Manual
            } else {
                $('#filter-approved' + suffix).val('False'); // Default to "Pending" for others
            }

            // Clear DataTable column searches and global search
            if (table) {
                table.columns().search('');
                table.search('').draw();
            }

            window.confRangeMin = 0;
            window.confRangeMax = 100;
            ['new', 'update', 'manual'].forEach(function(t) {
                var el = document.getElementById('confSlider-' + t);
                if (el && el.noUiSlider) el.noUiSlider.set([0, 100]);
            });

            // Update review links (to clear filter params)
            if (window.updateReviewLinks) window.updateReviewLinks(tableId);

            // Reload dashboard without table filters while preserving the current page scope.
            var query = params.toString();
            window.location.assign(window.location.pathname + (query ? '?' + query : ''));
        };

        function updateDashboardQuery(tabName) {
            var params = new URLSearchParams(window.location.search || "");
            var tab = tabName || params.get('tab') || 'new';
            params.set('tab', tab);
            params.set('process', tab === 'update' ? '1' : (tab === 'manual' ? '2' : '0'));
            params.delete('flagged');
            params.delete('modified');
            // archive intentionally preserved across filter/tab changes so a
            // "Show Archive" view survives a Review Status / tab change.

            var suffix = tab === 'update' ? '-update' : (tab === 'manual' ? '-manual' : '-new');
            var qrVal = ($('#filter-qr' + suffix).val() || '').trim();
            var dateVal = $('#filter-date' + suffix).val();
            var tagVal = ($('#filter-tag' + suffix).val() || '').trim();
            var groupVal = $('#filter-group' + suffix).val() || '';
            var capturedByVal = $('#filter-captured-by' + suffix).val() || '';
            if (dateVal) params.set('filter_date', dateVal); else params.delete('filter_date');
            if (qrVal) params.set('filter_qr', qrVal); else params.delete('filter_qr');
            if (tagVal) params.set('filter_tag', tagVal); else params.delete('filter_tag');
            if (groupVal) params.set('filter_group', groupVal); else params.delete('filter_group');
            if (capturedByVal) params.set('filter_captured_by', capturedByVal); else params.delete('filter_captured_by');

            var approvedSel = '#filter-approved' + suffix;
            var trafficSel = '#filter-traffic' + suffix;

            // Building is driven by the global selector, not per-tab. Fall back to existing URL param.
            var globalSel = document.getElementById('global-building-selector');
            var building = (globalSel && globalSel.value) || params.get('filter_building') || params.get('building') || '';
            var approved = $(approvedSel).val();
            var trafficLight = normalizeTrafficLightFilterValue($(trafficSel).val());

            if (building) {
                params.set('building', building);
                params.set('filter_building', building);
            } else {
                params.delete('building');
                params.delete('filter_building');
            }
            if (approved === '') {
                params.set('approved', 'all');
                params.set('filter_approved', 'all');
            } else if (approved) {
                params.set('approved', approved);
                params.set('filter_approved', approved);
            } else {
                params.delete('approved');
                params.delete('filter_approved');
            }
            if (trafficLight) params.set('traffic_light', trafficLight); else params.delete('traffic_light');
            var rMin = Math.round(window.confRangeMin || 0);
            var rMax = Math.round(window.confRangeMax !== undefined ? window.confRangeMax : 100);
            if (rMin !== 0 || rMax !== 100) {
                params.set('conf_min', rMin);
                params.set('conf_max', rMax);
            } else {
                params.delete('conf_min');
                params.delete('conf_max');
            }

            var q = '?' + params.toString();
            try { localStorage.setItem('dashboardQuery', q); } catch (e) { }
            return q;
        }

        function getDashboardQueryParam(params, primaryKey, fallbackKey) {
            if (params.has(primaryKey)) return params.get(primaryKey) || '';
            if (fallbackKey && params.has(fallbackKey)) return params.get(fallbackKey) || '';
            return null;
        }

        var TRAFFIC_LIGHT_OPTIONS = ['green', 'yellow', 'red'];
        window.confRangeMin = {{ conf_min if conf_min is not none else 0 }};
        window.confRangeMax = {{ conf_max if conf_max is not none else 100 }};

        function normalizeTrafficLightFilterValue(value) {
            if (value === undefined || value === null || value === '') return '';
            var normalized = String(value).trim().toLowerCase();
            return TRAFFIC_LIGHT_OPTIONS.indexOf(normalized) !== -1 ? normalized : '';
        }

        function renderTrafficFilterContent(value) {
            var normalized = normalizeTrafficLightFilterValue(value);
            if (!normalized) {
                return '<span class="traffic-filter__all-text">All Statuses</span>';
            }
            var label = normalized.charAt(0).toUpperCase() + normalized.slice(1);
            return '<span class="traffic-ball traffic-ball--' + normalized + '" aria-hidden="true"></span>'
                + '<span class="visually-hidden">' + label + '</span>';
        }

        function syncTrafficFilterDropdown($select) {
            if (!$select || !$select.length) return;
            var $container = $select.closest('.traffic-filter');
            if (!$container.length) return;

            var normalized = normalizeTrafficLightFilterValue($select.val());
            $container.find('.traffic-filter__current').html(renderTrafficFilterContent(normalized));
            $container.find('.traffic-filter__option').removeClass('active').attr('aria-current', 'false');
            $container.find('.traffic-filter__option').each(function () {
                var $option = $(this);
                var optionValue = normalizeTrafficLightFilterValue($option.data('value'));
                var isActive = optionValue === normalized || (!optionValue && !normalized);
                $option.toggleClass('active', isActive).attr('aria-current', isActive ? 'true' : 'false');
            });
        }

        function syncTrafficFilterDropdowns(scope) {
            var $root = scope ? $(scope) : $(document);
            $root.find('select[id^="filter-traffic-"]').each(function () {
                syncTrafficFilterDropdown($(this));
            });
        }

        window.syncTrafficFilterDropdowns = syncTrafficFilterDropdowns;

        function getDashboardFilterSuffix(tableId) {
            return tableId === 'assetTableUpdate_v3' ? '-update' : (tableId === 'assetTableManual_v3' ? '-manual' : '-new');
        }

        function getActiveDashboardTab() {
            return (document.querySelector('#dashboardTabs .nav-link.active')?.dataset.tab) || 'new';
        }

        function syncAllConfSliders(sourceTab) {
            ['new', 'update', 'manual'].forEach(function(tab) {
                if (tab === sourceTab) return;
                var el = document.getElementById('confSlider-' + tab);
                if (el && el.noUiSlider) el.noUiSlider.set([window.confRangeMin, window.confRangeMax]);
            });
        }

        function updateAllReviewLinks() {
            Object.keys(window.tables || {}).forEach(function (tableId) {
                updateReviewLinks(tableId);
            });
        }

        function updateDashboardNavLinks() {
            var rMin = Math.round(window.confRangeMin || 0);
            var rMax = Math.round(window.confRangeMax !== undefined ? window.confRangeMax : 100);
            $('.filter-card a.view-pill[href]').each(function () {
                var $link = $(this);
                var href = $link.attr('href');
                if (!href) return;

                var baseUrl = href.split('?')[0];
                var params = new URLSearchParams(href.includes('?') ? href.split('?')[1] : '');
                if (rMin !== 0 || rMax !== 100) {
                    params.set('conf_min', rMin);
                    params.set('conf_max', rMax);
                } else {
                    params.delete('conf_min');
                    params.delete('conf_max');
                }

                var query = params.toString();
                $link.attr('href', query ? baseUrl + '?' + query : baseUrl);
            });
        }

        function redrawAllAssetTables() {
            Object.keys(window.tables || {}).forEach(function (tableId) {
                window.tables[tableId].draw();
            });
        }

        function initBootstrapTooltips(scope) {
            var root = scope || document;
            var tooltipEls = [].slice.call(root.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipEls.forEach(function (el) {
                var existing = bootstrap.Tooltip.getInstance(el);
                if (existing) existing.dispose();
                new bootstrap.Tooltip(el);
            });
        }

        function initChecklistPopovers(scope) {
            var root = scope || document;
            var popoverEls = [].slice.call(root.querySelectorAll('.el-required-check-trigger'));
            popoverEls.forEach(function (el) {
                var existing = bootstrap.Popover.getInstance(el);
                if (existing) existing.dispose();

                var contentId = el.getAttribute('data-checklist-target');
                var contentEl = contentId ? document.getElementById(contentId) : null;
                new bootstrap.Popover(el, {
                    html: true,
                    trigger: 'hover focus',
                    placement: 'auto',
                    container: 'body',
                    customClass: 'el-required-popover',
                    content: contentEl ? contentEl.innerHTML : '<div class="text-muted small">No checklist available.</div>'
                });
            });
        }

        function initDashboardOverlays(scope) {
            initBootstrapTooltips(scope);
            initChecklistPopovers(scope);
        }

        function applyApprovedShadow($select) {
            // Shadow removed in new design for cleaner look, but logic kept to prevent errors
        }

        (function () {
            var initialTab = (document.querySelector('#dashboardTabs .nav-link.active')?.dataset.tab) || 'new';
            updateDashboardQuery(initialTab);
        })();

        document.addEventListener('DOMContentLoaded', function () {
            initDashboardOverlays(document);
            syncTrafficFilterDropdowns(document);

            var tabLinks = document.querySelectorAll('#dashboardTabs .nav-link');
            tabLinks.forEach(function (link) {
                link.addEventListener('shown.bs.tab', function (ev) {
                    var tabName = ev.target.dataset.tab || 'new';
                    syncTrafficFilterDropdowns(document);
                    var q = updateDashboardQuery(tabName);
                    window.history.replaceState({}, '', window.location.pathname + q);

                    try {
                        $.fn.dataTable.tables({ visible: true, api: true }).columns.adjust().responsive.recalc();
                    } catch (e) { }
                    initDashboardOverlays(document);
                });
            });
        });

        $(document).ready(function () {
            var isDistributionDashboard = {{ 'true' if page_title and 'Distribution' in page_title else 'false' }};

            // Indices (Revised after Attribute column dropped — shifted down by 1
            // for every column previously at idx 11+).
            var colQR = 0;
            var colCaptureDate = 1;
            var colBuilding = 2;
            var colTag = 5;        // UBC Asset Tag
            var colAmperage = 7;
            var colVolts = 8;
            var colLocation = 9;
            var colAssetGroup = 13; // Asset Group follows Avg AI Conf and Comp Score
            var colApproved = 15;
            var colAction = 17;
            var colCapturedBy = 18;
            var distributionHiddenColumns = [colAmperage, colVolts, colLocation];

            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                var col = colApproved;
                var search = settings.aoPreSearchCols[col].sSearch;
                if (!search) return true;
                var td = settings.aoData[dataIndex].anCells[col];
                var val = $(td).attr('data-search') || '';
                var regex = settings.aoPreSearchCols[col].bRegex ? new RegExp(search) : null;
                if (regex) return regex.test(val);
                return (val.indexOf(search) !== -1);
            });

            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                var tableId = settings.nTable && settings.nTable.id;
                if (!tableId || tableId.indexOf('assetTable') !== 0) return true;
                var rMin = window.confRangeMin || 0;
                var rMax = window.confRangeMax !== undefined ? window.confRangeMax : 100;
                if (rMin === 0 && rMax === 100) return true;
                var row = settings.aoData[dataIndex] && settings.aoData[dataIndex].nTr;
                var rawScore = row ? (row.getAttribute('data-avg-conf') || '') : '';
                var numericScore = parseFloat(rawScore);
                if (!Number.isFinite(numericScore)) return false;
                return numericScore >= rMin && numericScore <= rMax;
            });

            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                if (!settings.nTable || !/^assetTable/.test(settings.nTable.id || '')) return true;
                var suffix = getDashboardFilterSuffix(settings.nTable.id || '');
                var trafficFilter = normalizeTrafficLightFilterValue($('#filter-traffic' + suffix).val());
                if (!trafficFilter) return true;

                var row = settings.aoData[dataIndex] && settings.aoData[dataIndex].nTr;
                var trafficValue = row ? String(row.getAttribute('data-traffic-light') || '').trim().toLowerCase() : '';
                return trafficValue === trafficFilter;
            });

            function initAssetTable(tableId, buildingSelector, approvedSelector, tagSelector, groupSelector, qrSelector, trafficSelector) {
                // Assuming dateSelector ID matches tableId suffix pattern: #filter-date-new, etc.
                var dateSelector = qrSelector.replace('qr', 'date');
                var capturedBySelector = qrSelector.replace('qr', 'captured-by');
                var tabName = tableId === 'assetTableUpdate_v3' ? 'update' : (tableId === 'assetTableManual_v3' ? 'manual' : 'new');

                var columnDefs = [
                    { orderable: false, targets: [colApproved, colAction] },
                    { targets: colCapturedBy, visible: false, searchable: true }
                ];

                if (isDistributionDashboard) {
                    columnDefs.push({ targets: distributionHiddenColumns, visible: false, searchable: true });
                }

                var table = $('#' + tableId).DataTable({
                    pageLength: 15,
                    order: [],
                    stateSave: true,
                    stateDuration: -1,
                    responsive: true,
                    dom: '<"d-flex justify-content-between align-items-center"l>rt<"d-flex flex-column flex-md-row justify-content-between align-items-center p-3 border-top"ip>',
                    columnDefs: columnDefs,
                    stateLoadParams: function (settings, data) {
                        if (!isDistributionDashboard || !data || !data.columns) return;
                        distributionHiddenColumns.forEach(function (idx) {
                            if (data.columns[idx]) data.columns[idx].visible = false;
                        });
                    },
                });

                if (isDistributionDashboard) {
                    distributionHiddenColumns.forEach(function (idx) {
                        table.column(idx).visible(false, false);
                    });
                    table.columns.adjust().responsive.recalc();
                }

                var $building = $(buildingSelector);
                var $approved = $(approvedSelector);
                var $tag = $(tagSelector);
                var $group = $(groupSelector);
                var $qr = $(qrSelector);
                var $date = $(dateSelector);
                var $traffic = $(trafficSelector);
                var $capturedBy = $(capturedBySelector);
                applyApprovedShadow($approved);

                function syncDashboardHistory() {
                    if (tabName !== getActiveDashboardTab()) return '';
                    var q = updateDashboardQuery(tabName);
                    window.history.replaceState({}, '', window.location.pathname + q);
                    return q;
                }

                function applyTableFiltersFromInputs() {
                    var buildingVal = $building.val();
                    var approvedVal = $approved.val();
                    var qrVal = ($qr.val() || '').trim();
                    var tagVal = ($tag.val() || '').trim();
                    var groupVal = $group.val();
                    var dateVal = $date.val();
                    var capturedByVal = $capturedBy.val();

                    table.column(colBuilding).search(buildingVal ? '^' + $.fn.dataTable.util.escapeRegex(buildingVal) + '$' : '', true, false);
                    table.column(colApproved).search(approvedVal ? approvedVal : '', true, false);
                    table.column(colQR).search(qrVal);
                    table.column(colTag).search(tagVal);
                    table.column(colAssetGroup).search(groupVal ? '^' + $.fn.dataTable.util.escapeRegex(groupVal) + '$' : '', true, false);
                    table.column(colCaptureDate).search(dateVal || '');
                    table.column(colCapturedBy).search(capturedByVal ? '^' + $.fn.dataTable.util.escapeRegex(capturedByVal) + '$' : '', true, false);
                }

                function populateDropdowns() {
                    // Building
                    var currentB = $building.val();
                    $building.find('option:not(:first)').remove();
                    var uniquesB = {};
                    table.column(colBuilding, { search: 'applied' }).data().each(function (val) {
                        var textVal = $(val).text() || val;
                        textVal = (textVal || '').toString().trim();
                        if (textVal) uniquesB[textVal] = true;
                    });
                    Object.keys(uniquesB).sort().forEach(function (v) {
                        $building.append(new Option(v, v));
                    });
                    if (currentB && uniquesB[currentB]) $building.val(currentB);

                    // Asset Group
                    var currentG = $group.val();
                    $group.find('option:not(:first)').remove();
                    var uniquesG = {};
                    table.column(colAssetGroup, { search: 'applied' }).data().each(function (val) {
                        val = (val || '').toString().trim();
                        if (val) uniquesG[val] = true;
                    });
                    Object.keys(uniquesG).sort().forEach(function (v) {
                        $group.append(new Option(v, v));
                    });
                    if (currentG && uniquesG[currentG]) $group.val(currentG);

                    // Captured By
                    var currentCB = $capturedBy.val();
                    $capturedBy.find('option:not(:first)').remove();
                    var uniquesCB = {};
                    table.column(colCapturedBy, { search: 'applied' }).data().each(function (val) {
                        val = (val || '').toString().trim();
                        if (val) uniquesCB[val] = true;
                    });
                    Object.keys(uniquesCB).sort().forEach(function (v) {
                        $capturedBy.append(new Option(v, v));
                    });
                    if (currentCB && uniquesCB[currentCB]) $capturedBy.val(currentCB);
                }
                populateDropdowns();

                // Restore State
                var state = table.state.loaded();
                var approvedStateSearch = '';
                var params = new URLSearchParams(window.location.search || '');
                var trafficParam = normalizeTrafficLightFilterValue(params.get('traffic_light'));
                $traffic.val(trafficParam || '');
                if (state && state.columns) {
                    var bSearch = state.columns[colBuilding]?.search?.search || '';
                    if (bSearch.startsWith('^') && bSearch.endsWith('$')) {
                        bSearch = bSearch.slice(1, -1);
                        try { bSearch = $.fn.dataTable.util.unescapeRegex(bSearch); } catch (e) { }
                    }
                    if (bSearch) $building.val(bSearch);

                    var aSearch = state.columns[colApproved]?.search?.search || '';
                    approvedStateSearch = aSearch;
                    if (aSearch === '^True$') $approved.val('True');
                    else if (aSearch === '^False$') $approved.val('False');

                    var dSearch = state.columns[colCaptureDate]?.search?.search || '';
                    if (dSearch) $date.val(dSearch);

                    var qSearch = state.columns[colQR]?.search?.search || '';
                    if (qSearch) $qr.val(qSearch);

                    var tSearch = state.columns[colTag]?.search?.search || '';
                    if (tSearch) $tag.val(tSearch);

                    var gSearch = state.columns[colAssetGroup]?.search?.search || '';
                    if (gSearch.startsWith('^') && gSearch.endsWith('$')) {
