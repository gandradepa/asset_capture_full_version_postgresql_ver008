        function getVisibleQRCodes() {
            // Get QR codes from the currently active tab's table only
            var qrCodes = [];

            // Find the active tab-pane
            var activeTabPane = document.querySelector('.tab-pane.show.active');
            if (!activeTabPane) {
                // Fallback: try to find any visible table
                activeTabPane = document.querySelector('.tab-pane:not([style*="display: none"])');
            }

            if (activeTabPane) {
                // Find the table within the active tab
                var table = activeTabPane.querySelector('table');
                if (table) {
                    // Get all tbody rows and extract QR code from first cell
                    var rows = table.querySelectorAll('tbody tr');
                    rows.forEach(function (row) {
                        var firstCell = row.querySelector('td:first-child');
                        if (firstCell) {
                            // Extract text content (QR code), removing any HTML tags
                            var qr = firstCell.textContent.trim();
                            if (qr && qrCodes.indexOf(qr) === -1) {
                                qrCodes.push(qr);
                            }
                        }
                    });
                }
            }

            return qrCodes;
        }


