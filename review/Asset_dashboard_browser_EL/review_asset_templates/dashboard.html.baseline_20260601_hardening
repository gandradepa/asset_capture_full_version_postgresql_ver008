            $.ajax({
                url: '/api/user-activity',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ qr_codes: visibleQRCodes }),
                success: function (result) {
                    userActivityData = result.data || [];
                    userActivityUsers = result.users || [];

                    // Populate user dropdown
                    var userFilter = document.getElementById('ua-user-filter');
                    if (userFilter) {
                        userFilter.innerHTML = '<option value="">All Users</option>';
                        userActivityUsers.forEach(function (u) {
                            userFilter.innerHTML += '<option value="' + u + '">' + u + '</option>';
                        });
                    }

                    renderUserActivityTable();
                },
                error: function (xhr) {
                    var errMsg = 'Error loading data';
                    try {
                        var resp = xhr.responseJSON;
                        if (resp && resp.error) errMsg = resp.error;
                    } catch (e) { }
                    tableBody.innerHTML = '<tr><td colspan="4" class="text-center text-danger py-4">' + errMsg + '</td></tr>';
                }
            });
        }

        function renderUserActivityTable() {
            var tableBody = document.getElementById('ua-table-body');
            var userFilter = document.getElementById('ua-user-filter');
            var qrFilter = document.getElementById('ua-qr-filter');
            var dateFilter = document.getElementById('ua-date-filter');

            if (!tableBody) return;

            var selectedUser = userFilter ? userFilter.value : '';
            var qrSearch = qrFilter ? qrFilter.value.toLowerCase().trim() : '';
            var dateSearch = dateFilter ? (dateFilter.value || '').trim() : '';

            var filtered = userActivityData.filter(function (row) {
                if (selectedUser && row.user !== selectedUser) return false;
                if (qrSearch && row.qr_code.toLowerCase().indexOf(qrSearch) === -1) return false;
                if (dateSearch && row.date !== dateSearch) return false;
                return true;
            });

            if (filtered.length === 0) {
                tableBody.innerHTML = '<tr><td colspan="4" class="text-center text-muted py-4">No data found</td></tr>';
                return;
            }

            var html = '';
            filtered.forEach(function (row) {
                html += '<tr>' +
                    '<td class="fw-medium">' + (row.qr_code || '') + '</td>' +
                    '<td>' + (row.user || '') + '</td>' +
                    '<td>' + (row.date || '') + '</td>' +
                    '<td>' + (row.hour || '') + '</td>' +
                    '</tr>';
            });
            tableBody.innerHTML = html;
        }

        // Event listeners for User Activity view
        var userFilter = document.getElementById('ua-user-filter');
        var qrFilter = document.getElementById('ua-qr-filter');
        var dateFilter = document.getElementById('ua-date-filter');
        var resetBtn = document.getElementById('ua-reset-filters');
        var showBtn = document.getElementById('show-user-activity-btn');
        var backBtn = document.getElementById('back-to-main-btn');
        var mainContainer = document.querySelector('.container-fluid.px-4:not(#user-activity-view)');
        var userActivityView = document.getElementById('user-activity-view');
        var v2CmdBar = document.querySelector('.v2-cmd-bar');

        if (userFilter) userFilter.addEventListener('change', renderUserActivityTable);
        if (qrFilter) qrFilter.addEventListener('input', renderUserActivityTable);
        if (dateFilter) dateFilter.addEventListener('change', renderUserActivityTable);

        if (resetBtn) {
            resetBtn.addEventListener('click', function () {
                if (userFilter) userFilter.value = '';
                if (qrFilter) qrFilter.value = '';
                if (dateFilter) dateFilter.value = '';
                renderUserActivityTable();
            });
        }

        if (showBtn) {
            showBtn.addEventListener('click', function () {
                if (mainContainer) mainContainer.style.display = 'none';
                if (v2CmdBar) v2CmdBar.style.display = 'none';
                if (userActivityView) userActivityView.style.display = 'block';
                loadUserActivityData();
            });
        }

        window.exportFilteredXlsx = async function (tab) {
            var tableId = ({ new: 'assetTableNew_v3', update: 'assetTableUpdate_v3', manual: 'assetTableManual_v3' })[tab];
            var dt = window.tables && window.tables[tableId];
            if (!dt) { alert('Table not initialised yet.'); return; }
            var qrCodes = [];
            dt.rows({ search: 'applied' }).nodes().each(function (tr) {
                var v = tr.querySelector('.el-required-qr-value');
                var qr = (v ? v.textContent : (tr.cells[0] && tr.cells[0].textContent) || '').trim();
                if (qr) qrCodes.push(qr);
            });
            if (!qrCodes.length) { alert('No rows match the current filter.'); return; }
            var building = (document.getElementById('global-building-selector') || {}).value || '';
            var btn = document.querySelector('button[onclick="exportFilteredXlsx(\'' + tab + '\')"]');
            var prevHtml = btn ? btn.innerHTML : null;
            if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Exporting...'; }
            try {
                var resp = await fetch('{{ url_for("main.export_review_xlsx") }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ tab: tab, building: building, qr_codes: qrCodes })
                });
                if (!resp.ok) { alert('Export failed: HTTP ' + resp.status); return; }
                var blob = await resp.blob();
                var cd = resp.headers.get('Content-Disposition') || '';
                var match = cd.match(/filename="?([^";]+)"?/);
                var fname = match ? match[1] : 'Review_EL.xlsx';
                var url = URL.createObjectURL(blob);
                var a = document.createElement('a');
                a.href = url; a.download = fname;
                document.body.appendChild(a); a.click(); a.remove();
                URL.revokeObjectURL(url);
            } catch (err) {
                alert('Export failed: ' + err);
            } finally {
                if (btn) { btn.disabled = false; btn.innerHTML = prevHtml; }
            }
        };

        if (backBtn) {
            backBtn.addEventListener('click', function () {
                if (userActivityView) userActivityView.style.display = 'none';
                if (v2CmdBar) v2CmdBar.style.display = '';
                if (mainContainer) mainContainer.style.display = 'block';
            });
        }
    </script>

    <script>
    (function () {
        const params = new URLSearchParams(window.location.search);
        if (params.get('embedded') !== 'true') return;

        // Preserve ?embedded=true on all internal link clicks
        document.addEventListener('click', function (e) {
            const a = e.target.closest('a[href]');
            if (!a) return;
            const href = a.getAttribute('href');
            if (!href || href.startsWith('#') || href.startsWith('http') || href.startsWith('mailto')) return;
            if (href.includes('embedded=true')) return;
            a.setAttribute('href', href + (href.includes('?') ? '&' : '?') + 'embedded=true');
        });

        // Tell the parent Dashboard which EL URL we're on so a parent refresh
        // restores us to /review-distribution (or wherever) instead of falling
        // back to the iframe's data-src landing page.
        if (window.parent && window.parent !== window) {
            try {
                window.parent.postMessage({
                    type: 'review-iframe-nav',
                    iframe: 'iframe-review-el',
                    href: window.location.href
                }, '*');
            } catch (e) { /* cross-origin postMessage failed; harmless */ }
        }
    })();
    </script>

