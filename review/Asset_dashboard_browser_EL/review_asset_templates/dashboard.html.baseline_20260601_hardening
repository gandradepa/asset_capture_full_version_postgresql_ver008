                        }).fail(function (xhr) {
                            failures.push({ docId: update.docId, status: xhr.status, error: (xhr.responseJSON && xhr.responseJSON.error) || ('HTTP ' + xhr.status) });
                        }).always(function () {
                            i++;
                            processNext();
                        });
                    }

                    processNext();
                });
            });
        });

