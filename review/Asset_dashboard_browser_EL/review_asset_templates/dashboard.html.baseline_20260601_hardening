                    var params = new URLSearchParams(href.includes('?') ? href.split('?')[1] : '');

                    // Set filter parameters
                    if (filterQr) params.set('filter_qr', filterQr); else params.delete('filter_qr');
                    if (filterTag) params.set('filter_tag', filterTag); else params.delete('filter_tag');
                    if (filterGroup) params.set('filter_group', filterGroup); else params.delete('filter_group');
