def get_all_assets(building=None, include_history=False):
    conn = _connect()
    try:
        query = f'SELECT * FROM "{TABLE}"'
        conditions = []
        params = []
        if not include_history:
            conditions.append(ACTIVE_DRAW_CONDITION)
            conditions.append(_active_match_exists_sql())
        if building:
            conditions.append('"Building" = ?')
            params.append(building)
        if conditions:
            query += " WHERE " + " AND ".join(conditions)
        query += ' ORDER BY CAST("Hierarchy" AS INTEGER), "Equipment ID"'
        rows = conn.execute(query, params).fetchall()
        assets = [dict(r) for r in rows]
        return _enrich_asset_display_fields(conn, assets)
    finally:
        conn.close()


def get_buildings(include_archived=False):
    conn = _connect()
    try:
        rows = conn.execute(
            f'SELECT "Building", new_draw, COUNT(*) as asset_count, MAX(source_pdf) AS source_pdf '
            f'FROM "{TABLE}" GROUP BY "Building", new_draw ORDER BY "Building", new_draw DESC'
        ).fetchall()
        allowed = _buildings_with_displayable_qr(conn)
    finally:
        conn.close()
    buildings = {}
    for r in rows:
        b = r["Building"]
        if b not in buildings:
            buildings[b] = {"building": b, "current_count": 0, "history_count": 0, "source_pdf": ""}
        if r["new_draw"] == "TRUE":
            buildings[b]["current_count"] = r["asset_count"]
            buildings[b]["source_pdf"] = r["source_pdf"] or ""
        else:
            buildings[b]["history_count"] += r["asset_count"]
    for entry in buildings.values():
        entry["display"] = get_building_display(entry["building"])
    # Restrict to buildings that still have at least one displayable (non-archived)
    # QR code, mirroring the main review dashboard's "Hide Archive ON" default.
    # include_archived=True (or a fail-open None) returns the unfiltered list.
    result = []
    for entry in buildings.values():
        keep = (
            include_archived
            or allowed is None
            or (entry["building"] or "").strip().upper() in allowed
        )
        if keep:
            result.append(entry)
    return result


def get_building_locations(building_code):
    """Distinct Location values from Buildings_with_SpaceUID for a building Code.

    Returns [] when building_code is falsy, the view is missing, or the lookup
    fails. The Swift Over Room dropdown feeds off this list.
    """
    if not building_code:
        return []
    conn = _connect()
    try:
        rows = conn.execute(
            'SELECT DISTINCT "Location" FROM "Buildings_with_SpaceUID" '
            "WHERE \"Code\" = ? AND \"Location\" IS NOT NULL AND TRIM(\"Location\") != '' "
            'ORDER BY "Location"',
            (building_code,),
        ).fetchall()
    except qrdb.DatabaseError:
        return []
    finally:
        conn.close()
    return [r["Location"] for r in rows if r["Location"]]


def check_building_exists(building_code):
    conn = _connect()
    try:
        count = conn.execute(
            f'SELECT COUNT(*) AS n FROM "{TABLE}" WHERE "Building" = ? AND {ACTIVE_DRAW_CONDITION}',
            (building_code,),
        ).fetchone()["n"]
        return count > 0
    finally:
        conn.close()


def get_building_display(code):
    if not code:
        return ""
    code_str = str(code)
    conn = _connect()
    try:
        row = conn.execute(
            'SELECT "Name", "Owner Rep" FROM "Buildings" WHERE "Code" = ? LIMIT 1',
            (code_str,),
        ).fetchone()
    finally:
        conn.close()
    if not row:
        return code_str
    name = (row["Name"] or "").strip()
    rep = (row["Owner Rep"] or "").strip()
    if name and rep:
        return f"{name} | {rep}"
    return name or code_str


def recompute_matching_check(row_id=None, building=None):
    """Refresh matching_check from same-building UBC Asset Tag matches.

    Scope: a single row, all rows for one Building, or the entire table.
    """
    conn = _connect()
    try:
        if row_id is not None:
            where, params = "WHERE row_id = ?", (row_id,)
        elif building is not None:
            where, params = 'WHERE "Building" = ?', (building,)
        else:
            where, params = "", ()
        conn.execute(f"""
            UPDATE "{TABLE}"
            SET matching_check = CASE WHEN EXISTS (
                SELECT 1 FROM "sdi_dataset_EL" s
                WHERE TRIM(COALESCE(s."UBC Asset Tag", '')) <> ''
                  AND UPPER(TRIM(COALESCE(s."Building", ''))) = UPPER(TRIM(COALESCE("{TABLE}"."Building", '')))
                  AND UPPER(TRIM(COALESCE(s."UBC Asset Tag", ''))) = UPPER(TRIM(COALESCE("{TABLE}"."Equipment ID", '')))
            ) THEN 1 ELSE 0 END
            {where}
        """, params)
        conn.commit()
    finally:
        conn.close()


def get_missed_assets(building=None):
    conn = _connect()
    try:
        query = f'''
            SELECT row_id, "Building", "Equipment ID", "Supply From"
            FROM "{TABLE}"
            WHERE {ACTIVE_DRAW_CONDITION}
              AND NOT {_active_match_exists_sql()}
        '''
        params = []
        if building:
            query += ' AND "Building" = ?'
            params.append(building)
        query += ' ORDER BY CAST("Hierarchy" AS INTEGER), "Equipment ID"'
        rows = conn.execute(query, params).fetchall()
        missed = []
        for row in rows:
            item = dict(row)
            item["Group of Asset"] = _derive_group_of_asset(item.get("Equipment ID"))
            missed.append(item)
        return missed
    finally:
        conn.close()


def get_sdi_not_in_sld_assets(building=None):
    """SDI rows (distribution category) for this building with no active SLD match.

    Inverse of get_missed_assets: reads sdi_dataset_EL as the base table and
    excludes rows whose UBC Asset Tag appears as an active Equipment ID in the
    SLD for the same building.
    """
    if not building:
        return []
    conn = _connect()
    try:
        sdi_columns = _table_columns(conn, "sdi_dataset_EL")
        if not sdi_columns:
            return []

        select_parts = [
            's."UBC Asset Tag" AS "UBC Asset Tag"',
            's."Building" AS "Building"',
            's."Supply From" AS "Supply From"',
            's."Asset Group" AS "Asset Group"',
        ]
        optional = [
            "QR Code", "Description",
            "Voltage Rating", "Voltage Rating (UoM)",
            "Amperage Rating", "Amperage Rating (UoM)",
            "Power Rating", "Power Rating (UoM)",
            "Approved",
        ]
        for col in optional:
            if col in sdi_columns:
                select_parts.append(f's."{col}" AS "{col}"')

        placeholders = ",".join("?" for _ in DISTRIBUTION_ASSET_GROUPS)
        approved_filter = ""
        if "Approved" in sdi_columns:
            approved_filter = 'AND TRIM(COALESCE(s."Approved", \'\')) <> \'1\''
        query = f'''
            SELECT {", ".join(select_parts)}
            FROM "sdi_dataset_EL" s
            WHERE TRIM(COALESCE(s."UBC Asset Tag", '')) <> ''
              AND UPPER(TRIM(COALESCE(s."Building", ''))) = UPPER(TRIM(COALESCE(?, '')))
              AND s."Asset Group" IN ({placeholders})
              {approved_filter}
              AND NOT EXISTS (
                  SELECT 1 FROM "{TABLE}" e
                  WHERE e.new_draw = 'TRUE'
                    AND UPPER(TRIM(COALESCE(e."Building", ''))) = UPPER(TRIM(COALESCE(s."Building", '')))
                    AND UPPER(TRIM(COALESCE(e."Equipment ID", ''))) = UPPER(TRIM(COALESCE(s."UBC Asset Tag", '')))
              )
            ORDER BY s."Asset Group", s."UBC Asset Tag"
        '''
        params = [building, *DISTRIBUTION_ASSET_GROUPS]
        rows = conn.execute(query, params).fetchall()
        return [dict(r) for r in rows]
    finally:
        conn.close()


def archive_missed_assets(row_ids, building=None):
    clean_ids = []
    seen = set()
    for row_id in row_ids or []:
        try:
            value = int(row_id)
        except (TypeError, ValueError):
            continue
        if value not in seen:
            clean_ids.append(value)
            seen.add(value)

    if not clean_ids:
        return False, "No valid row IDs supplied", []

    placeholders = ",".join("?" for _ in clean_ids)
    params = list(clean_ids)
    query = f'''
        SELECT row_id, "Building", "Equipment ID", "Supply From"
        FROM "{TABLE}"
        WHERE row_id IN ({placeholders})
          AND {ACTIVE_DRAW_CONDITION}
          AND NOT {_active_match_exists_sql()}
    '''
    if building:
        query += ' AND "Building" = ?'
        params.append(building)

    conn = _connect()
    archived_ids = []
    try:
        rows = conn.execute(query, params).fetchall()
        if not rows:
            return False, "No missed active assets found for exclusion", []

        for row in rows:
            tag = row["Equipment ID"] or ""
            parent = row["Supply From"] or ""
            row_building = row["Building"] or ""
            conn.execute(
                f'''
                UPDATE "{TABLE}"
                SET "Supply From" = ?
                WHERE "Building" = ?
                  AND {ACTIVE_DRAW_CONDITION}
                  AND "Supply From" = ?
                ''',
                (parent, row_building, tag),
            )
            conn.execute(
                f"UPDATE \"{TABLE}\" SET new_draw = 'FALSE' WHERE row_id = ?",
                (row["row_id"],),
            )
