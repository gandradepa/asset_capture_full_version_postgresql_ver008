def swift_save_asset(row_id, updates, cascade=False):
    """Save an inline edit from the Swift Over form.

    Keeps three stores in sync when the row has a matched SDI asset:
      - electrical_building_schema  (always updated)
      - sdi_dataset_EL              (updated via _sync_db_from_structured)
      - Output_jason_api/*.json     (updated atomically)

    Returns (status_code, response_dict).

    Rename cascade: if the user changes Equipment ID and other rows reference
    the old tag as their Supply From, the first call returns 409 with
    needs_confirmation + children. Re-posting with cascade=True updates all
    three stores for the parent and for each affected child.
    """
    # Lazy imports to avoid circular dependency: Asset_dashboard_EL imports
    # this blueprint at module load time.
    try:
        from Asset_dashboard_EL import (
            JSON_DIR,
            PROCESSED_JSON_LOG_EL,
            json_sync_lock,
            _apply_el_supply_from_formatting,
            _sync_db_from_structured,
        )
    except Exception as e:  # noqa: BLE001
        return 500, {"error": f"Server misconfigured: cannot load sync helpers ({e})"}

    # 1. Load current SLD row
    conn = _connect()
    try:
        row = conn.execute(
            f'SELECT * FROM "{TABLE}" WHERE row_id = ?', (row_id,)
        ).fetchone()
        if not row:
            return 404, {"error": "Asset not found"}
        current = dict(row)
        latest_row = _enrich_asset_display_fields(conn, [dict(row)])[0]
        submitted_revision = str(updates.pop("swift_revision", "") or "").strip()
        current_revision = compute_swift_revision(latest_row)
        if not submitted_revision or submitted_revision != current_revision:
            return 409, {
                "stale_revision": True,
                "error": "This row changed since you loaded it. Review the latest values and save again.",
                "row": latest_row,
            }
        building = str(current.get("Building") or "").strip()
        old_tag = str(current.get("Equipment ID") or "").strip()
        new_tag = str(updates.get("Equipment ID", old_tag) or "").strip()
        if not new_tag:
            return 400, {"error": "Equipment ID cannot be empty"}

        new_supply = _apply_el_supply_from_formatting(
            updates.get("Supply From", current.get("Supply From", ""))
        )
        rename = (new_tag.upper() != old_tag.upper())

        # Reject rename that collides with an existing active row
        if rename:
            collision = conn.execute(
                f'''
                SELECT row_id FROM "{TABLE}"
                WHERE {ACTIVE_DRAW_CONDITION}
                  AND "Building" = ? AND UPPER("Equipment ID") = UPPER(?)
                  AND row_id != ?
                LIMIT 1
                ''',
                (building, new_tag, row_id),
            ).fetchone()
            if collision:
                return 409, {"error": f'"{new_tag}" already exists in this building.'}

        # Detect children pointing at the old tag
        children = []
        if rename:
            children = get_supply_from_children(
                conn, building, old_tag, exclude_row_id=row_id
            )
        if rename and children and not cascade:
            return 409, {
                "needs_confirmation": True,
                "children": children,
                "message": (
                    f'"{old_tag}" is currently Fed From for {len(children)} '
                    f'child asset(s). Rename and update their Fed From too?'
                ),
            }

        # Find matching SDI row for main (pre-rename key is old_tag)
        sdi_row = _find_sdi_row(conn, building, old_tag)
    finally:
        conn.close()

    matched_qr = (str(sdi_row.get("QR Code")).strip() if sdi_row else "") or ""

    # Extract edited values for SLD update
    def _pick(key, default=""):
        val = updates.get(key, default)
        return "" if val is None else str(val).strip()

    new_voltage = _pick("Voltage Rating", current.get("Voltage Rating", ""))
    new_voltage_uom = _pick("Voltage Rating (UoM)", current.get("Voltage Rating (UoM)", ""))
    new_amperage = _pick("Amperage Rating", current.get("Amperage Rating", ""))
    new_amperage_uom = _pick("Amperage Rating (UoM)", current.get("Amperage Rating (UoM)", ""))
    new_power = _pick("Power Rating", current.get("Power Rating", ""))
    new_power_uom = _pick("Power Rating (UoM)", current.get("Power Rating (UoM)", ""))
    new_wire = _pick("Wire Rating", current.get("Wire Rating", ""))
    new_wire_uom = _pick("Wire Rating (UoM)", current.get("Wire Rating (UoM)", ""))
    new_room = updates.get("Room")  # may be None (unmatched) or string

    # 2. Update electrical_building_schema (single local transaction).
    # ID_check is a generated VIRTUAL column derived from Building / Equipment ID
    # / Supply From, so it tracks edits to those fields automatically.
    backup_sld = {
        "Equipment ID": current.get("Equipment ID", ""),
        "Supply From": current.get("Supply From", ""),
        "Voltage Rating": current.get("Voltage Rating", ""),
        "Voltage Rating (UoM)": current.get("Voltage Rating (UoM)", ""),
        "Amperage Rating": current.get("Amperage Rating", ""),
        "Amperage Rating (UoM)": current.get("Amperage Rating (UoM)", ""),
        "Power Rating": current.get("Power Rating", ""),
        "Power Rating (UoM)": current.get("Power Rating (UoM)", ""),
        "Wire Rating": current.get("Wire Rating", ""),
        "Wire Rating (UoM)": current.get("Wire Rating (UoM)", ""),
    }
    conn = _connect()
    try:
        conn.execute("BEGIN")
        conn.execute(
            f'UPDATE "{TABLE}" SET '
            f'"Equipment ID" = ?, "Supply From" = ?, '
            f'"Voltage Rating" = ?, "Voltage Rating (UoM)" = ?, '
            f'"Amperage Rating" = ?, "Amperage Rating (UoM)" = ?, '
            f'"Power Rating" = ?, "Power Rating (UoM)" = ?, '
            f'"Wire Rating" = ?, "Wire Rating (UoM)" = ? '
            f'WHERE row_id = ?',
            (
                new_tag, new_supply,
                new_voltage, new_voltage_uom,
                new_amperage, new_amperage_uom,
                new_power, new_power_uom,
                new_wire, new_wire_uom,
                row_id,
            ),
        )
        if rename and cascade and children:
            conn.execute(
                f'UPDATE "{TABLE}" SET "Supply From" = ? '
                f'WHERE "Building" = ? AND UPPER(COALESCE("Supply From", \'\')) = UPPER(?) '
                f'AND row_id != ?',
                (new_tag, building, old_tag, row_id),
            )
        conn.commit()
    except Exception as e:  # noqa: BLE001
        conn.rollback()
        conn.close()
        return 500, {"error": f"Failed to update diagram row: {e}"}
    finally:
        conn.close()

    def _rollback_sld():
        try:
            c = _connect()
            try:
                c.execute(
                    f'UPDATE "{TABLE}" SET '
                    f'"Equipment ID" = ?, "Supply From" = ?, '
                    f'"Voltage Rating" = ?, "Voltage Rating (UoM)" = ?, '
                    f'"Amperage Rating" = ?, "Amperage Rating (UoM)" = ?, '
                    f'"Power Rating" = ?, "Power Rating (UoM)" = ?, '
                    f'"Wire Rating" = ?, "Wire Rating (UoM)" = ? '
                    f'WHERE row_id = ?',
                    (
                        backup_sld["Equipment ID"], backup_sld["Supply From"],
                        backup_sld["Voltage Rating"], backup_sld["Voltage Rating (UoM)"],
                        backup_sld["Amperage Rating"], backup_sld["Amperage Rating (UoM)"],
                        backup_sld["Power Rating"], backup_sld["Power Rating (UoM)"],
                        backup_sld["Wire Rating"], backup_sld["Wire Rating (UoM)"],
                        row_id,
                    ),
                )
                if rename and cascade and children:
                    c.execute(
                        f'UPDATE "{TABLE}" SET "Supply From" = ? '
                        f'WHERE "Building" = ? AND UPPER(COALESCE("Supply From", \'\')) = UPPER(?) '
                        f'AND row_id != ?',
                        (old_tag, building, new_tag, row_id),
                    )
                c.commit()
            finally:
                c.close()
        except Exception as exc:  # noqa: BLE001
            current_app.logger.error("[sld swift-save] SLD rollback failed: %s", exc)

    # 2b. If Room changed and we have a matched QR, write QR_codes.Location.
    # QR_codes is the master location store — its Location triggers cascade to
    # Space / Floor / Space Details / Floor Code automatically.
    qr_location_backup = None  # (qr, old_location) for rollback
    qr_location_written = False
    if matched_qr and new_room is not None:
        desired_room = str(new_room).strip()
        c = _connect()
        try:
            current_loc = _get_qr_codes_location(c, matched_qr)
            if current_loc is None or (current_loc or "") != desired_room:
                qr_location_backup = (matched_qr, current_loc if current_loc is not None else "")
                try:
                    updated = _set_qr_codes_location(c, matched_qr, desired_room)
                    c.commit()
                    qr_location_written = bool(updated)
                    if not qr_location_written:
                        # QR row missing — don't treat as hard failure; fall through
                        # so sdi_dataset_EL and JSON still get the Room update.
                        qr_location_backup = None
                except Exception as e:  # noqa: BLE001
                    c.rollback()
                    c.close()
                    _rollback_sld()
                    return 500, {"error": f"Failed to update QR_codes.Location: {e}"}
        finally:
            c.close()

    def _rollback_qr_location():
        if not qr_location_written or qr_location_backup is None:
            return
        try:
            c = _connect()
            try:
                _set_qr_codes_location(c, qr_location_backup[0], qr_location_backup[1])
                c.commit()
            finally:
                c.close()
        except Exception as exc:  # noqa: BLE001
            current_app.logger.error(
                "[sld swift-save] QR_codes.Location rollback failed: %s", exc,
            )

    # 3. If main row has a matched SDI asset, sync JSON + sdi_dataset_EL
    json_backups = []  # list of (path, content-or-None) for rollback
    children_updated = []
    children_failed = []

    # SDI columns that the inline editor must NOT modify. Equipment ID and
    # Supply From (its UBC Asset Tag mirror too) are the identity/parent keys
    # that participate in the composite ID_check match. Per product decision
    # the inline editor edits only electrical_building_schema + the JSON file
    # for those keys; sdi_dataset_EL is left untouched so the Check Mark can
    # flip red when the two sides diverge.
    SDI_PROTECTED_KEYS = ("UBC Asset Tag", "Equipment ID", "Supply From")

    def _sync_matched_row(qr, structured_patch, asset_type="EL",
                          sync_sdi=True, sdi_preserve=None):
        """Write merged JSON; optionally sync sdi_dataset_EL.

        sync_sdi=False → write JSON only (caller wants SDI untouched).
        sdi_preserve → dict of field→value overrides applied to the payload
            sent to _sync_db_from_structured. Use this to pin the SDI
            identity/parent keys to their current values so they survive the
            sync even though the JSON reflects the new edits.
        Appends a (path, original) entry to json_backups for rollback."""
        doc_id = f"{qr}_EL_{building}"
        json_path = os.path.join(JSON_DIR, f"{doc_id}.json")
        if not os.path.isfile(json_path):
            raise FileNotFoundError(f"JSON not found for QR {qr}: {json_path}")
        with open(json_path, "r", encoding="utf-8") as f:
            original = json.load(f)
        json_backups.append((json_path, original))
        merged = json.loads(json.dumps(original))
        structured = merged.setdefault("structured_data", {})
        for k, v in structured_patch.items():
            if v is not None:
                structured[k] = v
        merged["modified"] = True
        atomic_write_json(json_path, merged)
        if not sync_sdi:
            return
        sdi_payload = dict(structured)
        if sdi_preserve:
            for k, v in sdi_preserve.items():
                sdi_payload[k] = "" if v is None else v
        avg = None
        try:
            avg_val = merged.get("Avg_ai_conf") or merged.get("avg_ai_conf")
            if avg_val not in (None, ""):
                avg = float(avg_val)
        except Exception:
            avg = None
        _sync_db_from_structured(qr, building, sdi_payload, asset_type=asset_type, avg_ai_conf=avg)

    def _preserve_from_sdi(sdi_dict):
        # Only pin keys the sdi row actually has values for. Preserving an
        # empty string here entrenches a prior wipe: the merged JSON's real
        # UBC Asset Tag / Equipment ID / Supply From would then be overridden
        # with "" during _sync_db_from_structured, leaving identity fields
        # blank forever. If sdi has nothing for a protected key, let the
        # merged JSON's value flow through untouched.
        if not sdi_dict:
            return None
        out = {}
        for k in SDI_PROTECTED_KEYS:
            v = (sdi_dict.get(k) or "")
            if isinstance(v, str):
                v = v.strip()
            if v:
                out[k] = v
        return out or None

    # Hold json_sync_lock for the whole JSON-write + log-update window so the
    # before_request watcher (sync_json_directory_to_db_el) cannot race in
    # between our write and our "already processed" marker. The watcher uses
    # acquire(blocking=False), so concurrent calls will simply no-op.
    json_sync_lock.acquire()
    try:
        try:
            if matched_qr:
                main_patch = {
                    "UBC Asset Tag": new_tag,
                    "Equipment ID": new_tag,
                    "Supply From": new_supply,
                    "Voltage Rating": new_voltage,
                    "Voltage Rating (UoM)": new_voltage_uom,
                    "Amperage Rating": new_amperage,
                    "Amperage Rating (UoM)": new_amperage_uom,
                    "Power Rating": new_power,
                    "Power Rating (UoM)": new_power_uom,
                    "Wire Rating": new_wire,
                    "Wire Rating (UoM)": new_wire_uom,
                }
                if new_room is not None:
                    main_patch["Location"] = str(new_room).strip()
                _sync_matched_row(
                    matched_qr, main_patch, asset_type="EL",
                    sdi_preserve=_preserve_from_sdi(sdi_row),
                )

            if rename and cascade and children:
                for child in children:
                    child_qr = child.get("qr_code") or ""
                    if not child_qr:
                        # Unmatched children only need the SLD update (already done)
                        children_updated.append({
                            "row_id": child["row_id"],
                            "Equipment ID": child["Equipment ID"],
                            "json_synced": False,
                        })
                        continue
                    try:
                        # Supply From is a protected SDI key — the child's JSON gets
                        # the new parent tag, but sdi_dataset_EL is NOT touched.
                        _sync_matched_row(
                            child_qr,
                            {"Supply From": new_tag},
                            asset_type="EL",
                            sync_sdi=False,
                        )
                        children_updated.append({
                            "row_id": child["row_id"],
                            "Equipment ID": child["Equipment ID"],
                            "json_synced": True,
                        })
                    except Exception as exc:  # noqa: BLE001
                        children_failed.append({
                            "row_id": child["row_id"],
                            "Equipment ID": child["Equipment ID"],
                            "error": str(exc),
                        })
        except Exception as e:  # noqa: BLE001
            # Best-effort rollback: restore all JSON backups in reverse order.
            # _sync_db_from_structured already committed for any row that got past
            # step 3; we cannot undo those, but we can re-sync with backup
            # structured_data so the DB matches the restored JSON.
            for path, backup in reversed(json_backups):
                try:
                    if backup is None:
                        if os.path.isfile(path):
                            os.remove(path)
                        continue
                    atomic_write_json(path, backup)
                    # Re-sync SDI with backup structured_data
                    try:
                        m = re.match(r"^([^_]+)_EL_([^_]+)\.json$", os.path.basename(path))
                        if m:
                            r_qr, r_building = m.group(1), m.group(2)
                            r_struct = backup.get("structured_data", {}) or {}
                            _sync_db_from_structured(
                                r_qr, r_building, r_struct,
                                asset_type=backup.get("asset_type") or "EL",
                                avg_ai_conf=backup.get("Avg_ai_conf"),
                            )
                    except Exception as exc:  # noqa: BLE001
                        current_app.logger.error(
                            "[sld swift-save] SDI rollback failed for %s: %s", path, exc,
                        )
                except Exception as exc:  # noqa: BLE001
                    current_app.logger.error(
                        "[sld swift-save] JSON rollback failed for %s: %s", path, exc,
                    )
            # Even on rollback, record the (now-restored) JSON mtimes as
            # processed so the watcher doesn't re-run _sync_db_from_structured
            # on the restored content — we already did that ourselves above.
            try:
                mark_json_processed(
                    PROCESSED_JSON_LOG_EL,
                    file_paths=[p for (p, _) in json_backups],
                )
            except Exception as exc:  # noqa: BLE001
                current_app.logger.warning(
                    "[sld swift-save] processed log update failed: %s", exc,
                )
            _rollback_qr_location()
            _rollback_sld()
            return 500, {"error": f"Failed to sync captured asset: {e}"}

        # Success: pin the just-written JSON mtimes in processed_json_el.log
        # so the before_request watcher does NOT re-sync SDI from them.
        try:
            mark_json_processed(
                PROCESSED_JSON_LOG_EL,
                file_paths=[p for (p, _) in json_backups],
            )
        except Exception as exc:  # noqa: BLE001
            current_app.logger.warning(
                "[sld swift-save] processed log update failed: %s", exc,
            )
    finally:
        json_sync_lock.release()

    # 4. Recompute matching_check
    try:
        recompute_matching_check(building=building)
    except Exception as exc:  # noqa: BLE001
        current_app.logger.warning("[sld swift-save] matching_check refresh failed: %s", exc)

    # 5. Re-read enriched row
    updated_assets = get_all_assets(building=building)
    updated_row = next((a for a in updated_assets if a.get("row_id") == row_id), None)

    payload = {
        "status": "ok",
        "row": updated_row,
        "children_updated": children_updated,
    }
    if children_failed:
        payload["children_failed"] = children_failed

    # Best-effort human_correction capture: diff the swift-save submission
    # against the AI baseline (sld_ai_extract_payload) for the fields that
    # the inline editor lets the user touch.
    try:
        _emit_human_corrections_for_row(
            row_id=row_id,
            current_row=current,
            submitted_updates=updates,
            fields=[
                "Equipment ID", "Supply From", "Hierarchy", "ambigous",
                "Amperage Rating", "Amperage Rating (UoM)",
                "Power Rating", "Power Rating (UoM)",
                "Wire Rating", "Wire Rating (UoM)",
                "Voltage Rating", "Voltage Rating (UoM)",
            ],
            description="POST /sld/api/assets/<row_id>/swift-save",
        )
    except Exception:
        pass
    return 200, payload


_RECONCILE_CHOICES = ("sld", "sdi", "custom")


def reconcile_asset(row_id, choice, value=None, reason=""):
    """Reconcile a Supply From divergence between electrical_building_schema
    (SLD diagram) and sdi_dataset_EL (captured asset) for one active SLD row.

    choice = 'sld'    -> push SLD's current Supply From to SDI + JSON.
    choice = 'sdi'    -> push SDI's current Supply From to SLD.
    choice = 'custom' -> write the supplied value to both sides + JSON.

    Both sides record an audit_trail row. The generated ID_check on each
    table tracks the new Supply From automatically.
    """
    try:
        from Asset_dashboard_EL import (
            JSON_DIR,
            PROCESSED_JSON_LOG_EL,
            json_sync_lock,
            _apply_el_supply_from_formatting,
            _sync_db_from_structured,
        )
    except Exception as e:  # noqa: BLE001
        return 500, {"error": f"Server misconfigured: cannot load sync helpers ({e})"}

    choice = (choice or "").strip().lower()
    if choice not in _RECONCILE_CHOICES:
        return 400, {"error": f"choice must be one of {_RECONCILE_CHOICES}"}
    reason = str(reason or "").strip()

    conn = _connect()
    try:
        sld_row = conn.execute(
            f'SELECT * FROM "{TABLE}" WHERE row_id = ? AND {ACTIVE_DRAW_CONDITION}',
            (row_id,),
        ).fetchone()
        if not sld_row:
            return 404, {"error": "Active SLD row not found"}
        sld = dict(sld_row)
        building = str(sld.get("Building") or "").strip()
        equipment_id = str(sld.get("Equipment ID") or "").strip()
        sdi = _find_sdi_row(conn, building, equipment_id)
    finally:
        conn.close()

    sld_supply = str(sld.get("Supply From") or "")
    sdi_supply = str(sdi.get("Supply From") or "") if sdi else None

    if choice == "sld":
        target_raw = sld_supply
    elif choice == "sdi":
        if sdi is None:
            return 400, {"error": "No matching sdi_dataset_EL row — choice 'sdi' has nothing to copy"}
        target_raw = sdi_supply or ""
    else:  # custom
        if value is None:
            return 400, {"error": "choice='custom' requires a value"}
        target_raw = str(value)

    target = _apply_el_supply_from_formatting(target_raw)
    sld_changed = (sld_supply or "") != target
    sdi_changed = sdi is not None and (sdi_supply or "") != target

    if not sld_changed and not sdi_changed:
        return 200, {
            "status": "noop",
            "message": "Both sides already agree on Supply From",
            "target": target,
        }

    matched_qr = (str(sdi.get("QR Code")).strip() if sdi else "") or ""
    description = f"reconcile:{choice}" + (f" reason={reason}" if reason else "")

    sld_rollback_value = sld_supply if sld_changed else None
    json_backup = None  # (path, original_dict) for SDI/JSON rollback

    if sdi_changed and not matched_qr:
        # No QR ⇒ no JSON file ⇒ can't safely sync SDI through the standard
        # pipeline. Refuse rather than write a half-updated row.
        return 400, {
            "error": "Matching sdi_dataset_EL row has no QR Code; cannot reconcile SDI side automatically.",
        }

    json_sync_lock.acquire()
    try:
        if sld_changed:
            conn = _connect()
            try:
                conn.execute(
                    f'UPDATE "{TABLE}" SET "Supply From" = ? WHERE row_id = ?',
                    (target, row_id),
                )
                if _audit_log_change:
                    try:
                        _audit_log_change(
                            conn,
                            qr_code=matched_qr or None,
                            app_name="reviewer_el",
                            table_name=TABLE,
                            record_pk=row_id,
                            op_type="UPDATE",
                            field_changes={"Supply From": (sld_supply, target)},
                            source="human",
                            description=description,
                        )
                    except Exception as exc:  # noqa: BLE001
                        print(f"[audit] reconcile SLD audit failed: {exc}")
                conn.commit()
            except Exception as e:  # noqa: BLE001
                conn.rollback()
                conn.close()
                return 500, {"error": f"Failed to update SLD Supply From: {e}"}
            finally:
                try:
                    conn.close()
                except Exception:
                    pass

        if sdi_changed:
            doc_id = f"{matched_qr}_EL_{building}"
            json_path = os.path.join(JSON_DIR, f"{doc_id}.json")
            try:
                if not os.path.isfile(json_path):
                    raise FileNotFoundError(f"JSON not found for QR {matched_qr}: {json_path}")
                with open(json_path, "r", encoding="utf-8") as f:
                    original = json.load(f)
                json_backup = (json_path, original)
                merged = json.loads(json.dumps(original))
                structured = merged.setdefault("structured_data", {})
                structured["Supply From"] = target
                merged["modified"] = True
                atomic_write_json(json_path, merged)
                avg = None
                try:
                    avg_val = merged.get("Avg_ai_conf") or merged.get("avg_ai_conf")
                    if avg_val not in (None, ""):
                        avg = float(avg_val)
                except Exception:
                    avg = None
                _sync_db_from_structured(
                    matched_qr, building, dict(structured),
                    asset_type=merged.get("asset_type") or "EL",
                    avg_ai_conf=avg,
                )

                if _audit_log_change:
                    sdi_conn = _connect()
                    try:
                        _audit_log_change(
                            sdi_conn,
                            qr_code=matched_qr,
                            app_name="reviewer_el",
                            table_name="sdi_dataset_EL",
                            record_pk=matched_qr,
                            op_type="UPDATE",
                            field_changes={"Supply From": (sdi_supply or "", target)},
                            source="human",
                            description=description,
                        )
                        sdi_conn.commit()
                    except Exception as exc:  # noqa: BLE001
                        print(f"[audit] reconcile SDI audit failed: {exc}")
                    finally:
                        sdi_conn.close()
            except Exception as e:  # noqa: BLE001
                # Rollback SLD if we already wrote it, and restore the JSON.
                if json_backup is not None:
                    try:
                        atomic_write_json(json_backup[0], json_backup[1])
                        # Re-sync SDI with the original structured_data
                        try:
                            r_struct = (json_backup[1] or {}).get("structured_data", {}) or {}
                            _sync_db_from_structured(
                                matched_qr, building, dict(r_struct),
                                asset_type=(json_backup[1] or {}).get("asset_type") or "EL",
                                avg_ai_conf=(json_backup[1] or {}).get("Avg_ai_conf"),
                            )
                        except Exception:
                            pass
                    except Exception:
                        pass
                if sld_rollback_value is not None:
                    try:
                        c = _connect()
                        try:
                            c.execute(
                                f'UPDATE "{TABLE}" SET "Supply From" = ? WHERE row_id = ?',
                                (sld_rollback_value, row_id),
                            )
                            c.commit()
                        finally:
                            c.close()
                    except Exception as exc:  # noqa: BLE001
                        current_app.logger.error(
                            "[sld reconcile] SLD rollback failed: %s", exc,
                        )
                return 500, {"error": f"Failed to sync captured asset: {e}"}

            try:
                mark_json_processed(PROCESSED_JSON_LOG_EL, file_paths=[json_path])
            except Exception as exc:  # noqa: BLE001
                current_app.logger.warning(
                    "[sld reconcile] processed log update failed: %s", exc,
                )
    finally:
        json_sync_lock.release()

    try:
        recompute_matching_check(building=building)
    except Exception as exc:  # noqa: BLE001
        current_app.logger.warning("[sld reconcile] matching_check refresh failed: %s", exc)

    updated_assets = get_all_assets(building=building)
    updated_row = next((a for a in updated_assets if a.get("row_id") == row_id), None)
    return 200, {
        "status": "ok",
        "target": target,
        "sld_changed": sld_changed,
        "sdi_changed": sdi_changed,
        "row": updated_row,
    }


def delete_asset(row_id):
    conn = _connect()
    try:
        full_row = conn.execute(
            f'SELECT * FROM "{TABLE}" WHERE row_id = ?',
            (row_id,),
        ).fetchone()
        if not full_row:
            return False, "Asset not found"
        before_row = dict(full_row)
        tag = before_row.get("Equipment ID")
        parent = before_row.get("Supply From")
        conn.execute(
            f'UPDATE "{TABLE}" SET "Supply From" = ? WHERE "Supply From" = ?',
            (parent, tag),
        )
        conn.execute(f'DELETE FROM "{TABLE}" WHERE row_id = ?', (row_id,))
        if _audit_log_change:
            try:
                _audit_log_change(
                    conn,
                    qr_code=before_row.get("QR Code"),
                    app_name="reviewer_el",
                    table_name=TABLE,
                    record_pk=row_id,
                    op_type="DELETE",
                    field_changes={
                        k: (v, None) for k, v in before_row.items() if v not in (None, "")
                    },
                    source="human",
                    description="DELETE /sld/api/assets",
                )
            except Exception as exc:
                print(f"[audit] EL delete_asset audit failed: {exc}")
        conn.commit()
        return True, "OK"
    finally:
        conn.close()


def backup_all_rows():
    conn = _connect()
    try:
        rows = conn.execute(f'SELECT * FROM "{TABLE}"').fetchall()
        return [dict(r) for r in rows]
    finally:
        conn.close()


def _insert_rows_into_schema(rows, new_draw_value):
    """Re-insert previously-backed-up rows into electrical_building_schema
    with the given ``new_draw`` value.

    Both ``restore_archived_rows`` (state="FALSE") and
    ``restore_active_rows`` (state="TRUE") delegate here. Centralizing the
    INSERT means schema migrations (e.g. the ``sld_extract_run_id`` /
    ``sld_ai_extract_payload`` columns added in [SLD-005]) are handled in
    one place and both call sites stay in sync.
    """
    if not rows:
        return
    conn = _connect()
    try:
        cols = _table_columns(conn, TABLE)
        has_run_id_col = "sld_extract_run_id" in cols
        has_payload_col = "sld_ai_extract_payload" in cols
        has_wire_col = "Wire Rating" in cols and "Wire Rating (UoM)" in cols
        base_cols = [
            '"Hierarchy"', '"Supply From"', '"Equipment ID"', '"Building"',
            '"Amperage Rating"', '"Amperage Rating (UoM)"',
            '"Power Rating"', '"Power Rating (UoM)"',
            '"Voltage Rating"', '"Voltage Rating (UoM)"',
            'ambigous', 'new_draw', 'source_pdf', 'created_at',
        ]
        if has_wire_col:
            base_cols.append('"Wire Rating"')
            base_cols.append('"Wire Rating (UoM)"')
        if has_run_id_col:
            base_cols.append('sld_extract_run_id')
        if has_payload_col:
            base_cols.append('sld_ai_extract_payload')
        placeholders = ", ".join(["?"] * len(base_cols))
        for row in rows:
            params = [
                row["Hierarchy"],
                row["Supply From"],
                row["Equipment ID"],
                row["Building"],
                row.get("Amperage Rating", ""),
                row.get("Amperage Rating (UoM)", ""),
                row.get("Power Rating", ""),
                row.get("Power Rating (UoM)", ""),
                row.get("Voltage Rating", ""),
                row.get("Voltage Rating (UoM)", ""),
                row.get("ambigous", ""),
                new_draw_value,
                row.get("source_pdf", ""),
                row.get("created_at", ""),
            ]
            if has_wire_col:
                params.append(row.get("Wire Rating", "") or "")
                params.append(row.get("Wire Rating (UoM)", "") or "")
            if has_run_id_col:
                params.append(row.get("sld_extract_run_id", "") or "")
            if has_payload_col:
                params.append(row.get("sld_ai_extract_payload", "") or "")
            conn.execute(
                f'INSERT INTO "{TABLE}" ({", ".join(base_cols)}) '
                f'VALUES ({placeholders})',
                params,
            )
        conn.commit()
    finally:
        conn.close()


def restore_archived_rows(archived_rows):
    """Re-insert rows with ``new_draw='FALSE'`` (i.e. into the archive).
    Used for rows that were already archived AND for the prior active set
    of a building that's being re-extracted (those rows are superseded)."""
    _insert_rows_into_schema(archived_rows, "FALSE")


def restore_active_rows(active_rows):
    """Re-insert rows preserving their active state (``new_draw='TRUE'``).
    Used for OTHER buildings' active rows that the table-drop step would
    otherwise wipe — they have nothing to do with the building being
    extracted and must remain active afterward."""
    _insert_rows_into_schema(active_rows, "TRUE")


def mark_new_rows_and_source(building_code, pdf_filename):
    conn = _connect()
    try:
        now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        conn.execute(
            f"UPDATE \"{TABLE}\" SET new_draw = 'TRUE', source_pdf = ?, created_at = ? "
            f"WHERE \"Building\" = ? AND (new_draw IS NULL OR new_draw = '')",
            (pdf_filename, now, building_code),
        )
        conn.commit()
    finally:
        conn.close()


def validate_pdf_filename(filename):
    if not filename.lower().endswith(".pdf"):
        return False, "File must be a PDF (.pdf)"
    return True, ""


