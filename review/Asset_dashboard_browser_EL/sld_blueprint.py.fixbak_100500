_PHOTO_INDEX_RE = re.compile(r"-\s*(\d+)\s*$")


def _find_photos_for_qr(qr_code, discipline="EL"):
    """Return all captured photos for ``qr_code`` sorted by trailing index.

    Filenames follow ``<QR> <Building> <Discipline> - <Index>.<ext>``. The
    discipline filter is *soft*: when at least one filename for this QR
    contains ` <discipline> ` (space-bounded), the result is restricted to
    those; otherwise every match is returned (legacy files).
    """
    sanitized = re.sub(r"[^A-Za-z0-9_-]", "", qr_code or "")
    if not sanitized:
        return []
    img_dir = current_app.config.get("IMG_DIR")
    if not img_dir:
        return []
    base = Path(img_dir)
    if not base.is_dir():
        return []
    matches = []
    discipline_token = f" {discipline} " if discipline else ""
    try:
        for path in sorted(base.glob(f"{sanitized}*")):
            if not path.is_file():
                continue
            stem = path.stem.rstrip()
            if not stem.lower().startswith(sanitized.lower()):
                continue
            m = _PHOTO_INDEX_RE.search(stem)
            if not m:
                continue
            matches.append({
                "index": int(m.group(1)),
                "filename": path.name,
            })
    except Exception as exc:  # noqa: BLE001
        current_app.logger.warning(
            "[sld] _find_photos_for_qr scan failed for %r: %s", qr_code, exc,
        )
        return []
    if discipline_token:
        preferred = [m for m in matches if discipline_token in f" {m['filename']} "]
        if preferred:
            matches = preferred
    matches.sort(key=lambda m: m["index"])
    return matches


@sld_bp.route("/api/photos/<path:qr_code>", methods=["GET"])
@login_required
def api_asset_photos(qr_code):
    """List captured photos for a QR. Drives the SLD photo popover."""
    qr = (qr_code or "").strip()
    if not qr:
        return jsonify({"error": "QR required"}), 400
    photos = _find_photos_for_qr(qr, discipline="EL")
    if not photos:
        return jsonify({"qr": qr, "photos": [], "message": "Photo not found"}), 404
    items = [
        {"index": m["index"], "url": f"/images/{urlquote(m['filename'])}"}
        for m in photos
    ]
    default_idx = next((i for i, m in enumerate(photos) if m["index"] == 1), 0)
    return jsonify({
        "qr": qr,
        "default_idx_in_list": default_idx,
        "photos": items,
    })


