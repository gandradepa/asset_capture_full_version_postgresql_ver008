def update_asset(row_id, updates):
    conn = _connect()
    try:
        # Pull the full row so we can compare against the AI baseline for
        # human_correction events. Falls back gracefully if the new
        # columns don't exist (older schema).
        cols = _table_columns(conn, TABLE)
        select_cols = ['row_id', '"Equipment ID"', '"Supply From"', 'ambigous', '"Building"']
        if "sld_extract_run_id" in cols:
            select_cols.append("sld_extract_run_id")
        if "sld_ai_extract_payload" in cols:
            select_cols.append("sld_ai_extract_payload")
        old = conn.execute(
            f'SELECT {", ".join(select_cols)} FROM "{TABLE}" WHERE row_id = ?',
            (row_id,),
        ).fetchone()
        if not old:
            return False, "Asset not found"
        current_row = dict(old)

        old_tag = current_row.get("Equipment ID")
        new_tag = updates.get("Equipment ID", old_tag)
        if new_tag != old_tag:
            conn.execute(
                f'UPDATE "{TABLE}" SET "Supply From" = ? WHERE "Supply From" = ?',
                (new_tag, old_tag),
            )

        set_clauses = []
        params = []
        if "Equipment ID" in updates:
            set_clauses.append('"Equipment ID" = ?')
            params.append(updates["Equipment ID"])
        if "Supply From" in updates:
            set_clauses.append('"Supply From" = ?')
            params.append(updates["Supply From"])
        if "ambigous" in updates:
            set_clauses.append("ambigous = ?")
            params.append(updates["ambigous"])
        if set_clauses:
            params.append(row_id)
            conn.execute(
                f'UPDATE "{TABLE}" SET {", ".join(set_clauses)} WHERE row_id = ?',
                params,
            )
        conn.commit()

        # Best-effort human_correction capture against the AI baseline.
        try:
            _emit_human_corrections_for_row(
                row_id=row_id,
                current_row=current_row,
                submitted_updates=updates,
                fields=["Equipment ID", "Supply From", "ambigous"],
                description="PUT /sld/api/assets",
            )
        except Exception:
            pass
        return True, "OK"
    finally:
        conn.close()


def _emit_human_corrections_for_row(*, row_id, current_row, submitted_updates, fields, description: str = ""):
    """Diff submitted updates vs the row's AI baseline and append one
    human_correction event per changed field. Also emits audit_trail rows:
    fields whose pre-edit value matched the AI baseline get a paired
    'ai:gpt-5.5' marker row plus the 'human' override row. Best-effort, no-op
    when the feedback module isn't available."""
    baseline = {}
    raw_payload = current_row.get("sld_ai_extract_payload") if isinstance(current_row, dict) else None
    if raw_payload:
        try:
            parsed = json.loads(raw_payload)
            if isinstance(parsed, dict):
                baseline = parsed
        except (TypeError, ValueError):
            baseline = {}
    ai_run_id = current_row.get("sld_extract_run_id") if isinstance(current_row, dict) else None
    building_code = current_row.get("Building") if isinstance(current_row, dict) else None
    qr_code = current_row.get("QR Code") if isinstance(current_row, dict) else None
    user = None
    try:
        from flask_login import current_user as _current_user  # noqa: WPS433
        if getattr(_current_user, "is_authenticated", False):
            user = getattr(_current_user, "username", None) or getattr(_current_user, "id", None)
    except Exception:
        user = None

    # Existing legacy feedback emission (best-effort)
    if callable(write_corrections_for_changed_fields):
        try:
            write_corrections_for_changed_fields(
                ai_run_id=ai_run_id,
                ai_baseline=baseline,
                current_row=current_row,
                submitted_updates=submitted_updates,
                fields=fields,
                building_code=building_code,
                row_id=row_id,
                user=user,
            )
        except Exception as exc:
            print(f"[audit] EL legacy feedback emission failed: {exc}")

    if not _audit_log_change:
        return

    def _normalize(v):
        if v is None:
            return ""
        return str(v).strip()

    human_changes: dict[str, tuple] = {}
    ai_marker_changes: dict[str, tuple] = {}
    for field in fields:
        if field not in submitted_updates:
            continue
        pre = current_row.get(field) if isinstance(current_row, dict) else None
        new = submitted_updates.get(field)
        if _normalize(pre) == _normalize(new):
            continue
        ai_value = baseline.get(field) if isinstance(baseline, dict) else None
        # Pre-edit matched the AI baseline → user is overriding AI. Anchor the
        # AI value first, then record the human override.
        if ai_value is not None and _normalize(pre) == _normalize(ai_value):
            ai_marker_changes[field] = (None, ai_value)
        human_changes[field] = (pre, new)

    conn = None
    try:
        conn = _connect()
        if ai_marker_changes:
            try:
                _audit_log_change(
                    conn,
                    qr_code=qr_code,
                    app_name="reviewer_el",
                    table_name=TABLE,
                    record_pk=row_id,
                    op_type="UPDATE",
                    field_changes=ai_marker_changes,
                    source="ai:gpt-5.5",
                    modified_by="ai-pipeline",
                    description=f"AI baseline (overridden): {description}".strip(": "),
                )
            except Exception as exc:
                print(f"[audit] EL AI baseline marker failed: {exc}")
        if human_changes:
            try:
                _audit_log_change(
                    conn,
                    qr_code=qr_code,
                    app_name="reviewer_el",
                    table_name=TABLE,
                    record_pk=row_id,
                    op_type="UPDATE",
                    field_changes=human_changes,
                    source="human",
                    description=description or "_emit_human_corrections_for_row",
                )
            except Exception as exc:
                print(f"[audit] EL human-correction audit failed: {exc}")
        conn.commit()
    except Exception as exc:
        print(f"[audit] EL human-correction connect failed: {exc}")
    finally:
        try:
            if conn:
                conn.close()
        except Exception:
            pass


def get_supply_from_children(conn, building, equipment_id, exclude_row_id=None):
    """Rows whose Supply From == equipment_id (same building, active diagram).

    Returns list of dicts keyed by row_id/Equipment ID plus a qr_code (may be
    empty if the child has no matching sdi_dataset_EL row). Used for rename
    cascade previews.
    """
    tag = str(equipment_id or "").strip()
    if not tag:
        return []
    rows = conn.execute(
        f'''
        SELECT row_id, "Equipment ID", "Building"
        FROM "{TABLE}"
        WHERE {ACTIVE_DRAW_CONDITION}
          AND UPPER(TRIM(COALESCE("Building", ''))) = UPPER(TRIM(COALESCE(?, '')))
          AND UPPER(TRIM(COALESCE("Supply From", ''))) = UPPER(?)
          {"AND row_id != ?" if exclude_row_id is not None else ""}
        ORDER BY CAST("Hierarchy" AS INTEGER), "Equipment ID"
        ''',
        (building, tag, exclude_row_id) if exclude_row_id is not None else (building, tag),
    ).fetchall()
    children = []
    sdi_columns = _table_columns(conn, "sdi_dataset_EL")
    qr_available = "QR Code" in sdi_columns
    for row in rows:
        qr = ""
        if qr_available:
            qr_row = conn.execute(
                '''
                SELECT "QR Code" AS qr
                FROM "sdi_dataset_EL"
                WHERE TRIM(COALESCE("UBC Asset Tag", '')) <> ''
                  AND UPPER(TRIM(COALESCE("Building", ''))) = UPPER(TRIM(COALESCE(?, '')))
                  AND UPPER(TRIM(COALESCE("UBC Asset Tag", ''))) = UPPER(TRIM(COALESCE(?, '')))
                LIMIT 1
                ''',
                (row["Building"], row["Equipment ID"]),
            ).fetchone()
            qr = (qr_row["qr"] if qr_row else "") or ""
        children.append({
            "row_id": row["row_id"],
            "Equipment ID": row["Equipment ID"],
            "Building": row["Building"],
            "qr_code": qr,
        })
    return children


def _qr_codes_available(conn):
    return qrdb.has_table(conn, "QR_codes")


def _get_qr_codes_location(conn, qr_code_id):
    """Return current QR_codes.Location for a QR, or None if table/row missing."""
    if not qr_code_id or not _qr_codes_available(conn):
        return None
    row = conn.execute(
        'SELECT "Location" FROM "QR_codes" WHERE "QR_code_ID" = ? LIMIT 1',
        (str(qr_code_id).strip(),),
    ).fetchone()
    if row is None:
        return None
    # sqlite3.Row supports both index and key access
    try:
        return row["Location"]
    except Exception:
        return row[0]


def _set_qr_codes_location(conn, qr_code_id, location):
    """Update QR_codes.Location. Triggers on QR_codes propagate to Space,
    Floor, Space Details, Floor Code. No-op if the QR row doesn't exist."""
    if not qr_code_id or not _qr_codes_available(conn):
        return False
    cur = conn.execute(
        'UPDATE "QR_codes" SET "Location" = ? WHERE "QR_code_ID" = ?',
        ("" if location is None else str(location).strip(), str(qr_code_id).strip()),
    )
    return cur.rowcount > 0


def _find_sdi_row(conn, building, ubc_tag):
    """Return matching sdi_dataset_EL row (as dict) or None."""
    row = conn.execute(
        '''
        SELECT * FROM "sdi_dataset_EL"
        WHERE TRIM(COALESCE("UBC Asset Tag", '')) <> ''
          AND UPPER(TRIM(COALESCE("Building", ''))) = UPPER(TRIM(COALESCE(?, '')))
