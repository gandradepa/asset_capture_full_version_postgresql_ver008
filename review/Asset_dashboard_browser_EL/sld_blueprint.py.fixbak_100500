def active_asset_exists(equipment_id, building=None):
    tag = str(equipment_id or "").strip()
    if not tag:
        return False
    conn = _connect()
    try:
        query = f'''
            SELECT 1
            FROM "{TABLE}"
            WHERE {ACTIVE_DRAW_CONDITION}
              AND UPPER(TRIM(COALESCE("Equipment ID", ''))) = UPPER(TRIM(COALESCE(?, '')))
        '''
        params = [tag]
        if building:
            query += " AND UPPER(TRIM(COALESCE(\"Building\", ''))) = UPPER(TRIM(COALESCE(?, '')))"
            params.append(str(building or "").strip())
        query += " LIMIT 1"
