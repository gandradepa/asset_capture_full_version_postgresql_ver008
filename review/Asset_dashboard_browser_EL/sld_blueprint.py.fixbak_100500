@sld_bp.route("/api/download-xlsx", methods=["GET"])
@login_required
def api_download_xlsx():
    """Server-side xlsx download for the SLD asset table.

    Why this exists: the client-side ExcelJS path produces a blob URL,
    which Edge's iframe download manager selectively blocks for Office
    MIME types ("Couldn't download — Network issue"). The blob path
    survives FileSaver.js because the blocking is at a layer below the
    download-trigger mechanism. A standard HTTP response with a
    ``Content-Disposition: attachment`` header is the canonical
    download path and works wherever any download works (proven by the
    PDF export's success in the same iframe).

    Mirrors the columns and ordering of the client export
    (``exportSwiftExcel`` in static/sld/sld.js) so users see the same
    spreadsheet shape regardless of which path produced it.
    """
    from io import BytesIO
    from openpyxl import Workbook
    from openpyxl.styles import Alignment, Border, Font, PatternFill, Side

    building = (request.args.get("building") or "").strip()
    if not building:
        return jsonify({"error": "missing building parameter"}), 400

    assets = get_all_assets(building=building)
    headers = [
        "Hierarchy", "Equip QR Code", "Equipment ID", "Fed QR Code",
        "Fed From", "Room", "Voltage", "Amperage", "Power", "Wire",
        "Check",
    ]
    # Indices of the Fed QR Code / Fed From header cells, tinted #FCD5B4
    # to match the on-screen pairing in the Switch Over inline editor.
    fed_header_indices = {4, 5}

    def _lookup_key(value):
        return re.sub(r"\s+", " ", str(value or "").strip()).upper()

    equipment_qr_lookup = {}
    for asset in assets:
        key = _lookup_key(asset.get("Equipment ID"))
        if key and key not in equipment_qr_lookup:
            equipment_qr_lookup[key] = str(asset.get("QR Code") or "").strip()

    def _fed_qr(asset):
        return equipment_qr_lookup.get(_lookup_key(asset.get("Supply From")), "")

    wb = Workbook()
    ws = wb.active
    ws.title = "Assets"

    title_cell = ws.cell(row=1, column=2, value="UBC Facilities — Single Line Diagram Assets")
    title_cell.font = Font(name="Calibri", size=14, bold=True, color="FF002145")
    title_cell.alignment = Alignment(vertical="center", horizontal="left")

    display_name = get_building_display(building) or building
    sub_text = (
        f"Building: {display_name}   |   "
        f"Generated {datetime.now().strftime('%Y-%m-%d %H:%M')}"
    )
    sub_cell = ws.cell(row=2, column=2, value=sub_text)
    sub_cell.font = Font(name="Calibri", size=10, italic=True, color="FF64748B")
    sub_cell.alignment = Alignment(vertical="center", horizontal="left")

    ws.row_dimensions[1].height = 22
    ws.row_dimensions[2].height = 18
    ws.row_dimensions[3].height = 6

    header_fill = PatternFill(start_color="FF002145", end_color="FF002145", fill_type="solid")
    fed_header_fill = PatternFill(start_color="FFFCD5B4", end_color="FFFCD5B4", fill_type="solid")
    header_font = Font(name="Calibri", size=11, bold=True, color="FFFFFFFF")
    fed_header_font = Font(name="Calibri", size=11, bold=True, color="FF002145")
    header_align = Alignment(horizontal="center", vertical="center")
    border_color = "FFE2E8F0"
    cell_border = Border(
        top=Side(style="thin", color=border_color),
        bottom=Side(style="thin", color=border_color),
        left=Side(style="thin", color=border_color),
        right=Side(style="thin", color=border_color),
    )

    HEADER_ROW = 4
    for col_idx, header in enumerate(headers, start=1):
        c = ws.cell(row=HEADER_ROW, column=col_idx, value=header)
        if col_idx in fed_header_indices:
            c.font = fed_header_font
            c.fill = fed_header_fill
        else:
            c.font = header_font
            c.fill = header_fill
        c.alignment = header_align
    ws.row_dimensions[HEADER_ROW].height = 22
    ws.freeze_panes = ws.cell(row=HEADER_ROW + 1, column=1)

    band_fills = ["FFF8FAFC", "FFEEF2F8"]
    band_idx = 0
    prev_hierarchy = None
    matched_font = Font(name="Calibri", size=12, bold=True, color="FF10B981")
    unmatched_font = Font(name="Calibri", size=12, bold=True, color="FFEF4444")
    body_align_left = Alignment(horizontal="left", vertical="center")
    body_align_center = Alignment(horizontal="center", vertical="center")

    def _join(value, uom):
        a = (str(value) if value is not None else "").strip()
        b = (str(uom) if uom is not None else "").strip()
        return f"{a} {b}".strip()

    for offset, asset in enumerate(assets):
        row_idx = HEADER_ROW + 1 + offset
        hierarchy_value = asset.get("Hierarchy", "")
        if offset > 0 and str(hierarchy_value or "") != str(prev_hierarchy or ""):
            band_idx = (band_idx + 1) % len(band_fills)
        prev_hierarchy = hierarchy_value
        band_fill = PatternFill(
            start_color=band_fills[band_idx],
            end_color=band_fills[band_idx],
            fill_type="solid",
        )

        matched = bool(asset.get("id_check_match"))
        values = [
            hierarchy_value if hierarchy_value is not None else "",
            asset.get("QR Code") or "",
            asset.get("Equipment ID") or "",
            _fed_qr(asset),
            asset.get("Supply From") or "",
            asset.get("Room") or "",
            _join(asset.get("Voltage Rating"), asset.get("Voltage Rating (UoM)")),
            _join(asset.get("Amperage Rating"), asset.get("Amperage Rating (UoM)")),
            _join(asset.get("Power Rating"), asset.get("Power Rating (UoM)")),
            _join(asset.get("Wire Rating"), asset.get("Wire Rating (UoM)")),
            "✓" if matched else "✗",
        ]
        for col_idx, v in enumerate(values, start=1):
            c = ws.cell(row=row_idx, column=col_idx, value=v)
            c.fill = band_fill
            c.border = cell_border
            if col_idx in (1, 11):
                c.alignment = body_align_center
            else:
                c.alignment = body_align_left
            c.font = Font(name="Calibri", size=11)
        check_cell = ws.cell(row=row_idx, column=11)
        check_cell.font = matched_font if matched else unmatched_font

    # Auto-fit each column to the widest visible value (incl. header).
    min_widths = [11, 16, 16, 16, 16, 11, 14, 14, 14, 10, 8]
    for col_idx, header in enumerate(headers, start=1):
        widest = len(str(header))
        for row_idx in range(HEADER_ROW + 1, ws.max_row + 1):
            v = ws.cell(row=row_idx, column=col_idx).value
            if v is not None:
                widest = max(widest, len(str(v)))
        col_letter = ws.cell(row=1, column=col_idx).column_letter
        ws.column_dimensions[col_letter].width = max(min_widths[col_idx - 1], widest + 3)

    buf = BytesIO()
    wb.save(buf)
    buf.seek(0)
    safe_building = re.sub(r"[^\w\-]", "_", building) or "unknown"
    return send_file(
        buf,
        mimetype="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        as_attachment=True,
        download_name=f"EL_Assets_{safe_building}.xlsx",
    )


