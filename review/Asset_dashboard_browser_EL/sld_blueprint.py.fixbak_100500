def _active_match_exists_sql(table_alias=TABLE):
    return f'''
        EXISTS (
            SELECT 1
            FROM "sdi_dataset_EL" s
            WHERE TRIM(COALESCE(s."UBC Asset Tag", '')) <> ''
              AND UPPER(TRIM(COALESCE(s."Building", ''))) = UPPER(TRIM(COALESCE("{table_alias}"."Building", '')))
              AND UPPER(TRIM(COALESCE(s."UBC Asset Tag", ''))) = UPPER(TRIM(COALESCE("{table_alias}"."Equipment ID", '')))
        )
    '''


def _table_columns(conn, table_name):
    return set(qrdb.table_columns(conn, table_name))


def _buildings_with_displayable_qr(conn):
    """UPPER(TRIM)-normalized set of Building codes that have at least one
    sdi_dataset_EL QR code NOT present in sdi_print_out_arch (the archive).

    Mirrors the main review dashboard's "Hide Archive" notion of displayable,
    which keys purely on "QR Code" (see get_archived_qrs in Asset_dashboard_EL).
    Returns None when sdi_dataset_EL is missing/unreadable so callers fail open
    (no filtering) — and treats every QR as displayable when sdi_print_out_arch
    is absent. Best-effort; never raises."""
    if not qrdb.has_table(conn, "sdi_dataset_EL"):
        return None
    arch_not_in = (
        'AND TRIM(s."QR Code") NOT IN (SELECT TRIM("QR Code") FROM "sdi_print_out_arch")'
        if qrdb.has_table(conn, "sdi_print_out_arch") else ""
    )
    try:
        rows = conn.execute(f'''
            SELECT DISTINCT UPPER(TRIM(COALESCE(s."Building", ''))) AS b
            FROM "sdi_dataset_EL" s
            WHERE TRIM(COALESCE(s."QR Code", '')) <> ''
            {arch_not_in}
        ''').fetchall()
    except qrdb.DatabaseError:
        return None
    return {r["b"] for r in rows if r["b"]}


def _id_check_value(building, asset_tag, supply_from):
    return " | ".join([
        str(building or "").strip(),
        str(asset_tag or "").strip(),
        str(supply_from or "").strip(),
    ])


def _sdi_id_check_expression(sdi_columns):
    if "ID_check" in sdi_columns:
        return "TRIM(COALESCE(s.\"ID_check\", ''))"
    return '''
        TRIM(COALESCE(s."Building", '')) || ' | ' ||
        TRIM(COALESCE(s."UBC Asset Tag", '')) || ' | ' ||
        TRIM(COALESCE(s."Supply From", ''))
    '''


def _enrich_asset_display_fields(conn, assets):
    """Attach display-only SDI fields without changing SLD eligibility."""
    if not assets:
        return assets

    sdi_columns = _table_columns(conn, "sdi_dataset_EL")
    if not sdi_columns:
        for asset in assets:
            asset["id_check_match"] = 0
            asset["QR Code"] = ""
            asset["Room"] = ""
            asset["swift_revision"] = compute_swift_revision(asset)
        return assets

    sdi_id_check_expr = _sdi_id_check_expression(sdi_columns)
    qr_select = 's."QR Code"' if "QR Code" in sdi_columns else "''"
    qr_order = 's."QR Code"' if "QR Code" in sdi_columns else "s.\"Equipment ID\""

    # Room is sourced from QR_codes.Location (master location on the QR record),
    # joined via the QR Code discovered through the sdi_dataset_EL match. The
    # QR_codes row is the authoritative location store — triggers on QR_codes
    # propagate Location changes to Space / Floor / Space Details / Floor Code.
    qr_codes_exists = qrdb.has_table(conn, "QR_codes")
    if qr_codes_exists and "QR Code" in sdi_columns:
        room_join = (
            'LEFT JOIN "QR_codes" qc '
            'ON TRIM(COALESCE(qc."QR_code_ID", \'\')) = TRIM(COALESCE(s."QR Code", \'\'))'
        )
        room_select = 'COALESCE(NULLIF(TRIM(qc."Location"), \'\'), \'\')'
    else:
        room_join = ''
        room_select = "''"

    id_check_query = f'''
        SELECT 1
        FROM "sdi_dataset_EL" s
        WHERE {sdi_id_check_expr} = ?
        LIMIT 1
    '''
    match_query = f'''
        SELECT {qr_select} AS qr_code, {room_select} AS room
        FROM "sdi_dataset_EL" s
        {room_join}
        WHERE TRIM(COALESCE(s."UBC Asset Tag", '')) <> ''
          AND UPPER(TRIM(COALESCE(s."Building", ''))) = UPPER(TRIM(COALESCE(?, '')))
          AND UPPER(TRIM(COALESCE(s."UBC Asset Tag", ''))) = UPPER(TRIM(COALESCE(?, '')))
        ORDER BY CASE WHEN {sdi_id_check_expr} = ? THEN 0 ELSE 1 END, {qr_order}
        LIMIT 1
    '''

    for asset in assets:
        id_check = str(asset.get("ID_check") or "").strip()
        if not id_check:
            id_check = _id_check_value(asset.get("Building"), asset.get("Equipment ID"), asset.get("Supply From"))
            asset["ID_check"] = id_check

        asset["id_check_match"] = 1 if conn.execute(id_check_query, (id_check,)).fetchone() else 0
        match = conn.execute(
            match_query,
            (asset.get("Building"), asset.get("Equipment ID"), id_check),
        ).fetchone()
        asset["QR Code"] = (match["qr_code"] if match else "") or ""
        asset["Room"] = (match["room"] if match else "") or ""
        asset["swift_revision"] = compute_swift_revision(asset)

    return assets


def _derive_group_of_asset(equipment_id):
    group = (derive_electrical_equipment_type(equipment_id) or "").strip()
    if not group:
        return "Unknown"
    if group.lower() in {"switchboard", "distribuition", "distribution"}:
        return "Distribution"
    return group


def ensure_sld_schema():
    """Idempotent safety net — the migration runner creates the table, but
    older databases that pre-date migrations may still be missing the
    version-tracking columns."""
    conn = _connect()
    try:
        # Backend-agnostic column list — includes generated columns (notably the
        # generated ID_check) so we don't try to ADD COLUMN them again.
        cols = list(qrdb.table_columns(conn, TABLE))
        if not cols:
            # Table missing entirely. Migration runner should have handled this;
            # bail so the error is visible rather than silently creating
            # something mis-shaped.
            return
        if "new_draw" not in cols:
            conn.execute(f"ALTER TABLE \"{TABLE}\" ADD COLUMN new_draw TEXT DEFAULT 'TRUE'")
        if "ID_check" not in cols:
            conn.execute(
                f'ALTER TABLE "{TABLE}" ADD COLUMN ID_check TEXT '
                f'GENERATED ALWAYS AS ('
                f'TRIM(COALESCE("Building", \'\')) || \' | \' || '
                f'TRIM(COALESCE("Equipment ID", \'\')) || \' | \' || '
                f'TRIM(COALESCE("Supply From", \'\'))'
                f') VIRTUAL'
            )
        if "matching_check" not in cols:
            conn.execute(f'ALTER TABLE "{TABLE}" ADD COLUMN matching_check INTEGER DEFAULT 0')
        if "source_pdf" not in cols:
            conn.execute(f"ALTER TABLE \"{TABLE}\" ADD COLUMN source_pdf TEXT DEFAULT ''")
        if "created_at" not in cols:
            conn.execute(f"ALTER TABLE \"{TABLE}\" ADD COLUMN created_at TEXT DEFAULT ''")
        # Feedback corpus join keys (v1+v2): every row carries the run_id of
        # the AI extraction that produced it and a JSON snapshot of the
        # AI-output fields at insert time. The snapshot is the diff baseline
        # for human_correction events.
        if "sld_extract_run_id" not in cols:
            conn.execute(f"ALTER TABLE \"{TABLE}\" ADD COLUMN sld_extract_run_id TEXT DEFAULT ''")
        if "sld_ai_extract_payload" not in cols:
            conn.execute(f"ALTER TABLE \"{TABLE}\" ADD COLUMN sld_ai_extract_payload TEXT DEFAULT ''")
        # Wire Rating: a parallel value/UoM pair so a single row can carry both
        # a Power (KVA) and a Wire (W) rating. Pre-existing rows that stored
        # the wire info in Power Rating (UoM=W) are migrated into the new
        # columns so the Switch Over editor can show both inputs cleanly.
        wire_added = False
        if "Wire Rating" not in cols:
            conn.execute(f"ALTER TABLE \"{TABLE}\" ADD COLUMN \"Wire Rating\" TEXT DEFAULT ''")
            wire_added = True
        if "Wire Rating (UoM)" not in cols:
            conn.execute(f"ALTER TABLE \"{TABLE}\" ADD COLUMN \"Wire Rating (UoM)\" TEXT DEFAULT ''")
            wire_added = True
        if wire_added:
            conn.execute(
                f'UPDATE "{TABLE}" SET '
                f'"Wire Rating" = COALESCE("Power Rating", \'\'), '
                f'"Wire Rating (UoM)" = COALESCE("Power Rating (UoM)", \'\'), '
                f'"Power Rating" = \'\', "Power Rating (UoM)" = \'\' '
                f'WHERE UPPER(TRIM(COALESCE("Power Rating (UoM)", \'\'))) = \'W\''
            )
        conn.commit()
    finally:
        conn.close()


