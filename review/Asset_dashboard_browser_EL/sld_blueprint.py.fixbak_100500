        "building_code": building_code,
        "building_display": get_building_display(building_code),
        "building_exists": exists,
        "saved_to": dest_path,
    })


def _is_dashboard_admin() -> bool:
    """Mirror of Dashboard's is_dashboard_admin(): membership of the
    DASHBOARD_ADMIN_USERS env var (CSV). Both apps load the same
    auth_service.env so the same admin set applies cross-service."""
    try:
        from flask_login import current_user as _current_user  # noqa: WPS433
    except Exception:
        return False
    if not getattr(_current_user, "is_authenticated", False):
        return False
    raw = os.getenv("DASHBOARD_ADMIN_USERS", "")
    admins = {p.strip().lower() for p in raw.split(",") if p.strip()}
    uname = str(getattr(_current_user, "username", "") or "").strip().lower()
    return bool(uname) and uname in admins


def _read_run_meta(run_id: str):
    """Read the run_meta event from a feedback JSONL by run_id."""
    if not run_id:
        return None
    fb_dir = feedback_dir_for()
    candidate = os.path.join(fb_dir, f"{run_id}.jsonl")
    if not os.path.isfile(candidate):
        return None
    try:
        with open(candidate, "r", encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    rec = json.loads(line)
                except Exception:
                    continue
                if rec.get("kind") == "run_meta":
                    return rec
    except OSError:
        return None
    return None


def _run_extraction(filename: str, building_code: str, replace: bool):
    """Core SLD extraction pipeline shared by /api/process and /api/rerun.

    Returns a Flask response (jsonify + status code) so callers can
    `return _run_extraction(...)` directly. All Channel A/B logging,
    backup/restore, and JSON-replay behavior is preserved.
    """
    # PostgreSQL cutover feature-flag: the PDF extractor is the destructive
    # create-diagram path (it clears + repopulates electrical_building_schema).
    # The extractor is now converted to db.py (DELETE-not-DROP on PG), but the
    # full flow is gated behind SLD_EXTRACT_PG_ENABLED so it can be validated and
    # switched on deliberately. View/edit/reconcile of existing diagrams is
    # unaffected by this flag.
    if qrdb.is_postgres() and os.environ.get("SLD_EXTRACT_PG_ENABLED") != "1":
        return jsonify({
            "error": "Creating or re-running SLD diagrams from a PDF is temporarily "
                     "disabled during the PostgreSQL migration validation. Viewing, "
                     "editing, and reconciling existing diagrams works normally."
        }), 503

    pdf_path = os.path.join(_pdf_storage(), filename)
    if not os.path.isfile(pdf_path):
        return jsonify({"error": f"PDF not found: {filename}"}), 400

    existing = check_building_exists(building_code)
    if existing and not replace:
        return jsonify({
            "error": "conflict",
            "message": (
                f"Building {building_code} already has an active drawing. "
                "Set replace=true to proceed."
            ),
        }), 409

    all_old_rows = backup_all_rows()
    old_rows_to_archive = [r for r in all_old_rows if r.get("new_draw") != "FALSE"]

    extract_script = current_app.config["SLD_EXTRACT_SCRIPT"]
    timeout = current_app.config.get("SLD_EXTRACT_TIMEOUT", 600)

    # ── Feedback-corpus envelope (Channel A + B). Best-effort: any failure
    # writing logs is swallowed so the user's extraction completes either
    # way. See sld/_feedback.py for the schema. ─────────────────────────
    fb_dir = feedback_dir_for()
    try:
        os.makedirs(fb_dir, exist_ok=True)
    except OSError:
        pass
    pdf_sha1 = _file_sha1(pdf_path)
    script_sha1 = _file_sha1(extract_script)
    run_id = make_run_id(building_code, pdf_sha1) or "sld_unknown"
    feedback_file = os.path.join(fb_dir, f"{run_id}.jsonl")
    main_log_path = os.environ.get("SLD_EXTRACT_LOG", "/home/developer/sld_extract.log")
    run_meta = {
        "kind": "run_meta",
        "run_id": run_id,
        "ts": _now_iso(),
        "building_code": building_code,
        "pdf_filename": filename,
        "pdf_path": pdf_path,
        "pdf_sha1": pdf_sha1,
        "pdf_bytes": _file_size(pdf_path),
        "script_path": extract_script,
        "script_sha1": script_sha1,
        "timeout_s": timeout,
        "feedback_file": feedback_file,
        "main_log": main_log_path,
        "replace": replace,
    }
    _append_jsonl(feedback_file, run_meta)
    _append_main_log(
        main_log_path,
        [
            "",
            "==================================================",
            f"[{_now_local()}] INFO: --- START sld_extract ---",
            f"[{_now_local()}] INFO: run_id={run_id} building={building_code} "
            f"pdf={filename} pdf_sha1={pdf_sha1[:12]} script_sha1={script_sha1[:12]} "
            f"feedback={feedback_file}",
            "==================================================",
        ],
    )
    _wrapper_start_ts = datetime.now(timezone.utc)

    try:
        result = subprocess.run(
            [
                sys.executable,
                extract_script,
                "--input", pdf_path,
                "--db", _db_path(),
                "--building-code", building_code,
                "--feedback-file", feedback_file,
                "--run-id", run_id,
            ],
            capture_output=True,
            text=True,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired:
        _append_jsonl(feedback_file, {
            "kind": "wrapper_event", "run_id": run_id, "ts": _now_iso(),
            "subkind": "timeout", "timeout_s": timeout,
        })
        _append_main_log(main_log_path, [
            f"[{_now_local()}] ERROR: --- END sld_extract --- (exit=TIMEOUT, duration={timeout}s)",
            "---------------------------------------------------",
        ])
        return jsonify({"error": f"Extraction timed out after {timeout}s"}), 504
    except FileNotFoundError:
        _append_jsonl(feedback_file, {
            "kind": "wrapper_event", "run_id": run_id, "ts": _now_iso(),
            "subkind": "script_not_found", "script_path": extract_script,
        })
        _append_main_log(main_log_path, [
            f"[{_now_local()}] ERROR: --- END sld_extract --- (script not found: {extract_script})",
            "---------------------------------------------------",
        ])
        return jsonify({"error": f"Extraction script not found: {extract_script}"}), 500

    duration_s = int((datetime.now(timezone.utc) - _wrapper_start_ts).total_seconds())

    # Channel A: append captured stdout/stderr regardless of exit code so
    # the human-readable trail survives both success and failure.
    if result.stdout:
        _append_main_log_raw(main_log_path, result.stdout)
    if result.stderr:
        _append_main_log_raw(main_log_path, result.stderr)

    summary = parse_summary_from_stdout(result.stdout or "") or {}

    if result.returncode != 0:
        stderr_tail = (result.stderr or "")[-2000:]
        _append_jsonl(feedback_file, {
            "kind": "wrapper_event", "run_id": run_id, "ts": _now_iso(),
            "subkind": "non_zero_exit", "exit_code": result.returncode,
            "stderr_tail": stderr_tail, "duration_s": duration_s,
        })
        _append_main_log(main_log_path, [
            f"[{_now_local()}] ERROR: --- END sld_extract --- (exit={result.returncode}, duration={duration_s}s)",
            "---------------------------------------------------",
        ])
        restore_archived_rows(old_rows_to_archive)
        ensure_sld_schema()
        current_app.logger.error("[sld] extraction failed rc=%s stderr=%s", result.returncode, stderr_tail)
        return jsonify({"error": "Extraction failed", "stderr": stderr_tail}), 502

    _append_jsonl(feedback_file, {
        "kind": "run_summary", "run_id": run_id, "ts": _now_iso(),
        "exit_code": 0, "duration_s": duration_s, **summary,
    })
    _append_main_log(main_log_path, [
        f"[{_now_local()}] INFO: --- END sld_extract --- "
        f"(exit=0, duration={duration_s}s, "
        f"assets={summary.get('asset_count', '?')}, "
        f"hierarchies={summary.get('hierarchy_count', '?')}, "
        f"model_calls={summary.get('model_calls', '?')})",
        "---------------------------------------------------",
    ])

    ensure_sld_schema()
    mark_new_rows_and_source(building_code, filename)

    # Re-insert previously-backed-up rows after the table-drop in extraction.
    # Three buckets, three different new_draw states:
    #   1. Already-archived rows (any building)        -> stay FALSE.
    #   2. THIS building's prior active rows (replace) -> become FALSE (superseded).
    #   3. OTHER buildings' active rows                -> stay TRUE (preserved).
    # Bucket 3 used to call restore_archived_rows (which always wrote FALSE),
    # silently archiving every other building each time anyone ran Process.
    # That was the cause of the "0 active rows for building X after building Y
    # was processed" symptom; now uses restore_active_rows.
    restore_archived_rows([r for r in all_old_rows if r.get("new_draw") == "FALSE"])
    if existing:
        restore_archived_rows([r for r in old_rows_to_archive if r["Building"] == building_code])
    restore_active_rows([r for r in old_rows_to_archive if r["Building"] != building_code])

    recompute_matching_check(building=building_code)

    return jsonify({
        "status": "ok",
        "run_id": run_id,
        "duration_s": duration_s,
        "asset_count": summary.get("asset_count"),
        "building_code": building_code,
        "assets": get_all_assets(building=building_code),
        "missed_assets": get_missed_assets(building=building_code),
        "sdi_not_in_sld": get_sdi_not_in_sld_assets(building=building_code),
        "all_buildings": get_buildings(),
    })


@sld_bp.route("/api/process", methods=["POST"])
@login_required
def api_process():
    body = request.get_json(silent=True) or {}
    return _run_extraction(
        filename=body.get("filename", ""),
        building_code=body.get("building_code", ""),
        replace=bool(body.get("replace", False)),
    )


@sld_bp.route("/api/rerun/<run_id>", methods=["POST"])
@login_required
def api_rerun(run_id):
    """Admin-only re-run of a prior extraction by run_id.

    Reads the original run_meta from <feedback_dir>/<run_id>.jsonl to
    recover the source PDF and building, then invokes the same pipeline
    as /api/process with replace=True. A NEW run_id is minted by the
    pipeline; this endpoint returns that new run_id in the response.
    """
    if not _is_dashboard_admin():
        return jsonify({"error": "Administrator access required"}), 403
    meta = _read_run_meta(run_id)
    if not meta:
        return jsonify({"error": f"Run not found: {run_id}"}), 404
    filename = meta.get("pdf_filename") or ""
    building_code = meta.get("building_code") or ""
    if not filename or not building_code:
        return jsonify({"error": f"Run {run_id} missing pdf_filename or building_code"}), 422
    return _run_extraction(filename=filename, building_code=building_code, replace=True)
