{% extends "base.html" %}
{% block title %}UBC Asset Capture - Start{% endblock %}

{% block content %}
<!-- Step Indicator -->
<nav class="step-indicator" aria-label="Workflow progress">
  <div class="step-indicator__item">
    <div class="step-indicator__dot step-indicator__dot--active" aria-current="step"></div>
    <span class="step-indicator__label step-indicator__label--active">Start</span>
  </div>
  <div class="step-indicator__connector"></div>
  <div class="step-indicator__item">
    <div class="step-indicator__dot"></div>
    <span class="step-indicator__label">Capture</span>
  </div>
  <div class="step-indicator__connector"></div>
  <div class="step-indicator__item">
    <div class="step-indicator__dot"></div>
    <span class="step-indicator__label">Done</span>
  </div>
</nav>


<!-- Asset Setup Section -->
<div class="card mb-4">
  <div class="mb-4 pb-2 border-b border-gray-200">
    <h3 class="text-lg font-bold text-gray-800">Asset Setup</h3>
  </div>

  <form method="POST" action="{{ url_for('capture') }}" id="startForm">
    <input type="hidden" id="qr_code" name="qr_code" value="">
    <input type="hidden" id="overwrite" name="overwrite" value="0">
    <input type="hidden" id="stopwatch_start_utc" name="stopwatch_start_utc" value="{{ stopwatch_start_utc|default('') }}">
    <noscript>
      <div class="alert alert-warning mb-4">
        Camera scanning requires JavaScript. Enter the asset code manually to continue.
      </div>
      <div class="field-group">
        <label for="qr_code_fallback" class="block text-sm font-semibold mb-2">Asset QR Code</label>
        <input type="text" id="qr_code_fallback" name="qr_code_fallback" pattern="[0-9]{10}" inputmode="numeric"
          maxlength="10" placeholder="10-digit asset code">
        <span class="helper-text">Use the 10-digit code printed on the asset label.</span>
      </div>
    </noscript>

    <!-- Capture Process -->
    <div class="field-group">
      <label for="capture_process" class="block text-sm font-semibold mb-2">Capture Process</label>
      <select name="capture_process" id="capture_process" required>
        <option value="" {% if not capture_process %}selected{% endif %}>-- Select Capture Process --</option>
        <option value="0" {% if capture_process=='0' %}selected{% endif %}>New Asset (QR Required)</option>
        <option value="1" {% if capture_process=='1' %}selected{% endif %}>Existing Ones (QR Required)</option>
        <option value="2" {% if capture_process=='2' %}selected{% endif %}>Replacing | Checking Asset (NO QR Required)
        </option>
      </select>
      <span class="helper-text">Choose the type of asset capture workflow</span>
    </div>

    <!-- Select Building -->
    <div class="field-group field-with-icon">
      <label for="building_code" class="block text-sm font-semibold mb-2">Select Building</label>
      <span class="field-icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
          <path
            d="M4 2h16a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1zm1 2v16h14V4H5zm2 2h2v2H7V6zm4 0h2v2h-2V6zm4 0h2v2h-2V6zM7 10h2v2H7v-2zm4 0h2v2h-2v-2zm4 0h2v2h-2v-2zM7 14h2v2H7v-2zm4 0h2v2h-2v-2zm4 0h2v2h-2v-2z" />
        </svg>
      </span>
      <select name="building_code" id="building_code" required>
        <option value="">-- Select Building --</option>
        {% for b in building_options %}
        <option value="{{ b.code }}" {% if building_code and b.code==building_code %}selected{% endif %}>{{ b.name }}
        </option>
        {% endfor %}
      </select>
      <span class="helper-text">Choose the property where the asset is located</span>
    </div>

    <!-- Location -->
    <div class="field-group">
      <label for="location" class="block text-sm font-semibold mb-2">Location</label>
      <input type="text" id="location_search" class="w-full mb-2" placeholder="Type to filter locations"
        autocomplete="off" />
      <noscript><input type="text" name="location_fallback" class="w-full mb-2"
          placeholder="Enter location manually"></noscript>
      <div id="location_suggestions" class="w-full"
        style="max-height: 160px; overflow-y: auto; border: 1px solid #e5e7eb; border-radius: 6px; background:#fff; position: relative; z-index: 5;">
      </div>
      <div id="location_skeleton" class="skeleton skeleton-input" style="display: none;"></div>
      <select name="location" id="location">
        <option value="">-- Select First the Property --</option>
      </select>
      <span class="helper-text">Select the specific space or room</span>
    </div>

    <!-- Asset Type -->
    <div class="field-group field-with-icon">
      <label for="asset_type" class="block text-sm font-semibold mb-2">Asset Type</label>
      <span class="field-icon" id="asset_type_icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
          <path
            d="M12 15.5A3.5 3.5 0 0 1 8.5 12 3.5 3.5 0 0 1 12 8.5a3.5 3.5 0 0 1 3.5 3.5 3.5 3.5 0 0 1-3.5 3.5m7.43-2.53c.04-.32.07-.64.07-.97 0-.33-.03-.66-.07-1l2.11-1.63c.19-.15.24-.42.12-.64l-2-3.46c-.12-.22-.39-.31-.61-.22l-2.49 1c-.52-.39-1.06-.73-1.69-.98l-.37-2.65A.506.506 0 0 0 14 2h-4c-.25 0-.46.18-.5.42l-.37 2.65c-.63.25-1.17.59-1.69.98l-2.49-1c-.22-.09-.49 0-.61.22l-2 3.46c-.13.22-.07.49.12.64L4.57 11c-.04.34-.07.67-.07 1 0 .33.03.65.07.97l-2.11 1.66c-.19.15-.25.42-.12.64l2 3.46c.12.22.39.3.61.22l2.49-1.01c.52.4 1.06.74 1.69.99l.37 2.65c.04.24.25.42.5.42h4c.25 0 .46-.18.5-.42l.37-2.65c.63-.26 1.17-.59 1.69-.99l2.49 1.01c.22.08.49 0 .61-.22l2-3.46c.12-.22.07-.49-.12-.64l-2.11-1.66z" />
        </svg>
      </span>
      <select name="asset_type" id="asset_type" required>
        <option value="Mechanical" {% if asset_type=='Mechanical' %}selected{% endif %}>Mechanical</option>
        <option value="Electrical" {% if asset_type=='Electrical' %}selected{% endif %}>Electrical</option>
        <option value="Backflow" {% if asset_type=='Backflow' %}selected{% endif %}>Backflow</option>
      </select>
      <span class="helper-text">Type of equipment being captured</span>
    </div>

    <!-- Identify Asset Section -->
    <div class="bg-gray-50 rounded-xl border border-gray-200 p-4 mb-4">
      <h3 class="text-center font-bold text-gray-800 mb-4">Identify Asset</h3>

      <!-- QR Scanner Area (Box) -->
      <div id="qr-reader" class="mb-4"
        style="border-radius: 0.5rem; overflow: hidden; background-color: #e5e7eb; min-height: 140px; position: relative;">
        <!-- Placeholder visible when camera not active -->
        <div id="qr-placeholder" class="qr-placeholder"
          style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center;">
          <img src="{{ url_for('static', filename='img/scan_qr_icon.svg') }}" alt="QR scan illustration" class="qr-icon"
            style="width: 80px; height: auto; opacity: 0.9;" loading="lazy">
          <div class="scanner-viewfinder">
            <div class="scanner-corner scanner-corner--tl"></div>
            <div class="scanner-corner scanner-corner--tr"></div>
            <div class="scanner-corner scanner-corner--bl"></div>
            <div class="scanner-corner scanner-corner--br"></div>
          </div>
        </div>
      </div>

      <div class="scanner-btn-group flex flex-col gap-2 mb-4">
        <button type="button" id="startScanner"
          class="btn btn-primary w-full py-2 flex flex-col gap-1 items-center justify-center bg-blue-600 hover:bg-blue-700 text-white shadow-md transition-all">
          <span class="text-xl">▣</span>
          <span id="scannerBtnText" class="font-bold text-sm uppercase tracking-wide">TAP TO SCAN QR CODE</span>
        </button>
        <div id="torch-container" class="hidden">
          <button type="button" id="torchToggle" class="btn btn-outline w-full mt-2" title="Toggle flashlight">Toggle
            Flashlight</button>
        </div>
      </div>

      <div id="qr_status" class="qr-status text-sm text-center mb-3 hidden" aria-live="polite"></div>
      <div id="qr_inline_alert" aria-live="polite" role="status"></div>

      <!-- Manual Entry Separator -->
      <div class="relative py-2 mb-4">
        <div class="absolute inset-0 flex items-center" aria-hidden="true">
          <div class="w-full border-t border-gray-300"></div>
        </div>
        <div class="relative flex justify-center">
          <span class="bg-gray-50 px-2 text-sm text-gray-500">or enter manually</span>
        </div>
      </div>

      <!-- Inline Manual Entry -->
      <div class="manual-entry-row">
        <div class="manual-entry-input-wrapper">
          <input type="text" id="manual_qr" class="manual-entry-input" placeholder="10-digit asset code"
            pattern="[0-9]{10}" inputmode="numeric" maxlength="10" autocomplete="off"
            aria-label="Enter 10-digit QR code manually" />
        </div>
        <button type="button" id="useManual" class="btn btn-secondary">Verify</button>
      </div>
    </div>

    <!-- Submit Button (Sticky) -->
    <div class="sticky-actions">
      <button type="submit" id="submitBtn" class="btn btn-success btn-large btn-full font-bold uppercase tracking-wide">
        Continue
      </button>
    </div>
  </form>
</div>

<!-- Recent scans sidebar -->
<div class="card mt-4">
  <div class="mb-2 pb-2 border-b border-gray-200">
    <h3 class="text-md font-bold text-gray-700">Recent Scans</h3>
  </div>
  <div id="recent_scans" class="space-y-2 text-sm text-gray-600">
    <div id="recent_scans_skeleton" class="flex gap-3 overflow-hidden">
      <div class="skeleton skeleton-card"></div>
      <div class="skeleton skeleton-card"></div>
      <div class="skeleton skeleton-card"></div>
    </div>
    <div id="no-recent-scans" class="text-center italic text-gray-400 py-2 hidden">No recent scans</div>
  </div>
</div>


<footer class="text-center text-xs text-gray-500 mt-8 pb-4">
  2026 University of British Columbia - Maintenance Planning Department. All rights reserved.
</footer>

<script src="{{ url_for('static', filename='js/vendor/html5-qrcode.min.js') }}"></script>
<script>
  (function () {
    const qrReaderElem = document.getElementById("qr-reader");
    const startBtn = document.getElementById("startScanner");
    const scannerBtnText = document.getElementById("scannerBtnText");
    const torchBtn = document.getElementById("torchToggle");
    const qrStatus = document.getElementById("qr_status");
    const qrInput = document.getElementById("qr_code");
    const overwriteInput = document.getElementById("overwrite");
    const stopwatchStartInput = document.getElementById("stopwatch_start_utc");
    const form = document.getElementById("startForm");
    const submitBtn = document.getElementById("submitBtn");
    const manual = document.getElementById("manual_qr");
    const useManualBtn = document.getElementById("useManual");
    const inlineAlert = document.getElementById("qr_inline_alert");
    const notify = (message, type = "info", duration = 3200) => {
      if (typeof window.showToast === "function") {
        window.showToast(message, type, duration);
      }
    };

    const placeholderMarkup = `
      <div id="qr-placeholder" class="qr-placeholder" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center;">
        <img src="{{ url_for('static', filename='img/scan_qr_icon.svg') }}" alt="QR scan illustration"
          class="qr-icon" style="width: 80px; height: auto; opacity: 0.9;" loading="lazy">
        <div class="scanner-viewfinder">
          <div class="scanner-corner scanner-corner--tl"></div>
          <div class="scanner-corner scanner-corner--tr"></div>
          <div class="scanner-corner scanner-corner--bl"></div>
          <div class="scanner-corner scanner-corner--br"></div>
        </div>
      </div>`;

    let html5QrCode = null;
    let scanning = false;
    let lastScanSuccess = false;
    const vibratePattern = [50, 30, 50];
    let audioCtx = null;
    const beepAudioSrc = "data:audio/wav;base64,";
    let beepAudioEl = null;
    let torchSupported = false;
    let torchEnabled = false;

    function hapticSuccess() {
      try {
        if (navigator.vibrate) {
          const ok = navigator.vibrate(vibratePattern);
          if (ok === false) navigator.vibrate(80);
        }
      } catch (e) {
        console.warn("Vibration not available:", e);
      }
    }

    function resumeAudioCtx() {
      try {
        if (!audioCtx) {
          const AudioContext = window.AudioContext || window.webkitAudioContext;
          if (!AudioContext) return;
          audioCtx = new AudioContext();
        }
        if (audioCtx.state === "suspended") audioCtx.resume();
      } catch (e) {
        console.warn("AudioContext unavailable:", e);
      }
    }

    function ensureBeepAudio() {
      if (!beepAudioEl && beepAudioSrc) {
        beepAudioEl = new Audio(beepAudioSrc);
        beepAudioEl.preload = "auto";
        beepAudioEl.setAttribute("playsinline", "true");
      }
    }

    // Some browsers (Edge/Chromium) need a user-gesture warmup to allow playback.
    function primeBeepAudio() {
      try {
        ensureBeepAudio();
        if (!beepAudioEl) return;
        beepAudioEl.muted = true;
        beepAudioEl.currentTime = 0;
        const p = beepAudioEl.play();
        if (p && p.catch) p.catch(() => { });
        setTimeout(() => {
          try {
            beepAudioEl.pause();
            beepAudioEl.currentTime = 0;
            beepAudioEl.muted = false;
          } catch { }
        }, 60);
      } catch (e) {
        console.warn("Prime audio failed:", e);
      }
    }

    function beepSuccess() {
      try {
        resumeAudioCtx();
        ensureBeepAudio();
        if (audioCtx) {
          const now = audioCtx.currentTime;
          const makeBeep = (startTime) => {
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = "sine";
            osc.frequency.setValueAtTime(1000, startTime);
            gain.gain.setValueAtTime(0.0001, startTime);
            gain.gain.exponentialRampToValueAtTime(0.5, startTime + 0.02);
            gain.gain.exponentialRampToValueAtTime(0.0001, startTime + 0.36);
            osc.connect(gain).connect(audioCtx.destination);
            osc.start(startTime);
            osc.stop(startTime + 0.36);
          };
          makeBeep(now);
          makeBeep(now + 0.48);
        } else if (beepAudioSrc) {
          const playOnce = () => {
            try {
              const a = new Audio(beepAudioSrc);
              a.volume = 1.0;
              a.play().catch(() => { });
            } catch { }
          };
          playOnce();
          setTimeout(playOnce, 480);
        }
      } catch (e) {
        console.warn("Beep failed:", e);
      }
    }

    function disableTorchUI() {
      torchSupported = false;
      torchEnabled = false;
      const torchContainer = document.getElementById("torch-container");
      if (torchContainer) torchContainer.classList.add("hidden");

      torchBtn.disabled = true;
      torchBtn.classList.remove("active");
      torchBtn.setAttribute("aria-pressed", "false");
      torchBtn.title = "Torch not available";
    }

    async function syncTorchSupport() {
      if (!html5QrCode || typeof html5QrCode.getRunningTrackCapabilities !== "function") {
        disableTorchUI();
        return;
      }
      try {
        const caps = await html5QrCode.getRunningTrackCapabilities();
        torchSupported = !!(caps && caps.torch);
        const torchContainer = document.getElementById("torch-container");

        if (torchSupported) {
          if (torchContainer) torchContainer.classList.remove("hidden");
          torchBtn.disabled = false;
          torchBtn.title = "Toggle flashlight";
        } else {
          disableTorchUI();
        }
      } catch (e) {
        console.warn("Torch capability check failed:", e);
        disableTorchUI();
      }
    }

    async function applyTorchState() {
      if (!torchSupported || !html5QrCode || typeof html5QrCode.applyVideoConstraints !== "function") return;
      try {
        await html5QrCode.applyVideoConstraints({ advanced: [{ torch: torchEnabled }] });
        // Use CSS classes for icon-only torch button
        torchBtn.classList.toggle("active", torchEnabled);
        torchBtn.setAttribute("aria-pressed", torchEnabled);

        // Update button text to reflect state
        torchBtn.textContent = torchEnabled ? "Turn Off Flashlight" : "Turn On Flashlight";
      } catch (e) {
        console.warn("Torch toggle failed:", e);
        disableTorchUI();
      }
    }

    function applyPlaceholderSuccessState() {
      const placeholder = document.getElementById("qr-placeholder");
      if (!placeholder) return;
      placeholder.classList.toggle("is-success", !!lastScanSuccess);
    }

    function restorePlaceholder(forceSuccess = null) {
      qrReaderElem.innerHTML = placeholderMarkup;
      qrReaderElem.style.backgroundColor = "#e5e7eb";
      if (forceSuccess !== null) lastScanSuccess = forceSuccess;
      applyPlaceholderSuccessState();
    }

    function togglePlaceholder(show) {
      const placeholder = document.getElementById("qr-placeholder");
      if (placeholder) placeholder.style.display = show ? "flex" : "none";
    }

    function addLiveScanLine() {
      removeLiveScanLine();
      const line = document.createElement("div");
      line.id = "scan-line-live";
      line.className = "scan-line scan-line-live";
      qrReaderElem.appendChild(line);
    }

    function removeLiveScanLine() {
      const line = document.getElementById("scan-line-live");
      if (line && line.parentNode) line.parentNode.removeChild(line);
    }

    function clearInlineAlert() { inlineAlert.innerHTML = ""; }

    function showInlineAlert(options) {
      inlineAlert.innerHTML = `
        <div class="inline-alert" style="color:#0f172a;">
          <div class="alert-message" style="font-weight:600;">${options.message}</div>
          <div class="alert-actions">
            <button type="button" id="alertContinue" class="btn btn-warning">
              Continue & replace
            </button>
            <button type="button" id="alertCancel" class="btn btn-outline">
              Scan another
            </button>
          </div>
        </div>`;
      document.getElementById("alertContinue").onclick = options.onContinue;
      document.getElementById("alertCancel").onclick = options.onCancel;
    }

    // Show parameter change comparison alert
    function showParameterChangeAlert(options) {
      const { currentParams, newParams, onUpdateParams, onKeepExisting, onCancel } = options;

      // Build comparison table
      let changesHtml = '<table class="param-compare-table" style="width:100%; margin: 10px 0; font-size: 0.9em;">';
      changesHtml += '<tr><th style="text-align:left;padding:4px;">Parameter</th><th style="text-align:left;padding:4px;">Current</th><th style="text-align:left;padding:4px;">New</th></tr>';

      if (currentParams.building !== newParams.building) {
        changesHtml += `<tr style="background:#fff3cd;"><td style="padding:4px;">Building</td><td style="padding:4px;">${currentParams.building || 'N/A'}</td><td style="padding:4px;"><strong>${newParams.building}</strong></td></tr>`;
      }
      if (currentParams.location !== newParams.location) {
        changesHtml += `<tr style="background:#fff3cd;"><td style="padding:4px;">Location</td><td style="padding:4px;">${currentParams.location || 'N/A'}</td><td style="padding:4px;"><strong>${newParams.location}</strong></td></tr>`;
      }
      if (currentParams.assetType !== newParams.assetType) {
        changesHtml += `<tr style="background:#fff3cd;"><td style="padding:4px;">Asset Type</td><td style="padding:4px;">${currentParams.assetType || 'N/A'}</td><td style="padding:4px;"><strong>${newParams.assetType}</strong></td></tr>`;
      }
      changesHtml += '</table>';

      inlineAlert.innerHTML = `
        <div class="inline-alert" style="background:#f8f9fa; border:1px solid #dee2e6; border-radius:8px; padding:16px; margin-top:12px; color:#0f172a;">
          <div class="alert-message" style="font-weight:700; color:#0f172a;">⚠️ Location Mismatch Detected</div>
          <div style="margin-top:8px; color:#111827; font-size:0.65em;">This QR code was previously captured with different Location:</div>
          ${changesHtml}
          <div style="margin-top:12px; color:#6c757d; font-size:0.64em;">
            <strong>Update Location:</strong> seting new location for the asset<br>
            <strong>Keep Existing:</strong> current asset location (no changes).
          </div>
          <div class="alert-actions" style="display:flex; gap:8px; margin-top:12px; flex-wrap:wrap;">
            <button type="button" id="alertUpdateParams" class="btn btn-primary" style="flex:1;">
              Update Location
            </button>
            <button type="button" id="alertKeepExisting" class="btn btn-warning" style="flex:1;">
              Keep Existing
            </button>
            <button type="button" id="alertCancelScan" class="btn btn-outline" style="flex:1;">
              Scan Another
            </button>
          </div>
        </div>`;
      document.getElementById("alertUpdateParams").onclick = onUpdateParams;
      document.getElementById("alertKeepExisting").onclick = onKeepExisting;
      document.getElementById("alertCancelScan").onclick = onCancel;
    }

    function extractNumericId(text) {
      if (!text) return "";
      const matches = String(text).match(/\d{6,}/g);
      if (!matches) return "";
      let best = matches[0];
      for (const m of matches) if (m.length >= best.length) best = m;
      return best;
    }

    async function checkExists(numericId) {
      try {
        const res = await fetch(`{{ url_for('api_check_qr') }}?qr=${encodeURIComponent(numericId)}`);
        const data = await res.json();
        return data; // Return full response including current params
      } catch (err) {
        console.warn("QR existence check failed:", err);
        return { exists: false };
      }
    }

    // Map asset type abbreviation to full name
    function abbrevToAssetType(abbrev) {
      const map = { 'ME': 'Mechanical', 'EL': 'Electrical', 'BF': 'Backflow' };
      return map[abbrev] || abbrev;
    }

    // Map asset type to abbreviation
    function assetTypeToAbbrev(type) {
      const t = (type || '').toLowerCase();
      if (t.startsWith('mech')) return 'ME';
      if (t.startsWith('elec')) return 'EL';
      if (t.startsWith('back')) return 'BF';
      return type.substring(0, 2).toUpperCase();
    }

    // Call API to update parameters
    async function updateParameters(qrCode, oldParams, newParams) {
      try {
        const res = await fetch('{{ url_for("api_update_parameters") }}', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            qr_code: qrCode,
            old_params: oldParams,
            new_params: newParams
          })
        });
        const data = await res.json();
        return data;
      } catch (err) {
        console.error("Parameter update failed:", err);
        return { success: false, error: err.message };
      }
    }

    async function handleExistence(numericId) {
      overwriteInput.value = "0";
      const data = await checkExists(numericId);

      if (!data.exists) {
        clearInlineAlert();
        qrStatus.className = "qr-status success";
        return true;
      }

      // Get current form values
      const newBuilding = document.getElementById('building_code').value;
      const newLocation = document.getElementById('location').value;
      const newAssetType = document.getElementById('asset_type').value;

      // Check if parameters differ
      const currentBuilding = data.current_building || '';
      const currentLocation = data.current_location || '';
      const currentAssetType = data.current_asset_type || '';

      const buildingChanged = !!newBuilding && currentBuilding !== newBuilding;
      const locationChanged = !!newLocation && currentLocation !== newLocation;
      const assetTypeChanged = !!newAssetType && assetTypeToAbbrev(newAssetType) !== (currentAssetType || "");

      const paramsChanged = buildingChanged || locationChanged || assetTypeChanged;

      if (paramsChanged) {
        // Show parameter change dialog
        qrStatus.className = "qr-status";
        qrStatus.textContent = "⚠️ Location differ from existing record.";

        showParameterChangeAlert({
          currentParams: {
            building: currentBuilding,
            location: currentLocation,
            assetType: abbrevToAssetType(currentAssetType)
          },
          newParams: {
            building: newBuilding,
            location: newLocation,
            assetType: newAssetType
          },
          onUpdateParams: async () => {
            // Call update API
            qrStatus.textContent = "⏳ Updating parameters...";
            qrStatus.className = "qr-status";

            const result = await updateParameters(numericId, {
              building_code: currentBuilding,
              location: currentLocation,
              asset_type: abbrevToAssetType(currentAssetType)
            }, {
              building_code: newBuilding,
              location: newLocation,
              asset_type: newAssetType
            });

            if (result.success) {
              overwriteInput.value = "1";
              qrStatus.textContent = "✅ " + result.message;
              qrStatus.className = "qr-status success";
              clearInlineAlert();
              notify(result.message, "success");
            } else {
              qrStatus.textContent = "❌ Update failed: " + result.error;
              qrStatus.className = "qr-status error";
              notify("Location update failed.", "error");
            }
          },
          onKeepExisting: () => {
            // Continue with existing params (update form to match DB)
            document.getElementById('building_code').value = currentBuilding;
            document.getElementById('location').innerHTML = `<option value="${currentLocation}" selected>${currentLocation}</option>`;
            document.getElementById('asset_type').value = abbrevToAssetType(currentAssetType);
            if (window.setAssetTypeIcon) {
              window.setAssetTypeIcon(document.getElementById('asset_type').value);
            }

            overwriteInput.value = "1";
            qrStatus.textContent = "✅ Using existing parameters. Ready to replace photos.";
            qrStatus.className = "qr-status success";
            clearInlineAlert();
            notify("Using existing parameters from the system record.", "info");
          },
          onCancel: () => {
            qrInput.value = "";
            qrStatus.textContent = "QR cleared. Please scan another code.";
            qrStatus.className = "qr-status";
            clearInlineAlert();
          }
        });
        return false;
      }

      // No parameter changes, just show standard overwrite dialog
      qrStatus.className = "qr-status";
      showInlineAlert({
        message: "Asset found in system. Continue to replace existing data?",
        onContinue: () => {
          overwriteInput.value = "1";
          qrStatus.textContent = "Overwrite enabled. You will replace existing data for this asset.";
          qrStatus.className = "qr-status success";
          clearInlineAlert();
          notify("Overwrite enabled for this asset.", "warning");
        },
        onCancel: () => {
          qrInput.value = "";
          qrStatus.textContent = "QR cleared. Please scan another code.";
          qrStatus.className = "qr-status";
          clearInlineAlert();
        }
      });
      return false;
    }

    function libraryReady() { return typeof Html5Qrcode !== "undefined"; }

    function setStopwatchStart(force = false) {
      if (!stopwatchStartInput) return;
      if (force || !stopwatchStartInput.value) {
        stopwatchStartInput.value = new Date().toISOString();
      }
    }

    async function setQrValueAndCheck(raw) {
      clearInlineAlert();
      lastScanSuccess = false;
      applyPlaceholderSuccessState();
      const id = extractNumericId(raw) || (raw || "").trim();
      if (!id) {
        qrInput.value = "";
        qrStatus.textContent = "Could not extract a numeric ID. Try again.";
        qrStatus.className = "qr-status error";
        notify("Could not extract a numeric ID.", "error");
        return false;
      }
      qrInput.value = id;
      setStopwatchStart(true);
      qrStatus.textContent = "QR captured: " + id;
      qrStatus.className = "qr-status success";
      lastScanSuccess = true;
      applyPlaceholderSuccessState();
      hapticSuccess();
      beepSuccess();
      notify("QR captured: " + id, "success", 2200);
      await handleExistence(id);
      // Record recent scan with current form values
      const buildingSelect = document.getElementById('building_code');
      const buildingCode = buildingSelect.value;
      const buildingName = buildingSelect.options[buildingSelect.selectedIndex]?.text || buildingCode;
      const locationVal = document.getElementById('location').value;
      const assetTypeVal = document.getElementById('asset_type').value;
      if (window.assetRecentScans && typeof window.assetRecentScans.add === 'function') {
        window.assetRecentScans.add({
          qr: id,
          building: buildingCode,       // Store code for form restoration
          buildingName: buildingName,   // Store name for display
          location: locationVal,
          assetType: assetTypeVal
        });
      }
      return true;
    }

    startBtn.addEventListener("click", async function () {
      // If already scanning, stop instead
      if (scanning) {
        stopScanning();
        return;
      }

      try {
        if (!libraryReady()) {
          qrStatus.textContent = "QR library failed to load.";
          qrStatus.className = "qr-status error";
          notify("QR library failed to load.", "error");
          return;
        }
        if (!html5QrCode) html5QrCode = new Html5Qrcode("qr-reader");

        lastScanSuccess = false;
        applyPlaceholderSuccessState();
        resumeAudioCtx();
        primeBeepAudio();
        ensureBeepAudio();
        togglePlaceholder(false);

        await html5QrCode.start(
          { facingMode: { exact: "environment" } },
          { fps: 10, qrbox: 200 },
          async (decodedText) => {
            const success = await setQrValueAndCheck(decodedText);
            html5QrCode.stop().then(() => {
              scanning = false;
              removeLiveScanLine();
              restorePlaceholder(success);
              torchEnabled = false;
              disableTorchUI();
            });
          },
          () => { }
        );
        addLiveScanLine();
        await syncTorchSupport();

        scanning = true;
        scannerBtnText.textContent = "Stop Scanner";
        startBtn.classList.add("scanning");
        qrStatus.textContent = "Scanning... hold the QR steadily.";
        qrStatus.className = "qr-status";
      } catch (err) {
        qrStatus.textContent = "Unable to access camera: " + err;
        qrStatus.className = "qr-status error";
        notify("Unable to access camera.", "error");
        lastScanSuccess = false;
        removeLiveScanLine();
        torchEnabled = false;
        disableTorchUI();
        restorePlaceholder(false);
        scannerBtnText.textContent = "Start Scanner";
        startBtn.classList.remove("scanning");
      }
    });

    // Helper function to stop scanning
    function stopScanning() {
      if (html5QrCode && scanning) {
        html5QrCode.stop().then(() => {
          scanning = false;
          qrStatus.textContent = "Scanner stopped.";
          qrStatus.className = "qr-status";
          clearInlineAlert();
          removeLiveScanLine();
          torchEnabled = false;
          disableTorchUI();
          restorePlaceholder();
          scannerBtnText.textContent = "Start Scanner";
          startBtn.classList.remove("scanning");
        });
      }
    }

    useManualBtn.addEventListener("click", async function () {
      const val = manual.value.trim();
      if (!val) {
        notify("Please type a QR value first.", "warning");
        return;
      }

      // Enforce 10-digit numeric validation
      if (!/^\d{10}$/.test(val)) {
        notify("Please enter exactly 10 digits.", "warning");
        return;
      }

      await setQrValueAndCheck(val);
    });

    torchBtn.addEventListener("click", async function () {
      if (!torchSupported) return;
      torchEnabled = !torchEnabled;
      await applyTorchState();
    });

    form.addEventListener("submit", async function (e) {
      const process = document.getElementById('capture_process').value;

      if (process === '2') {
        e.preventDefault();
        setStopwatchStart(true);
        // Add loading state for temp code process
        submitBtn.classList.add('btn-loading');
        submitBtn.disabled = true;

        try {
          const res = await fetch('{{ url_for("api_get_temp_code") }}', { method: 'POST' });
          const data = await res.json();
          if (data.error) {
            alert("Error: " + data.error);
            submitBtn.classList.remove('btn-loading');
            submitBtn.disabled = false;
            notify("Unable to get a temporary QR code.", "error");
            return;
          }
          qrInput.value = data.code;
          form.submit();
        } catch (err) {
          alert("Failed to get temp code: " + err);
          submitBtn.classList.remove('btn-loading');
          submitBtn.disabled = false;
          notify("Failed to get temporary QR code.", "error");
        }
        return;
      }

      // Validate QR code before adding loading state
      let v = (qrInput.value || "").trim();
      if (!/^\d{6,}$/.test(v)) {
        const id = extractNumericId(v);
        if (id) { qrInput.value = id; v = id; } else {
          e.preventDefault();
          alert("Please scan a QR code that contains a numeric ID.");
          notify("A numeric QR code is required.", "warning");
          return;
        }
      }

      if (overwriteInput.value !== "1") {
        const data = await checkExists(v);
        if (data.exists) {
          e.preventDefault();
          await handleExistence(v);
          return;
        }
      }

      setStopwatchStart(false);
    });

    // UI Logic for Temp Asset
    const locationSuggestions = document.getElementById('location_suggestions');
    const captureProcessSelect = document.getElementById('capture_process');
    function updateScannerUI() {
      const isTemp = captureProcessSelect.value === '2';
      const scannerContainer = document.getElementById('qr-reader');
      const manualRow = document.querySelector('.manual-entry-row');
      const manualDivider = document.querySelector('.divider-with-text');

      if (isTemp) {
        startBtn.classList.add('hidden');
        if (scannerContainer) scannerContainer.classList.add('hidden');
        if (manualRow) manualRow.classList.add('hidden');
        if (manualDivider) manualDivider.classList.add('hidden');
        qrStatus.textContent = "Replacing | Checking Asset (NO QR Required): Code will be assigned automatically.";
        qrStatus.className = "qr-status";

        if (html5QrCode && scanning) {
          html5QrCode.stop().then(() => {
            scanning = false; scannerContainer.innerHTML = "";
          });
        }
      } else {
        startBtn.classList.remove('hidden');
        if (scannerContainer) scannerContainer.classList.remove('hidden');
        if (manualRow) manualRow.classList.remove('hidden');
        if (manualDivider) manualDivider.classList.remove('hidden');
        if (!scanning) {
          qrStatus.textContent = "";
          qrStatus.classList.add("hidden");
        }
      }
    }

    captureProcessSelect.addEventListener('change', updateScannerUI);
    updateScannerUI();
  })();
</script>

<!-- Location filtering and persistence script -->
<script>
  (function () {
    const buildingSelect = document.getElementById('building_code');
    const locationSelect = document.getElementById('location');
    const locationSearchInput = document.getElementById('location_search');
    const locationSuggestions = document.getElementById('location_suggestions');
    const assetTypeSelect = document.getElementById('asset_type');
    const captureProcessSelect = document.getElementById('capture_process');
    const assetTypeIcon = document.getElementById('asset_type_icon');

    function assetTypeIconSvg(type) {
      const t = (type || '').toLowerCase();
      if (t.startsWith('elect')) {
        return `
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none">
            <circle cx="32" cy="32" r="26" stroke="#808080" stroke-width="6" />
            <path
              d="M47 0 L15 31 H31 L17 64 L49 33 H33 L47 0Z"
              fill="#f6ad18"
              stroke="white"
              stroke-width="6"
              stroke-linejoin="miter"
              paint-order="stroke"
            />
          </svg>
        `;
      }
      if (t.startsWith('back')) {
        return `
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none" stroke="#0f172a" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <rect x="18" y="9" width="28" height="6" rx="3" />
            <path d="M32 15v6" />
            <rect x="26" y="21" width="12" height="6" />
            <path d="M4 42h8 M52 42h8" />
            <rect x="12" y="31" width="6" height="22" rx="3" />
            <rect x="46" y="31" width="6" height="22" rx="3" />
            <circle cx="32" cy="42" r="13" />
            <circle cx="32" cy="42" r="5" />
            <circle cx="32" cy="42" r="9" stroke-width="2" stroke-dasharray="1 5" stroke-linecap="butt" />
          </svg>
        `;
      }
      return `
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 15.5A3.5 3.5 0 0 1 8.5 12 3.5 3.5 0 0 1 12 8.5a3.5 3.5 0 0 1 3.5 3.5 3.5 3.5 0 0 1-3.5 3.5m7.43-2.53c.04-.32.07-.64.07-.97 0-.33-.03-.66-.07-1l2.11-1.63c.19-.15.24-.42.12-.64l-2-3.46c-.12-.22-.39-.31-.61-.22l-2.49 1c-.52-.39-1.06-.73-1.69-.98l-.37-2.65A.506.506 0 0 0 14 2h-4c-.25 0-.46.18-.5.42l-.37 2.65c-.63.25-1.17.59-1.69.98l-2.49-1c-.22-.09-.49 0-.61.22l-2 3.46c-.13.22-.07.49.12.64L4.57 11c-.04.34-.07.67-.07 1 0 .33.03.65.07.97l-2.11 1.66c-.19.15-.25.42-.12.64l2 3.46c.12.22.39.3.61.22l2.49-1.01c.52.4 1.06.74 1.69.99l.37 2.65c.04.24.25.42.5.42h4c.25 0 .46-.18.5-.42l.37-2.65c.63-.26 1.17-.59 1.69-.99l2.49 1.01c.22.08.49 0 .61-.22l2-3.46c.12-.22.07-.49-.12-.64l-2.11-1.66z" />
        </svg>
      `;
    }

    function setAssetTypeIcon(type) {
      if (!assetTypeIcon) return;
      assetTypeIcon.innerHTML = assetTypeIconSvg(type);
    }

    window.setAssetTypeIcon = setAssetTypeIcon;

    const BUILDING_STORAGE_KEY = 'ubcAssetCapture-building';
    const LOCATION_STORAGE_KEY = 'ubcAssetCapture-location';
    const ASSET_TYPE_STORAGE_KEY = 'ubcAssetCapture-assetType';
    const CAPTURE_PROCESS_STORAGE_KEY = 'ubcAssetCapture-captureProcess';
    const RECENT_SCANS_KEY = 'ubcAssetCapture-recentScans';
    let locationOptions = [];
    let recentScans = [];

    function renderLocationOptions(filterText = "", locationToSelect = null) {
      const filter = (filterText || "").toLowerCase();
      locationSelect.innerHTML = '';

      const prompt = buildingSelect.value ? '-- Select the Building Space --' : '-- Select First the Property --';
      const promptOpt = document.createElement('option');
      promptOpt.value = '';
      promptOpt.textContent = prompt;
      locationSelect.appendChild(promptOpt);

      const filtered = locationOptions.filter(loc => loc.toLowerCase().startsWith(filter));
      filtered.forEach(loc => {
        const option = document.createElement('option');
        option.value = loc;
        option.textContent = loc;
        locationSelect.appendChild(option);
      });

      if (locationToSelect && filtered.includes(locationToSelect)) {
        locationSelect.value = locationToSelect;
      }

      // Render suggestion list for quicker pick
      if (locationSuggestions) {
        locationSuggestions.innerHTML = '';
        const suggestionSource = filter ? filtered : locationOptions;
        // Only show dropdown if user has typed at least 1 character
        if (filter && suggestionSource.length > 0) {
          suggestionSource.slice(0, 12).forEach(loc => {
            const item = document.createElement('div');
            item.textContent = loc;
            item.style.padding = '6px 10px';
            item.style.cursor = 'pointer';
            item.addEventListener('click', () => {
              if (locationSearchInput) locationSearchInput.value = loc;
              // Clear filter and show all options, then select the clicked location
              renderLocationOptions('', loc);
              locationSelect.value = loc;  // Explicitly set the select value
              // Trigger change event to save to localStorage
              locationSelect.dispatchEvent(new Event('change'));
              locationSuggestions.classList.remove('is-visible');
            });
            item.addEventListener('mouseover', () => item.style.background = '#f3f4f6');
            item.addEventListener('mouseout', () => item.style.background = '#fff');
            locationSuggestions.appendChild(item);
          });
          locationSuggestions.classList.add('is-visible');
        } else {
          locationSuggestions.classList.remove('is-visible');
        }
      }
    }

    async function updateLocations(buildingCode, locationToSelect) {
      const skeleton = document.getElementById('location_skeleton');
      locationSelect.innerHTML = '<option value="">-- Loading... --</option>';
      locationSelect.disabled = true;
      locationSelect.style.display = 'none';
      if (skeleton) skeleton.style.display = 'block';
      locationOptions = [];

      if (!buildingCode) {
        locationSelect.innerHTML = '<option value="">-- Select First the Property --</option>';
        locationSelect.disabled = false;
        locationSelect.style.display = 'block';
        if (skeleton) skeleton.style.display = 'none';
        return;
      }

      try {
        const response = await fetch(`{{ url_for('api_locations') }}?building_code=${encodeURIComponent(buildingCode)}`, {
          credentials: 'same-origin'
        });
        if (!response.ok) throw new Error('Network response was not ok');
        locationOptions = await response.json();
        if (!Array.isArray(locationOptions)) locationOptions = [];
        renderLocationOptions(locationSearchInput ? locationSearchInput.value : '', locationToSelect);
        if (locationOptions.length === 0) {
          locationSelect.innerHTML = '<option value="">-- No Space Found --</option>';
        }
      } catch (error) {
        console.error('Failed to fetch locations:', error);
        if (locationOptions.length === 0) {
          locationSelect.innerHTML = '<option value="">-- Error loading locations --</option>';
        } else {
          renderLocationOptions(locationSearchInput ? locationSearchInput.value : '', locationToSelect);
        }
      } finally {
        locationSelect.disabled = false;
        locationSelect.style.display = 'block';
        if (skeleton) skeleton.style.display = 'none';
      }
    }

    function saveRecentScans() {
      localStorage.setItem(RECENT_SCANS_KEY, JSON.stringify(recentScans));
    }

    function loadRecentScans() {
      try {
        const raw = localStorage.getItem(RECENT_SCANS_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (Array.isArray(parsed)) {
            recentScans = parsed.slice(0, 3);
          }
        }
      } catch { recentScans = []; }
    }

    function renderRecentScans() {
      const container = document.getElementById('recent_scans');
      if (!container) return;
      container.innerHTML = '';
      container.className = 'recent-scans-carousel';
      if (!recentScans.length) {
        container.innerHTML = '<div class="text-gray-500 text-sm" style="padding: 8px;">No recent scans</div>';
        container.className = '';
        return;
      }
      recentScans.forEach(item => {
        const card = document.createElement('div');
        card.className = 'recent-scan-card';
        card.innerHTML = `
          <div class="qr-code">${item.qr}</div>
          <div class="details">
            <div>${item.buildingName || item.building || 'No building'}</div>
            <div>${item.location || 'No location'}</div>
            <div>${item.assetType || ''}</div>
          </div>
        `;
        card.addEventListener('click', () => {
          const qrInputEl = document.getElementById('qr_code');
          if (qrInputEl) qrInputEl.value = item.qr;
          buildingSelect.value = item.building || '';
          if (locationSearchInput) locationSearchInput.value = item.location || '';
          // First update locations from API, then set the value
          if (typeof window.updateLocations === 'function') {
            window.updateLocations(item.building || '', item.location || '');
          } else {
            renderLocationOptions('', item.location || null);
            locationSelect.value = item.location || '';
          }
          assetTypeSelect.value = item.assetType || assetTypeSelect.value;
          setAssetTypeIcon(assetTypeSelect.value);
        });
        container.appendChild(card);
      });
    }

    function addRecentScan(entry) {
      if (!entry || !entry.qr) return;
      recentScans = recentScans.filter(r => r.qr !== entry.qr);
      recentScans.unshift(entry);
      recentScans = recentScans.slice(0, 3);
      saveRecentScans();
      renderRecentScans();
    }

    buildingSelect.addEventListener('change', function () {
      const buildingCode = this.value;
      localStorage.setItem(BUILDING_STORAGE_KEY, buildingCode);
      localStorage.removeItem(LOCATION_STORAGE_KEY);
      if (locationSearchInput) locationSearchInput.value = '';
      updateLocations(buildingCode, null);
    });

    locationSelect.addEventListener('change', function () {
      if (this.value) {
        localStorage.setItem(LOCATION_STORAGE_KEY, this.value);
      } else {
        localStorage.removeItem(LOCATION_STORAGE_KEY);
      }
    });

    if (locationSearchInput) {
      locationSearchInput.addEventListener('input', function () {
        renderLocationOptions(this.value, locationSelect.value);
      });
      locationSearchInput.addEventListener('focus', function () {
        renderLocationOptions(this.value, locationSelect.value);
      });
      locationSearchInput.addEventListener('blur', function () {
        setTimeout(() => {
          if (locationSuggestions) locationSuggestions.classList.remove('is-visible');
        }, 150);
      });
    }

    assetTypeSelect.addEventListener('change', function () {
      localStorage.setItem(ASSET_TYPE_STORAGE_KEY, this.value);
      setAssetTypeIcon(this.value);
    });

    captureProcessSelect.addEventListener('change', function () {
      if (this.value) {
        localStorage.setItem(CAPTURE_PROCESS_STORAGE_KEY, this.value);
      }
    });

    document.addEventListener('DOMContentLoaded', () => {
      const savedAssetType = localStorage.getItem(ASSET_TYPE_STORAGE_KEY);
      if (savedAssetType) {
        assetTypeSelect.value = savedAssetType;
      }
      setAssetTypeIcon(assetTypeSelect.value);

      const savedProcess = localStorage.getItem(CAPTURE_PROCESS_STORAGE_KEY);
      if (savedProcess && (savedProcess === '0' || savedProcess === '1')) {
        captureProcessSelect.value = savedProcess;
      }

      let buildingToLoad = buildingSelect.value;
      const savedBuildingCode = localStorage.getItem(BUILDING_STORAGE_KEY);

      if (!buildingToLoad && savedBuildingCode) {
        const optionExists = Array.from(buildingSelect.options).some(opt => opt.value === savedBuildingCode);
        if (optionExists) {
          buildingSelect.value = savedBuildingCode;
          buildingToLoad = savedBuildingCode;
        }
      }

      if (buildingToLoad) {
        const savedLocation = localStorage.getItem(LOCATION_STORAGE_KEY);
        updateLocations(buildingToLoad, savedLocation);
      }

      loadRecentScans();
      renderRecentScans();
      window.assetRecentScans = { add: addRecentScan };
      window.updateLocations = updateLocations;
    });
  })();
</script>
{% endblock %}
